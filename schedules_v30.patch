+    BlockStatus.CheckKind.NOTIFICATIONS -> R.string.status_check_notifications
+}
+
+private fun checkDesc(kind: BlockStatus.CheckKind): Int = when (kind) {
+    BlockStatus.CheckKind.DEVICE_OWNER -> R.string.status_check_owner_desc
+    BlockStatus.CheckKind.ACCESSIBILITY -> R.string.status_check_accessibility_desc
+    BlockStatus.CheckKind.EXACT_ALARMS -> R.string.status_check_alarms_desc
+    BlockStatus.CheckKind.BATTERY -> R.string.status_check_battery_desc
+    BlockStatus.CheckKind.DNS_FILTER -> R.string.status_check_dns_desc
+    BlockStatus.CheckKind.NOTIFICATIONS -> R.string.status_check_notifications_desc
+}
+
+/** Opens the exact Settings page that fixes [kind], falling back to the app's info page. */
+private fun fix(context: Context, kind: BlockStatus.CheckKind, navViewModel: NavigationViewModel) {
+    val pkg = context.packageName
+    val intent = when (kind) {
+        BlockStatus.CheckKind.DEVICE_OWNER -> {
+            navViewModel.navigateTo("setup_device_owner")
+            return
+        }
+        // The DNS picker is a dialog on the Config screen, so take them there.
+        BlockStatus.CheckKind.DNS_FILTER -> {
+            navViewModel.navigateTo("config")
+            return
+        }
+        BlockStatus.CheckKind.ACCESSIBILITY -> Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS)
+        BlockStatus.CheckKind.EXACT_ALARMS ->
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S)
+                Intent(Settings.ACTION_REQUEST_SCHEDULE_EXACT_ALARM, Uri.parse("package:$pkg"))
+            else appDetails(pkg)
+        BlockStatus.CheckKind.BATTERY -> Intent(Settings.ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS)
+        BlockStatus.CheckKind.NOTIFICATIONS ->
+            Intent(Settings.ACTION_APP_NOTIFICATION_SETTINGS).putExtra(Settings.EXTRA_APP_PACKAGE, pkg)
+    }
+    try {
+        context.startActivity(intent)
+    } catch (_: ActivityNotFoundException) {
+        // Some manufacturers remove individual Settings pages; the app info page always exists.
+        try {
+            context.startActivity(appDetails(pkg))
+        } catch (_: ActivityNotFoundException) {
+        }
+    }
+}
+
+private fun appDetails(pkg: String) =
+    Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS, Uri.parse("package:$pkg"))
+
+/** "18:00" today, "Tue 18:00" on any other day — so a time is never ambiguous about which day. */
+private fun whenText(context: Context, millis: Long): String {
+    val flags = if (DateUtils.isToday(millis)) DateUtils.FORMAT_SHOW_TIME
+    else DateUtils.FORMAT_SHOW_TIME or DateUtils.FORMAT_SHOW_WEEKDAY or DateUtils.FORMAT_ABBREV_WEEKDAY
+    return DateUtils.formatDateTime(context, millis, flags)
+}
+
+private fun reasonText(context: Context, reason: BlockStatus.Reason): String = when (reason) {
+    is BlockStatus.Reason.Schedule ->
+        context.getString(R.string.status_reason_schedule, reason.name, whenText(context, reason.untilMillis))
+    is BlockStatus.Reason.OutsideWindow -> reason.opensAtMillis
+        ?.let { context.getString(R.string.status_reason_window, whenText(context, it)) }
+        ?: context.getString(R.string.status_reason_window_unknown)
+    is BlockStatus.Reason.Cooldown ->
+        context.getString(R.string.status_reason_cooldown, whenText(context, reason.untilMillis))
+    is BlockStatus.Reason.ExplicitContent ->
+        context.getString(R.string.status_reason_explicit, whenText(context, reason.untilMillis))
+    BlockStatus.Reason.DailyLimit -> context.getString(R.string.status_reason_daily)
+    BlockStatus.Reason.Impulse -> context.getString(R.string.status_reason_impulse)
+    BlockStatus.Reason.Manual -> context.getString(R.string.status_reason_manual)
+    BlockStatus.Reason.Hidden -> context.getString(R.string.status_reason_hidden)
+}
