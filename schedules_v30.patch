--- orig/app/src/main/java/io/github/warleysr/dechainer/data/BlockStatus.kt	1970-01-01 00:00:00.000000000 +0000
+++ main/app/src/main/java/io/github/warleysr/dechainer/data/BlockStatus.kt	2026-09-23 12:14:57.008037026 +0000
@@ -0,0 +1,166 @@
+package io.github.warleysr.dechainer.data
+
+import android.Manifest
+import android.app.AlarmManager
+import android.content.Context
+import android.content.pm.PackageManager
+import android.graphics.drawable.Drawable
+import android.os.Build
+import android.os.PowerManager
+import androidx.core.content.ContextCompat
+import io.github.warleysr.dechainer.DechainerAccessibilityService
+import io.github.warleysr.dechainer.security.SecurityManager
+import timber.log.Timber
+
+/**
+ * Answers two questions the rest of the app can't: *why is this app blocked*, and *is blocking
+ * actually working on this phone*.
+ *
+ * Six different features can suspend an app — schedules, time windows, daily limits, reopening
+ * cooldowns, impulse lock and visual blocking — and each keeps its own record. Nothing ever put
+ * those records side by side, so a greyed-out app gave no clue which feature was holding it or
+ * when it would come back. This reads every record and says so.
+ *
+ * Read-only by design. Nothing here can change a block, so the screen showing it can never
+ * become a way around one.
+ */
+object BlockStatus {
+
+    /** One reason an app is blocked. An app can have several at once. */
+    sealed interface Reason {
+        class Schedule(val name: String, val untilMillis: Long) : Reason
+        class OutsideWindow(val opensAtMillis: Long?) : Reason
+        object DailyLimit : Reason
+        class Cooldown(val untilMillis: Long) : Reason
+        object Impulse : Reason
+        class ExplicitContent(val untilMillis: Long) : Reason
+        /** Suspended, but by no feature — the person did it from the Apps tab. */
+        object Manual : Reason
+        object Hidden : Reason
+    }
+
+    class BlockedApp(
+        val packageName: String,
+        val name: String,
+        val icon: Drawable,
+        val reasons: List<Reason>
+    )
+
+    enum class CheckKind { DEVICE_OWNER, ACCESSIBILITY, EXACT_ALARMS, BATTERY, DNS_FILTER, NOTIFICATIONS }
+
+    class Check(val kind: CheckKind, val ok: Boolean)
+
+    /**
+     * Assembles the reasons for one app from the facts each feature records. Pure, so it is
+     * unit-tested directly.
+     *
+     * "Suspended by you" is reported only when no feature claims the suspension. Otherwise a
+     * schedule-held app would also claim to be manual, and the one fact the person needs — what
+     * is holding it and until when — would be buried.
+     */
+    internal fun reasonsFor(
+        isSuspended: Boolean,
+        isHidden: Boolean,
+        scheduleName: String?,
+        scheduleUntil: Long?,
+        windowClosed: Boolean,
+        windowOpensAt: Long?,
+        dailyLimit: Boolean,
+        cooldownUntil: Long?,
+        impulse: Boolean,
+        explicitUntil: Long?
+    ): List<Reason> {
+        val reasons = mutableListOf<Reason>()
+        if (scheduleName != null && scheduleUntil != null) reasons += Reason.Schedule(scheduleName, scheduleUntil)
+        if (windowClosed) reasons += Reason.OutsideWindow(windowOpensAt)
+        if (dailyLimit) reasons += Reason.DailyLimit
+        if (cooldownUntil != null) reasons += Reason.Cooldown(cooldownUntil)
+        if (impulse) reasons += Reason.Impulse
+        if (explicitUntil != null) reasons += Reason.ExplicitContent(explicitUntil)
+        // "By you" only when no feature claims the app — with hiding on, a schedule hides apps too.
+        if (reasons.isEmpty()) {
+            if (isHidden) reasons += Reason.Hidden
+            else if (isSuspended) reasons += Reason.Manual
+        }
+        return reasons
+    }
+
+    /** Every suspended or hidden app, with every reason it's blocked. Call off the main thread. */
+    fun blockedApps(context: Context): List<BlockedApp> {
+        val ctx = context.applicationContext
+        return try {
+            val now = System.currentTimeMillis()
+            val timeLimits = TimeLimitSuspensionTracker(ctx)
+            val daily = timeLimits.dailyLimitSuspensions().keys
+            val cooldowns = timeLimits.reopeningSuspensions().filterValues { it > now }
+            val impulse = SecurityManager.getActiveImpulseSuspension(ctx)
+            val explicit = VisualBlockingSuspensionTracker(ctx).activeSuspensions().filterValues { it > now }
+            val closedWindows = WindowEnforcer.closedWindows(ctx)
+
+            AppRepository.getApps(forceRefresh = true)
+                .filter { it.isSuspended || it.isHidden }
+                .map { app ->
+                    val pkg = app.packageName
+                    val schedule = ScheduleEnforcer.activeBlockFor(ctx, pkg)
+                    BlockedApp(
+                        packageName = pkg,
+                        name = app.name,
+                        icon = app.icon,
+                        reasons = reasonsFor(
+                            isSuspended = app.isSuspended,
+                            isHidden = app.isHidden,
+                            scheduleName = schedule?.scheduleName,
+                            scheduleUntil = schedule?.endsAtMillis,
+                            windowClosed = pkg in closedWindows,
+                            windowOpensAt = closedWindows[pkg],
+                            dailyLimit = pkg in daily,
+                            cooldownUntil = cooldowns[pkg],
+                            impulse = pkg in impulse,
+                            explicitUntil = explicit[pkg]
+                        )
+                    )
+                }
+                .sortedBy { it.name.lowercase() }
+        } catch (e: Exception) {
+            Timber.e(e, "Could not collect block status")
+            emptyList()
+        }
+    }
+
+    /**
+     * The conditions blocking depends on. Each one failing breaks something specific:
+     * no Device Owner and nothing can be suspended at all; no exact alarms and windows open and
+     * close late; battery optimisation and the whole app can be put to sleep between boundaries.
+     */
+    fun healthChecks(context: Context): List<Check> {
+        val ctx = context.applicationContext
+        val exactAlarms = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            (ctx.getSystemService(Context.ALARM_SERVICE) as AlarmManager).canScheduleExactAlarms()
+        } else true
+        val battery = (ctx.getSystemService(Context.POWER_SERVICE) as PowerManager)
+            .isIgnoringBatteryOptimizations(ctx.packageName)
+        val notifications = Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU ||
+            ContextCompat.checkSelfPermission(ctx, Manifest.permission.POST_NOTIFICATIONS) ==
+            PackageManager.PERMISSION_GRANTED
+
+        return listOf(
+            Check(CheckKind.DEVICE_OWNER, safe { DeviceOwnerRepository.isDeviceOwner() }),
+            // The service's own flag, set when it actually connects and cleared when it dies.
+            // Not DeviceOwnerRepository.isAccessibilityGranted(): that shells out through Shizuku,
+            // which only runs during setup, so after a reboot it reports "off" for a service that
+            // is plainly running.
+            Check(CheckKind.ACCESSIBILITY, DechainerAccessibilityService.isRunning),
+            Check(CheckKind.EXACT_ALARMS, exactAlarms),
+            Check(CheckKind.BATTERY, battery),
+            Check(CheckKind.DNS_FILTER, safe { DnsGuard.isActive(ctx) }),
+            Check(CheckKind.NOTIFICATIONS, notifications)
+        )
+    }
+
+    private inline fun safe(block: () -> Boolean): Boolean = try {
+        block()
+    } catch (e: Exception) {
+        Timber.w(e, "Health check failed")
+        false
+    }
+}
diff -ruN -x '*.tflite' -x .github -x .idea -x '*.patch' -x README.md -x RELEASE-NOTES.md orig/app/src/main/java/io/github/warleysr/dechainer/data/Blocker.kt main/app/src/main/java/io/github/warleysr/dechainer/data/Blocker.kt
--- orig/app/src/main/java/io/github/warleysr/dechainer/data/Blocker.kt	1970-01-01 00:00:00.000000000 +0000
+++ main/app/src/main/java/io/github/warleysr/dechainer/data/Blocker.kt	2026-09-23 12:14:57.008054065 +0000
@@ -0,0 +1,200 @@
+package io.github.warleysr.dechainer.data
+
+import android.app.admin.DevicePolicyManager
+import android.content.ComponentName
+import android.content.Context
+import android.content.pm.PackageManager
+import androidx.core.content.edit
+import timber.log.Timber
+
+/**
+ * How Déchaîner's own blocks — schedules, time windows, daily and group limits, reopening
+ * cooldowns — take an app away: hidden (default) or suspended.
+ *
+ * Hidden: the app disappears from every launcher until the block ends, so there is no icon to tap
+ * and no "Blocked by work policy" dialog. Suspended: the icon stays, greyed out.
+ *
+ * Hiding has two traps suspension doesn't, and this class exists to close them:
+ * - A hidden app looks uninstalled, so a plain package lookup misses it. Use [isInstalled].
+ * - Android does NOT un-hide apps when a Device Owner is removed. So every app hidden here is
+ *   recorded, and [releaseAllHidden] runs before Device Owner is ever given up.
+ * It only ever un-hides apps it hid itself — never one hidden by hand in the Apps tab.
+ */
+object Blocker {
+    private const val PREFS = "blocker"
+    private const val KEY_HIDE_MODE = "hide_blocked_apps"
+    private const val KEY_HIDDEN_BY_US = "hidden_by_blocker"
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    // Guards the hidden-by-us record. The schedule and window engines update it from a background
+    // thread while the service releases blocks on the main thread; two read-modify-writes racing
+    // could drop a package from the record, and an app missing from it is never un-hidden.
+    private val recordLock = Any()
+
+    fun isHideMode(context: Context): Boolean = prefs(context).getBoolean(KEY_HIDE_MODE, true)
+
+    private const val KEY_SELF_HIDE_BLOCKS = "self_hide_during_blocks"
+
+    /**
+     * Whether Déchaîner hides its own icon while a schedule window or an impulse lock is on.
+     * On by default. The icon comes back by itself the moment the block ends.
+     */
+    fun isSelfHideDuringBlocks(context: Context): Boolean =
+        prefs(context).getBoolean(KEY_SELF_HIDE_BLOCKS, true)
+
+    fun setSelfHideDuringBlocks(context: Context, on: Boolean) =
+        prefs(context).edit(commit = true) { putBoolean(KEY_SELF_HIDE_BLOCKS, on) }
+
+    /**
+     * The launcher entry (an activity-alias in the manifest). Self-hide switches only this off.
+     *
+     * Never setApplicationHidden on our own package: Android refuses to hide an active device
+     * admin, and if it ever did, a hidden package is treated as uninstalled — the accessibility
+     * service, the boundary alarms and the dial-code receiver would all stop, i.e. every block off.
+     * The alias's class name is namespace-based, so it's spelled out rather than built from
+     * packageName (which is the applicationId and may differ in a fork).
+     */
+    private fun launcherAlias(ctx: Context) =
+        ComponentName(ctx.packageName, "io.github.warleysr.dechainer.LauncherAlias")
+
+    /**
+     * Shows or hides Déchaîner's own launcher icon. Called by [ScheduleEnforcer] on every sync,
+     * so it only talks to PackageManager when the state actually has to change. The app keeps
+     * running either way; the dial code *#*#342246#*#* opens it while the icon is off.
+     */
+    fun syncSelfIcon(context: Context, hide: Boolean) {
+        val ctx = context.applicationContext
+        try {
+            val pm = ctx.packageManager
+            val alias = launcherAlias(ctx)
+            val isOff = pm.getComponentEnabledSetting(alias) == PackageManager.COMPONENT_ENABLED_STATE_DISABLED
+            if (isOff == hide) return
+            val state = if (hide) PackageManager.COMPONENT_ENABLED_STATE_DISABLED
+            else PackageManager.COMPONENT_ENABLED_STATE_DEFAULT
+            pm.setComponentEnabledSetting(alias, state, PackageManager.DONT_KILL_APP)
+        } catch (e: Exception) {
+            Timber.w(e, "Could not change Déchaîner's own icon")
+        }
+    }
+
+    /**
+     * Startup repair for builds that tried to hide the whole package. The icon itself is decided
+     * by [ScheduleEnforcer] on every sync.
+     */
+    fun ensureSelfVisible(context: Context) {
+        val ctx = context.applicationContext
+        try {
+            val dpm = ctx.getSystemService(Context.DEVICE_POLICY_SERVICE) as DevicePolicyManager
+            val admin = ComponentName(ctx, io.github.warleysr.dechainer.DechainerDeviceAdminReceiver::class.java)
+            if (dpm.isAdminActive(admin) && dpm.isApplicationHidden(admin, ctx.packageName)) {
+                dpm.setApplicationHidden(admin, ctx.packageName, false)
+            }
+        } catch (e: Exception) {
+            Timber.w(e, "Could not ensure self visible")
+        }
+    }
+
+    fun setHideMode(context: Context, hide: Boolean) =
+        prefs(context).edit(commit = true) { putBoolean(KEY_HIDE_MODE, hide) }
+
+    fun hiddenByUs(context: Context): Set<String> =
+        prefs(context).getStringSet(KEY_HIDDEN_BY_US, emptySet())?.toSet() ?: emptySet()
+
+    private fun saveHiddenByUs(context: Context, pkgs: Set<String>) =
+        prefs(context).edit(commit = true) { putStringSet(KEY_HIDDEN_BY_US, pkgs) }
+
+    /** Whether the app exists at all — including while hidden, which a plain lookup misses. */
+    fun isInstalled(context: Context, pkg: String): Boolean = try {
+        context.packageManager.getPackageInfo(pkg, PackageManager.MATCH_UNINSTALLED_PACKAGES)
+        true
+    } catch (_: PackageManager.NameNotFoundException) {
+        false
+    }
+
+    fun isHidden(dpm: DevicePolicyManager, admin: ComponentName, pkg: String): Boolean =
+        try { dpm.isApplicationHidden(admin, pkg) } catch (_: Exception) { false }
+
+    /** Hides one app regardless of the mode setting, and records it as ours. True if it worked. */
+    fun hide(context: Context, dpm: DevicePolicyManager, admin: ComponentName, pkg: String): Boolean = synchronized(recordLock) {
+        val ok = try { dpm.setApplicationHidden(admin, pkg, true) } catch (_: Exception) { false }
+        if (ok) saveHiddenByUs(context, hiddenByUs(context) + pkg)
+        ok
+    }
+
+    /** Un-hides one app, only if it's one we hid. Leaves any suspension alone. */
+    fun unhide(context: Context, dpm: DevicePolicyManager, admin: ComponentName, pkg: String) {
+        synchronized(recordLock) {
+            val ours = hiddenByUs(context)
+            if (pkg !in ours) return
+            try { dpm.setApplicationHidden(admin, pkg, false) } catch (e: Exception) {
+                Timber.w(e, "Could not un-hide %s", pkg); return
+            }
+            saveHiddenByUs(context, ours - pkg)
+        }
+    }
+
+    /** Blocked either way — hidden or suspended. */
+    fun isBlocked(dpm: DevicePolicyManager, admin: ComponentName, pkg: String): Boolean {
+        val hidden = try { dpm.isApplicationHidden(admin, pkg) } catch (_: Exception) { false }
+        if (hidden) return true
+        return try { dpm.isPackageSuspended(admin, pkg) } catch (_: Exception) { false }
+    }
+
+    /** Blocks [pkgs] the chosen way. Returns the ones Android refused outright. */
+    fun block(context: Context, dpm: DevicePolicyManager, admin: ComponentName, pkgs: Collection<String>): Set<String> {
+        if (pkgs.isEmpty()) return emptySet()
+        if (!isHideMode(context)) return dpm.setPackagesSuspended(admin, pkgs.toTypedArray(), true).toSet()
+
+        val hidden = mutableSetOf<String>()
+        val refused = mutableSetOf<String>()
+        synchronized(recordLock) {
+            for (pkg in pkgs) {
+                // Already hidden: blocked as wanted. Android reports "no change" as false, which
+                // used to be read as a refusal and suspended the app on top, every screen-on.
+                // Not recorded here if it isn't ours — a hand-hidden app must stay the person's.
+                if (isHidden(dpm, admin, pkg)) continue
+                val ok = try { dpm.setApplicationHidden(admin, pkg, true) } catch (_: Exception) { false }
+                if (ok) hidden += pkg else refused += pkg
+            }
+            if (hidden.isNotEmpty()) saveHiddenByUs(context, hiddenByUs(context) + hidden)
+        }
+        // Some apps can't be hidden. Suspend those instead, so they're still blocked.
+        if (refused.isEmpty()) return emptySet()
+        Timber.w("Could not hide %s; suspending instead", refused)
+        return dpm.setPackagesSuspended(admin, refused.toTypedArray(), true).toSet()
+    }
+
+    /** Releases [pkgs] however they were blocked. Un-hides only apps this class hid. */
+    fun release(context: Context, dpm: DevicePolicyManager, admin: ComponentName, pkgs: Collection<String>) {
+        if (pkgs.isEmpty()) return
+        synchronized(recordLock) {
+            val ours = hiddenByUs(context)
+            val unhidden = pkgs.filter { it in ours }.filter { pkg ->
+                try { dpm.setApplicationHidden(admin, pkg, false); true } catch (e: Exception) {
+                    Timber.w(e, "Could not un-hide %s", pkg); false
+                }
+            }.toSet()
+            if (unhidden.isNotEmpty()) saveHiddenByUs(context, ours - unhidden)
+        }
+        try { dpm.setPackagesSuspended(admin, pkgs.toTypedArray(), false) } catch (_: Exception) {}
+    }
+
+    /** The person hid this by hand: it's theirs now, so a block ending must not bring it back. */
+    fun forget(context: Context, pkg: String) {
+        synchronized(recordLock) {
+            val ours = hiddenByUs(context)
+            if (pkg in ours) saveHiddenByUs(context, ours - pkg)
+        }
+    }
+
+    /** Un-hides everything hidden here. Must run before Device Owner is removed. */
+    fun releaseAllHidden(context: Context, dpm: DevicePolicyManager, admin: ComponentName): Unit = synchronized(recordLock) {
+        val ours = hiddenByUs(context)
+        val left = ours.filterNot { pkg ->
+            try { dpm.setApplicationHidden(admin, pkg, false); true } catch (_: Exception) { false }
+        }.toSet()
+        saveHiddenByUs(context, left)
+    }
+}
