+package io.github.warleysr.dechainer
+
+import io.github.warleysr.dechainer.data.WordMatcher
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** Pins when a forbidden word counts: typed text anywhere and at once, screen text as whole words. */
+class WordMatcherTest {
+    private val words = WordMatcher.prepareTyped(listOf("xxx", " Porn ", "exam leak"))
+
+    /** Replays typing one character at a time, as the service sees it; returns when it fired. */
+    private fun firesAt(typed: String): String? {
+        for (i in 1..typed.length) {
+            val soFar = typed.substring(0, i)
+            if (WordMatcher.firstTypedMatch(soFar, words) != null) return soFar
+        }
+        return null
+    }
+
+    @Test
+    fun firesOnTheKeystrokeThatCompletesTheWord() {
+        // No space, no Enter: the instant the last letter lands.
+        assertEquals("exam xxx", firesAt("exam xxx videos"))
+        assertEquals("porn", firesAt("porn"))
+    }
+
+    @Test
+    fun firesWhenGluedToOtherWords() {
+        assertEquals("examxxx", firesAt("examxxxvideos"))
+        assertEquals("watchporn", firesAt("watchpornhub"))
+    }
+
+    @Test
+    fun ignoresCaseAndStraySpacesInTheList() {
+        assertEquals("porn", WordMatcher.firstTypedMatch("PoRnHub", words))
+    }
+
+    @Test
+    fun phrasesWork() {
+        assertEquals("exam leak", WordMatcher.firstTypedMatch("free exam leak 2026", words))
+        assertNull(WordMatcher.firstTypedMatch("exam results", words))
+    }
+
+    @Test
+    fun nonLatinScripts() {
+        val urdu = WordMatcher.prepareTyped(listOf("سلام"))
+        assertEquals("سلام", WordMatcher.firstTypedMatch("کہوسلامبھائی", urdu))
+    }
+
+    @Test
+    fun emptyInputsNeverFire() {
+        assertNull(WordMatcher.firstTypedMatch("", words))
+        assertNull(WordMatcher.firstTypedMatch("anything", emptyList()))
+        assertTrue(WordMatcher.prepareTyped(listOf(" ", "")).isEmpty())
+    }
+
+    // ---- Screen text stays whole-word ----
+
+    @Test
+    fun screenTextMatchesWholeWordsOnly() {
+        assertTrue(WordMatcher.pattern("sex").containsMatchIn("no sex here"))
+        assertFalse(WordMatcher.pattern("sex").containsMatchIn("Sussex county"))
+    }
+
+    @Test
+    fun combiningMarksStayInsideTheWordOnScreen() {
+        assertFalse(WordMatcher.pattern("नमस").containsMatchIn("नमस्ते"))
+        assertTrue(WordMatcher.pattern("नमस्ते").containsMatchIn("नमस्ते दोस्त"))
+    }
+
+    // ---- Smart adult-search detection ----
+
+    private fun adult(text: String) = WordMatcher.adultIntent(text)
+
+    @Test
+    fun ambiguousWordsOnlyCountNextToAPersonOrBody() {
+        assertEquals("hot girls", adult("hot girls"))
+        assertEquals("hot girls", adult("hot college girls"))
+        assertEquals("desi bhabhi", adult("desi bhabhi"))
+        assertNull(adult("hot weather today"))
+        assertNull(adult("hot chocolate recipe"))
+        assertNull(adult("desi food near me"))
+        assertNull(adult("hot chocolate for boys"))   // "boys" is three words away
+    }
+
+    @Test
+    fun strongWordsCountEitherSideAndWithPictures() {
+        assertEquals("girls bikini", adult("girls in bikini"))
+        assertEquals("naked pics", adult("naked pics"))
+        assertNull(adult("bikini shopping"))
+        assertNull(adult("naked eye astronomy"))
+    }
+
+    @Test
+    fun explicitTermsAlwaysCountEvenGlued() {
+        assertEquals("porn", adult("freepornvideos"))
+        assertEquals("xxx", adult("examxxx"))
+        assertEquals("sex", adult("sex video"))
+        assertNull(adult("Sussex university"))
+        assertNull(adult("Milford sound"))
+    }
+
+    @Test
+    fun gluedCombinationsCount() {
+        assertEquals("hotgirl", adult("hotgirls"))
+        assertNull(adult("hotmail login"))
+        assertNull(adult("photography tips"))
+    }
+
+    @Test
+    fun partialTypingDoesNotFireEarly() {
+        assertNull(adult("hot"))
+        assertNull(adult("hot gir"))
+        assertEquals("hot girl", adult("hot girl"))
+    }
+}
