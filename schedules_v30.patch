@@ -0,0 +1,67 @@
+package io.github.warleysr.dechainer.data
+
+import android.content.Context
+import androidx.core.content.edit
+import io.github.warleysr.dechainer.models.BlockSchedule
+import org.json.JSONArray
+import java.time.LocalDateTime
+
+/**
+ * Stores the user's [BlockSchedule]s in `schedule_prefs`. Only persistence lives here — applying
+ * a schedule to the device is [ScheduleEnforcer]'s job, which must be re-run after every change.
+ */
+object ScheduleRepository {
+    const val PREFS_NAME = "schedule_prefs"
+    private const val KEY_SCHEDULES = "schedules_json"
+    private const val KEY_ANTI_TAMPER = "anti_tamper_enabled"
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    fun getSchedules(context: Context): List<BlockSchedule> {
+        val json = prefs(context).getString(KEY_SCHEDULES, null) ?: return emptyList()
+        return try {
+            val array = JSONArray(json)
+            (0 until array.length()).map { BlockSchedule.fromJson(array.getJSONObject(it)) }
+        } catch (e: Exception) {
+            e.printStackTrace()
+            emptyList()
+        }
+    }
+
+    fun getSchedule(context: Context, id: String): BlockSchedule? =
+        getSchedules(context).firstOrNull { it.id == id }
+
+    private fun saveAll(context: Context, schedules: List<BlockSchedule>) {
+        val array = JSONArray()
+        schedules.forEach { array.put(it.toJson()) }
+        // commit() rather than apply(): the enforcer reads this right after, possibly from another thread.
+        prefs(context).edit(commit = true) { putString(KEY_SCHEDULES, array.toString()) }
+    }
+
+    fun upsert(context: Context, schedule: BlockSchedule) {
+        val list = getSchedules(context).toMutableList()
+        val index = list.indexOfFirst { it.id == schedule.id }
+        if (index >= 0) list[index] = schedule else list.add(schedule)
+        saveAll(context, list)
+    }
+
+    fun delete(context: Context, id: String) {
+        saveAll(context, getSchedules(context).filterNot { it.id == id })
+    }
+
+    /** True while [schedule]'s window is open and it was set to lock itself during that time. */
+    fun isLockedNow(schedule: BlockSchedule, now: LocalDateTime = LocalDateTime.now()): Boolean =
+        schedule.lockWhileActive && schedule.isActiveAt(now)
+
+    /**
+     * Anti-tamper forces automatic date/time and blocks changing it while any schedule is enabled,
+     * so a window can't be skipped by moving the clock. On by default.
+     */
+    fun isAntiTamperEnabled(context: Context): Boolean =
+        prefs(context).getBoolean(KEY_ANTI_TAMPER, true)
+
+    fun setAntiTamperEnabled(context: Context, enabled: Boolean) {
+        prefs(context).edit(commit = true) { putBoolean(KEY_ANTI_TAMPER, enabled) }
+    }
+}
diff -ruN -x '*.tflite' -x .github -x .idea -x '*.patch' -x README.md -x RELEASE-NOTES.md orig/app/src/main/java/io/github/warleysr/dechainer/data/TimeLimitSuspensionTracker.kt main/app/src/main/java/io/github/warleysr/dechainer/data/TimeLimitSuspensionTracker.kt
--- orig/app/src/main/java/io/github/warleysr/dechainer/data/TimeLimitSuspensionTracker.kt	1970-01-01 00:00:00.000000000 +0000
+++ main/app/src/main/java/io/github/warleysr/dechainer/data/TimeLimitSuspensionTracker.kt	2026-09-23 12:14:57.008131835 +0000
@@ -0,0 +1,70 @@
+package io.github.warleysr.dechainer.data
+
+import android.content.Context
+import android.content.SharedPreferences
+import androidx.core.content.edit
+
+/**
+ * Bookkeeping for the two suspension-based enforcements of the time-limit feature, mirroring
+ * [VisualBlockingSuspensionTracker]'s reasoning: the accessibility service can be killed and
+ * recreated at any moment, and for this feature that isn't just a cosmetic gap — a block that only
+ * lives in the service's memory can be escaped simply by restarting the service. Persisting it
+ * closes that off, the same way suspending the package (instead of only showing a screen over it)
+ * closes off a floating/mini-window from remaining usable underneath.
+ *
+ * - **Daily limit** ([addDailyLimitSuspension]/[dailyLimitSuspensions]): released at the next
+ *   calendar-day rollover, not a fixed instant — [DechainerAccessibilityService] lifts these from
+ *   [checkDateReset], in step with the usage counters resetting.
+ * - **Reopening cooldown** ([startReopeningSuspension]/[reopeningSuspensions]): released at a
+ *   specific wall-clock deadline, restored the same way [VisualBlockingSuspensionTracker] restores
+ *   its own suspensions on reconnect.
+ */
+class TimeLimitSuspensionTracker(context: Context) {
+
+    private val prefs: SharedPreferences =
+        context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    fun addDailyLimitSuspension(pkg: String, today: String) {
+        prefs.edit { putString(KEY_DAILY_PREFIX + pkg, today) }
+    }
+
+    fun endDailyLimitSuspension(pkg: String) = prefs.edit { remove(KEY_DAILY_PREFIX + pkg) }
+
+    fun isDailyLimitSuspended(pkg: String): Boolean = prefs.contains(KEY_DAILY_PREFIX + pkg)
+
+    /** Every package suspended for a day's limit, mapped to the calendar day it was suspended on. */
+    fun dailyLimitSuspensions(): Map<String, String> {
+        val result = mutableMapOf<String, String>()
+        prefs.all.forEach { (key, value) ->
+            if (!key.startsWith(KEY_DAILY_PREFIX)) return@forEach
+            val day = value as? String ?: return@forEach
+            result[key.removePrefix(KEY_DAILY_PREFIX)] = day
+        }
+        return result
+    }
+
+    fun startReopeningSuspension(pkg: String, until: Long) {
+        prefs.edit { putLong(KEY_REOPEN_PREFIX + pkg, until) }
+    }
+
+    fun endReopeningSuspension(pkg: String) = prefs.edit { remove(KEY_REOPEN_PREFIX + pkg) }
+
+    fun isReopeningSuspended(pkg: String): Boolean = prefs.contains(KEY_REOPEN_PREFIX + pkg)
+
+    /** Every package with a recorded reopening suspension, mapped to its deadline. */
+    fun reopeningSuspensions(): Map<String, Long> {
+        val result = mutableMapOf<String, Long>()
+        prefs.all.forEach { (key, value) ->
+            if (!key.startsWith(KEY_REOPEN_PREFIX)) return@forEach
+            val until = value as? Long ?: return@forEach
+            result[key.removePrefix(KEY_REOPEN_PREFIX)] = until
+        }
+        return result
+    }
+
+    companion object {
+        const val PREFS_NAME = "time_limit_suspensions"
+        private const val KEY_DAILY_PREFIX = "daily_"
+        private const val KEY_REOPEN_PREFIX = "reopen_"
+    }
+}
diff -ruN -x '*.tflite' -x .github -x .idea -x '*.patch' -x README.md -x RELEASE-NOTES.md orig/app/src/main/java/io/github/warleysr/dechainer/data/WindowEnforcer.kt main/app/src/main/java/io/github/warleysr/dechainer/data/WindowEnforcer.kt
--- orig/app/src/main/java/io/github/warleysr/dechainer/data/WindowEnforcer.kt	1970-01-01 00:00:00.000000000 +0000
+++ main/app/src/main/java/io/github/warleysr/dechainer/data/WindowEnforcer.kt	2026-09-23 12:14:57.008142981 +0000
@@ -0,0 +1,189 @@
+package io.github.warleysr.dechainer.data
+
+import android.app.admin.DevicePolicyManager
+import android.content.ComponentName
+import android.content.Context
+import io.github.warleysr.dechainer.DechainerDeviceAdminReceiver
+import io.github.warleysr.dechainer.models.TimeWindow
+import timber.log.Timber
+import java.time.ZonedDateTime
+
+/**
+ * Enforces per-app and per-group time windows at the operating-system level, by suspending the
+ * package outside its allowed hours.
+ *
+ * Upstream enforces windows purely by putting an explanation screen in front of the app when the
+ * accessibility service notices it in the foreground. That is a prompt, not a block: turn the
+ * accessibility service off, or find any launch path the service doesn't observe, and the app
+ * opens normally. Suspension is enforced by the OS itself, so it holds with the service stopped,
+ * with the app relaunched from a widget or notification, and across reboots.
+ *
+ * Deliberately built as a twin of [ScheduleEnforcer] rather than something new: [sync] recomputes
+ * the whole desired state from scratch and is idempotent, so it is safe to call from the boundary
+ * alarm, from boot, from clock changes, from the service's periodic tick and after every edit in
+ * the UI. The screen upstream shows is kept — it explains *why* the app won't open.
+ *
+ * Ownership works exactly as in [ScheduleEnforcer]: a package is only released when the windows
+ * are the reason it was suspended. Anything suspended manually, by a schedule, by impulse lock,
+ * by visual blocking or by a time limit is left alone.
+ */
+object WindowEnforcer : AppBlockEngine() {
+    const val ACTION_BOUNDARY = "io.github.warleysr.dechainer.WINDOW_BOUNDARY"
+
+    // Ownership, hand-overs and the boundary alarm live in AppBlockEngine, shared with
+    // ScheduleEnforcer. Request code 1 keeps this alarm distinct from the schedule one (0).
+    override val statePrefsName = "window_state"
+    override val alarmRequestCode = 1
+    override val alarmAction = ACTION_BOUNDARY
+    override val logName = "Window"
+
+    fun sync(context: Context) {
+        val ctx = context.applicationContext
+        synchronized(lock) {
+            try {
+                syncLocked(ctx)
+            } catch (e: Exception) {
+                Timber.e(e, "Window sync failed")
+            }
+        }
+    }
+
+    fun isHeldByWindow(context: Context, pkg: String): Boolean = pkg in ownedApps(context)
+
+    /**
+     * Whether [pkg] is outside its allowed hours *right now*, recomputed from the stored settings
+     * rather than read from the last sync — callers use this to decide whether releasing a
+     * suspension for some other reason would wrongly open the app outside its window.
+     */
+    fun isBlockedRightNow(context: Context, pkg: String): Boolean {
+        val ctx = context.applicationContext
+        return try {
+            val windows = effectiveWindows(ctx, allowMemo = true)[pkg] ?: return false
+            val now = ZonedDateTime.now()
+            val nowMinute = now.hour * 60 + now.minute
+            windows.none { it.contains(nowMinute) }
+        } catch (e: Exception) {
+            Timber.w(e, "Window check failed for %s", pkg)
+            false
+        }
+    }
+
+    /**
+     * Every package outside its allowed hours right now, mapped to when its next window opens
+     * (epoch millis). Computed in one pass so a screen listing many apps doesn't rebuild the
+     * group and window tables once per app.
+     */
+    fun closedWindows(context: Context): Map<String, Long?> {
+        val ctx = context.applicationContext
+        return try {
+            val now = ZonedDateTime.now()
+            val nowMinute = now.hour * 60 + now.minute
+            val startOfDay = now.toLocalDate().atStartOfDay(now.zone)
+            effectiveWindows(ctx, allowMemo = true)
+                .filterValues { list -> list.none { it.contains(nowMinute) } }
+                .mapValues { (_, list) ->
+                    list.map { w ->
+                        val opening = startOfDay.plusMinutes(w.startMinute.toLong())
+                        if (opening.isAfter(now)) opening else opening.plusDays(1)
+                    }.minOrNull()?.toInstant()?.toEpochMilli()
+                }
+        } catch (e: Exception) {
+            Timber.w(e, "Could not compute closed windows")
+            emptyMap()
+        }
+    }
+
+    /**
+     * The windows that actually apply to each package right now, keyed by package.
+     *
+     * Matches the accessibility service's own resolution exactly (see `trackingConfigFor`): a
+     * group's windows and the app's own windows are intersected, and an empty result means "no
+     * restriction". That includes the case where a group's hours and an app's hours don't overlap
+     * at all — upstream treats that as unrestricted, and this must agree, or an app would be
+     * suspended with no screen ever explaining why.
+     */
+    private fun effectiveWindows(ctx: Context, allowMemo: Boolean = false): Map<String, List<TimeWindow>> {
+        if (allowMemo) {
+            memo?.let { if (System.currentTimeMillis() < memoValidUntil) return it }
+        }
+        val fresh = readEffectiveWindows(ctx)
+        memo = fresh
+        memoValidUntil = System.currentTimeMillis() + MEMO_MS
+        return fresh
+    }
+
+    // Reading this means parsing the groups and every app's stored hours. A release pass asks for
+    // one package at a time, so a one-second memo turns that back into a single read. sync() never
+    // uses the memo, so an edit in the UI always takes effect at once.
+    private const val MEMO_MS = 1000L
+
+    @Volatile
+    private var memo: Map<String, List<TimeWindow>>? = null
+
+    @Volatile
+    private var memoValidUntil = 0L
+
+    private fun readEffectiveWindows(ctx: Context): Map<String, List<TimeWindow>> {
+        val windowPrefs = ctx.getSharedPreferences(AppTimeWindows.PREFS_NAME, Context.MODE_PRIVATE)
+        val groups = AppGroupRepository.getGroups(forceRefresh = true)
+
+        val candidates = mutableSetOf<String>()
+        windowPrefs.all.keys.forEach { candidates += it }
+        groups.filter { it.timeWindows.isNotEmpty() }.forEach { candidates += it.packageNames }
+
+        return candidates.mapNotNull { pkg ->
+            val appWindows = AppTimeWindows.decode(windowPrefs.getString(pkg, null))
+            val group = groups.firstOrNull { pkg in it.packageNames }
+            val effective =
+                if (group != null) TimeWindow.intersect(group.timeWindows, appWindows) else appWindows
+            if (effective.isEmpty()) null else pkg to effective
+        }.toMap()
+    }
+
+    private fun syncLocked(ctx: Context) {
+        val dpm = ctx.getSystemService(Context.DEVICE_POLICY_SERVICE) as DevicePolicyManager
+        val admin = ComponentName(ctx, DechainerDeviceAdminReceiver::class.java)
+        val now = ZonedDateTime.now()
+
+        val windows = effectiveWindows(ctx)
+
+        if (!dpm.isDeviceOwnerApp(ctx.packageName)) {
+            armNextBoundary(ctx, windows, now)
+            return
+        }
+
+        val nowMinute = now.hour * 60 + now.minute
+        val protectedPkgs = ScheduleEnforcer.protectedPackages(ctx)
+        val desired = windows
+            .filterValues { list -> list.none { it.contains(nowMinute) } }
+            .keys - protectedPkgs
+
+        // A package a schedule window still needs blocked is handed to the schedule, which then
+        // releases it when its window ends. Dropping it instead left it blocked forever.
+        applyApps(ctx, dpm, admin, desired) { candidates ->
+            candidates.filter { ScheduleEnforcer.isHeldBySchedule(ctx, it) }
+                .onEach { ScheduleEnforcer.adopt(ctx, it) }
+                .toSet()
+        }
+        armNextBoundary(ctx, windows, now)
+    }
+
+    /** Wakes at the next moment any window opens or closes, one second after the boundary. */
+    private fun armNextBoundary(
+        ctx: Context,
+        windows: Map<String, List<TimeWindow>>,
+        now: ZonedDateTime
+    ): Long? {
+        val minutes = windows.values.flatten()
+            .flatMap { listOf(it.startMinute, it.endMinute) }
+            .toSet()
+        if (minutes.isEmpty()) return armAlarmFor(ctx, null)
+
+        val startOfDay = now.toLocalDate().atStartOfDay(now.zone)
+        val next = minutes.map { minute ->
+            val candidate = startOfDay.plusMinutes(minute.toLong())
+            if (candidate.isAfter(now)) candidate else candidate.plusDays(1)
+        }.minOrNull()
+        return armAlarmFor(ctx, next?.toInstant()?.toEpochMilli())
+    }
+}
