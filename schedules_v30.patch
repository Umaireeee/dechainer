+        } else {
+            items(currentChecks, key = { it.kind.name }) { check ->
+                ListItem(
+                    leadingContent = {
+                        Icon(
+                            if (check.ok) Icons.Outlined.CheckCircle else Icons.Outlined.Warning,
+                            contentDescription = null,
+                            tint = if (check.ok) MaterialTheme.colorScheme.primary
+                            else MaterialTheme.colorScheme.error
+                        )
+                    },
+                    headlineContent = { Text(stringResource(checkTitle(check.kind))) },
+                    supportingContent = { Text(stringResource(checkDesc(check.kind))) },
+                    trailingContent = {
+                        if (!check.ok) {
+                            TextButton(onClick = { fix(context, check.kind, navViewModel) }) {
+                                Text(stringResource(R.string.status_fix))
+                            }
+                        }
+                    }
+                )
+            }
+            // Xiaomi's own battery manager kills background apps regardless of the Android
+            // setting above, and no public API can detect it — so say it outright on those phones.
+            if (Build.MANUFACTURER.equals("xiaomi", ignoreCase = true)) {
+                item {
+                    Text(
+                        stringResource(R.string.status_xiaomi_note),
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                        modifier = Modifier.padding(horizontal = 16.dp, vertical = 4.dp)
+                    )
+                }
+            }
+        }
+
+        item { HorizontalDivider(modifier = Modifier.padding(horizontal = 16.dp, vertical = 8.dp)) }
+
+        // ---- blocked apps -------------------------------------------------------------------
+        item { SectionTitle(stringResource(R.string.status_blocked_now)) }
+
+        val currentBlocked = blocked
