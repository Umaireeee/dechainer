+private fun checkTitle(kind: BlockStatus.CheckKind): Int = when (kind) {
+    BlockStatus.CheckKind.DEVICE_OWNER -> R.string.status_check_owner
+    BlockStatus.CheckKind.ACCESSIBILITY -> R.string.status_check_accessibility
+    BlockStatus.CheckKind.EXACT_ALARMS -> R.string.status_check_alarms
+    BlockStatus.CheckKind.BATTERY -> R.string.status_check_battery
