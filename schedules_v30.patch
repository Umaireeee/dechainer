@@ -0,0 +1,121 @@
+package io.github.warleysr.dechainer.data
+
+import java.util.Locale
+
+/**
+ * The rules for when a forbidden word counts. Kept free of Android so they're unit-tested directly.
+ *
+ * Two rules, on purpose:
+ * - **Typed text** ([firstTypedMatch]) is matched anywhere, as plain text, on every keystroke. The
+ *   moment a forbidden word exists in the box it fires — inside a longer word, glued to other
+ *   words, with no space and no Enter needed. Typing is deliberate, so this is aggressive.
+ * - **Text on screen** ([pattern], passive blocking) is matched as whole words only. A page
+ *   isn't typed by you, and substring matching there would block "Sussex" for "sex".
+ */
+object WordMatcher {
+    // \p{M}: vowel signs and diacritics (Hindi matras, Urdu zer/zabar) are marks, not letters,
+    // so without them a word was split mid-word. ZWNJ/ZWJ join letters inside Urdu/Persian words.
+    private const val WORD_CHARS = "[\\p{L}\\p{M}\\p{N}_\\u200C\\u200D]"
+
+    /** Whole-word, any-case match of [word] — for text on screen. */
+    fun pattern(word: String): Regex = Regex(
+        "(?<!$WORD_CHARS)${Regex.escape(word)}(?!$WORD_CHARS)",
+        RegexOption.IGNORE_CASE
+    )
+
+    /** Forbidden words ready for [firstTypedMatch]: trimmed, lower-cased, blanks dropped. */
+    fun prepareTyped(words: Collection<String>): List<String> =
+        words.map { it.trim().lowercase(Locale.ROOT) }.filter { it.isNotEmpty() }.distinct()
+
+    /**
+     * The first forbidden word found anywhere in [text], or null. [prepared] comes from
+     * [prepareTyped]. Plain substring search: fast enough to run on every keystroke.
+     */
+    fun firstTypedMatch(text: String, prepared: List<String>): String? {
+        if (text.isEmpty() || prepared.isEmpty()) return null
+        val haystack = text.lowercase(Locale.ROOT)
+        return prepared.firstOrNull { haystack.contains(it) }
+    }
+
+    // ---- Smart adult-search detection ----
+    //
+    // Some words are adult on their own; many only in context — "hot girls" but not "hot
+    // weather". These rules read typed text the way a person would: an ambiguous word only
+    // counts when it's describing a person or a body, right next to it.
+
+    /** Adult wherever they appear, even glued inside other text. */
+    private val explicitAnywhere = listOf(
+        "porn", "xxx", "xvideo", "xnxx", "xhamster", "redtube", "youporn", "onlyfans",
+        "brazzers", "chaturbate", "stripchat", "hentai", "rule34", "nsfw", "blowjob",
+        "handjob", "camgirl", "sexting", "sextape", "chudai"
+    )
+
+    /** Adult as whole words only: they sit inside innocent words (Sussex, Milford, stitch). */
+    private val explicitWords = setOf("sex", "sexy", "milf", "nudes", "boobs", "tits", "horny", "nangi")
+
+    /** Adult next to a person, a body, or a picture/video — either side ("girls in bikini"). */
+    private val strongModifiers = setOf("naked", "nude", "leaked", "bikini", "lingerie", "busty")
+
+    /** Innocent on their own ("hot weather", "desi food"); adult right before a person or body. */
+    private val weakModifiers = setOf("hot", "thick", "desi")
+
+    private val people = setOf(
+        "girl", "girls", "gf", "girlfriend", "girlfriends", "woman", "women", "lady", "ladies",
+        "babe", "babes", "chick", "chicks", "model", "models", "actress", "actresses",
+        "aunty", "aunties", "auntie", "bhabhi", "bhabi", "teen", "teens", "wife", "wives",
+        "boy", "boys", "guy", "guys", "man", "men", "larki", "larkiyan", "ladki", "ladkiyan", "kudi"
+    )
+    private val body = setOf(
+        "body", "bodies", "legs", "feet", "butt", "booty", "ass", "thighs", "cleavage", "boobs", "figure"
+    )
+    private val media = setOf(
+        "pic", "pics", "photo", "photos", "image", "images", "video", "videos", "vid", "vids",
+        "clip", "clips", "reel", "reels", "mms"
+    )
+
+    /** Words close enough to count as describing each other: the next one or two. */
+    private const val NEAR = 2
+
+    private val separators = Regex("[^\\p{L}\\p{M}\\p{N}_]+")
+
+    /**
+     * Whether [text] reads as a search for adult content. Returns what gave it away, for the
+     * block screen, or null. Runs on every keystroke, so it's plain set lookups.
+     */
+    fun adultIntent(text: String): String? {
+        if (text.isBlank()) return null
+        val lower = text.lowercase(Locale.ROOT)
+
+        explicitAnywhere.firstOrNull { lower.contains(it) }?.let { return it }
+
+        val tokens = lower.split(separators).filter { it.isNotEmpty() }
+        tokens.firstOrNull { it in explicitWords }?.let { return it }
+
+        val strongTargets = people + body + media
+        val weakTargets = people + body
+        for ((i, token) in tokens.withIndex()) {
+            val targets = when (token) {
+                in strongModifiers -> strongTargets
+                in weakModifiers -> weakTargets
+                else -> continue
+            }
+            for (j in (i + 1)..(i + NEAR)) {
+                val next = tokens.getOrNull(j) ?: break
+                if (next in targets) return "$token $next"
+            }
+            // Strong words count in either order: "girls in bikini", "photos leaked".
+            if (token in strongModifiers) for (j in (i - NEAR) until i) {
+                val prev = tokens.getOrNull(j) ?: continue
+                if (prev in targets) return "$prev $token"
+            }
+        }
+
+        // Glued together: "hotgirls", "sexygirl", "desibhabhi". Short nouns are left out here
+        // ("man" would hide inside too many innocent words).
+        for (m in strongModifiers + weakModifiers + setOf("sexy")) {
+            val targets = if (m in weakModifiers) weakTargets else strongTargets
+            targets.firstOrNull { it.length >= 4 && lower.contains(m + it) }?.let { return m + it }
+        }
+        return null
+    }
+}
