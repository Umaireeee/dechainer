<?xml version="1.0" encoding="utf-8"?>
<!-- Backup is off (allowBackup="false"): nothing here is copied off the phone. These rules say the
     same thing explicitly for Android versions that read them. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
