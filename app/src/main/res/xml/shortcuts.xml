<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Opens the urge choice (ongoing or slipped). It cannot lock at once: the activity is exported, so this intent could be forged, and only the Quick Settings tile (which carries a one-time token) may start the lock without a question. -->
    <shortcut
        android:shortcutId="urge"
        android:enabled="true"
        android:icon="@drawable/ic_urge_tile"
        android:shortcutShortLabel="@string/urge_shortcut_short"
        android:shortcutLongLabel="@string/urge_shortcut_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="io.github.warleysr.dechainer"
            android:targetClass="io.github.warleysr.dechainer.activities.MainActivity">
            <extra android:name="urge_source" android:value="SHORTCUT" />
        </intent>
    </shortcut>
</shortcuts>
