--- orig/app/src/main/java/io/github/warleysr/dechainer/data/Blocker.kt	1970-01-01 00:00:00.000000000 +0000
+++ main/app/src/main/java/io/github/warleysr/dechainer/data/Blocker.kt	2026-09-22 10:22:16.040319397 +0000
@@ -0,0 +1,163 @@
+package io.github.warleysr.dechainer.data
+
+import android.app.admin.DevicePolicyManager
+import android.content.ComponentName
+import android.content.Context
+import android.content.pm.PackageManager
+import androidx.core.content.edit
+import timber.log.Timber
+
+/**
+ * How Déchaîner's own blocks — schedules, time windows, daily and group limits, reopening
+ * cooldowns — take an app away: hidden (default) or suspended.
+ *
+ * Hidden: the app disappears from every launcher until the block ends, so there is no icon to tap
+ * and no "Blocked by work policy" dialog. Suspended: the icon stays, greyed out.
+ *
+ * Hiding has two traps suspension doesn't, and this class exists to close them:
+ * - A hidden app looks uninstalled, so a plain package lookup misses it. Use [isInstalled].
+ * - Android does NOT un-hide apps when a Device Owner is removed. So every app hidden here is
+ *   recorded, and [releaseAllHidden] runs before Device Owner is ever given up.
+ * It only ever un-hides apps it hid itself — never one hidden by hand in the Apps tab.
+ */
+object Blocker {
+    private const val PREFS = "blocker"
+    private const val KEY_HIDE_MODE = "hide_blocked_apps"
+    private const val KEY_HIDDEN_BY_US = "hidden_by_blocker"
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    fun isHideMode(context: Context): Boolean = prefs(context).getBoolean(KEY_HIDE_MODE, true)
+
+    private const val KEY_SELF_HIDE = "self_hide_enabled"
+
+    /** Whether the person has chosen to hide Déchaîner's own launcher icon. */
+    fun isSelfHideEnabled(context: Context): Boolean =
+        prefs(context).getBoolean(KEY_SELF_HIDE, false)
+
+    /**
+     * The launcher entry (an activity-alias in the manifest). Self-hide switches only this off.
+     *
+     * Never setApplicationHidden on our own package: Android refuses to hide an active device
+     * admin, and if it ever did, a hidden package is treated as uninstalled — the accessibility
+     * service, the boundary alarms and the dial-code receiver would all stop, i.e. every block off.
+     * The alias's class name is namespace-based, so it's spelled out rather than built from
+     * packageName (which is the applicationId and may differ in a fork).
+     */
+    private fun launcherAlias(ctx: Context) =
+        ComponentName(ctx.packageName, "io.github.warleysr.dechainer.LauncherAlias")
+
+    private fun applySelfHide(ctx: Context, hide: Boolean) {
+        val state = if (hide) PackageManager.COMPONENT_ENABLED_STATE_DISABLED
+        else PackageManager.COMPONENT_ENABLED_STATE_DEFAULT
+        ctx.packageManager.setComponentEnabledSetting(launcherAlias(ctx), state, PackageManager.DONT_KILL_APP)
+    }
+
+    /**
+     * Turns self-hide on or off. Hiding here is on the person's terms, not a schedule's, so it
+     * can't leave them locked out by a block they didn't start: the dial code *#*#342246#*#*
+     * opens the app, and this off-switch brings the icon back immediately.
+     */
+    fun setSelfHide(context: Context, hide: Boolean) {
+        prefs(context).edit(commit = true) { putBoolean(KEY_SELF_HIDE, hide) }
+        try {
+            applySelfHide(context.applicationContext, hide)
+        } catch (e: Exception) {
+            Timber.w(e, "Could not change self-hide")
+        }
+    }
+
+    /**
+     * Belt and braces on every startup: if self-hide is OFF, make certain Déchaîner's own icon is
+     * visible — the launcher alias enabled, and the package not hidden (repairs builds that tried
+     * to hide the whole package).
+     */
+    fun ensureSelfVisible(context: Context) {
+        if (isSelfHideEnabled(context)) return
+        val ctx = context.applicationContext
+        try {
+            val alias = launcherAlias(ctx)
+            if (ctx.packageManager.getComponentEnabledSetting(alias) ==
+                PackageManager.COMPONENT_ENABLED_STATE_DISABLED
+            ) applySelfHide(ctx, false)
+            val dpm = ctx.getSystemService(Context.DEVICE_POLICY_SERVICE) as DevicePolicyManager
+            val admin = ComponentName(ctx, io.github.warleysr.dechainer.DechainerDeviceAdminReceiver::class.java)
+            if (dpm.isAdminActive(admin) && dpm.isApplicationHidden(admin, ctx.packageName)) {
+                dpm.setApplicationHidden(admin, ctx.packageName, false)
+            }
+        } catch (e: Exception) {
+            Timber.w(e, "Could not ensure self visible")
+        }
+    }
+
+    fun setHideMode(context: Context, hide: Boolean) =
+        prefs(context).edit(commit = true) { putBoolean(KEY_HIDE_MODE, hide) }
+
+    fun hiddenByUs(context: Context): Set<String> =
+        prefs(context).getStringSet(KEY_HIDDEN_BY_US, emptySet())?.toSet() ?: emptySet()
+
+    private fun saveHiddenByUs(context: Context, pkgs: Set<String>) =
+        prefs(context).edit(commit = true) { putStringSet(KEY_HIDDEN_BY_US, pkgs) }
+
+    /** Whether the app exists at all — including while hidden, which a plain lookup misses. */
+    fun isInstalled(context: Context, pkg: String): Boolean = try {
+        context.packageManager.getPackageInfo(pkg, PackageManager.MATCH_UNINSTALLED_PACKAGES)
+        true
+    } catch (_: PackageManager.NameNotFoundException) {
+        false
+    }
+
+    /** Blocked either way — hidden or suspended. */
+    fun isBlocked(dpm: DevicePolicyManager, admin: ComponentName, pkg: String): Boolean {
+        val hidden = try { dpm.isApplicationHidden(admin, pkg) } catch (_: Exception) { false }
+        if (hidden) return true
+        return try { dpm.isPackageSuspended(admin, pkg) } catch (_: Exception) { false }
+    }
+
+    /** Blocks [pkgs] the chosen way. Returns the ones Android refused outright. */
+    fun block(context: Context, dpm: DevicePolicyManager, admin: ComponentName, pkgs: Collection<String>): Set<String> {
+        if (pkgs.isEmpty()) return emptySet()
+        if (!isHideMode(context)) return dpm.setPackagesSuspended(admin, pkgs.toTypedArray(), true).toSet()
+
+        val hidden = mutableSetOf<String>()
+        val refused = mutableSetOf<String>()
+        for (pkg in pkgs) {
+            val ok = try { dpm.setApplicationHidden(admin, pkg, true) } catch (_: Exception) { false }
+            if (ok) hidden += pkg else refused += pkg
+        }
+        if (hidden.isNotEmpty()) saveHiddenByUs(context, hiddenByUs(context) + hidden)
+        // Some apps can't be hidden. Suspend those instead, so they're still blocked.
+        if (refused.isEmpty()) return emptySet()
+        Timber.w("Could not hide %s; suspending instead", refused)
+        return dpm.setPackagesSuspended(admin, refused.toTypedArray(), true).toSet()
+    }
+
+    /** Releases [pkgs] however they were blocked. Un-hides only apps this class hid. */
+    fun release(context: Context, dpm: DevicePolicyManager, admin: ComponentName, pkgs: Collection<String>) {
+        if (pkgs.isEmpty()) return
+        val ours = hiddenByUs(context)
+        val unhidden = pkgs.filter { it in ours }.filter { pkg ->
+            try { dpm.setApplicationHidden(admin, pkg, false); true } catch (e: Exception) {
+                Timber.w(e, "Could not un-hide %s", pkg); false
+            }
+        }.toSet()
+        if (unhidden.isNotEmpty()) saveHiddenByUs(context, ours - unhidden)
+        try { dpm.setPackagesSuspended(admin, pkgs.toTypedArray(), false) } catch (_: Exception) {}
+    }
+
+    /** The person hid this by hand: it's theirs now, so a block ending must not bring it back. */
+    fun forget(context: Context, pkg: String) {
+        val ours = hiddenByUs(context)
+        if (pkg in ours) saveHiddenByUs(context, ours - pkg)
+    }
+
+    /** Un-hides everything hidden here. Must run before Device Owner is removed. */
+    fun releaseAllHidden(context: Context, dpm: DevicePolicyManager, admin: ComponentName) {
+        val ours = hiddenByUs(context)
+        val left = ours.filterNot { pkg ->
+            try { dpm.setApplicationHidden(admin, pkg, false); true } catch (_: Exception) { false }
+        }.toSet()
+        saveHiddenByUs(context, left)
+    }
+}
