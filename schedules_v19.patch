--- orig/app/src/test/java/io/github/warleysr/dechainer/BlockStatusTest.kt	1970-01-01 00:00:00.000000000 +0000
+++ main/app/src/test/java/io/github/warleysr/dechainer/BlockStatusTest.kt	2026-09-22 10:13:27.992827337 +0000
@@ -0,0 +1,92 @@
+package io.github.warleysr.dechainer
+
+import io.github.warleysr.dechainer.data.BlockStatus
+import io.github.warleysr.dechainer.data.BlockStatus.Reason
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The Status screen is only useful if it names the right cause. These pin the rules that decide
+ * which causes are shown for a blocked app.
+ */
+class BlockStatusTest {
+
+    private fun reasons(
+        isSuspended: Boolean = true,
+        isHidden: Boolean = false,
+        scheduleName: String? = null,
+        scheduleUntil: Long? = null,
+        windowClosed: Boolean = false,
+        windowOpensAt: Long? = null,
+        dailyLimit: Boolean = false,
+        cooldownUntil: Long? = null,
+        impulse: Boolean = false,
+        explicitUntil: Long? = null
+    ) = BlockStatus.reasonsFor(
+        isSuspended, isHidden, scheduleName, scheduleUntil, windowClosed, windowOpensAt,
+        dailyLimit, cooldownUntil, impulse, explicitUntil
+    )
+
+    @Test
+    fun suspendedWithNoFeatureClaimingItIsManual() {
+        val r = reasons()
+        assertEquals(1, r.size)
+        assertTrue(r.single() is Reason.Manual)
+    }
+
+    /**
+     * If a feature is holding the app, "suspended by you" would be false and would bury the one
+     * fact the person needs: what is holding it and until when.
+     */
+    @Test
+    fun aFeatureHoldingTheAppIsNeverAlsoCalledManual() {
+        val r = reasons(scheduleName = "Nights", scheduleUntil = 1000L)
+        assertEquals(1, r.size)
+        assertTrue(r.single() is Reason.Schedule)
+        assertEquals("Nights", (r.single() as Reason.Schedule).name)
+    }
+
+    @Test
+    fun everyHolderIsListedWhenSeveralApply() {
+        val r = reasons(
+            scheduleName = "Nights", scheduleUntil = 1000L,
+            windowClosed = true, windowOpensAt = 2000L,
+            dailyLimit = true,
+            impulse = true
+        )
+        assertEquals(4, r.size)
+        assertTrue(r.none { it is Reason.Manual })
+    }
+
+    @Test
+    fun aScheduleNeedsBothItsNameAndItsEndTime() {
+        assertTrue(reasons(scheduleName = "Nights", scheduleUntil = null).single() is Reason.Manual)
+        assertTrue(reasons(scheduleName = null, scheduleUntil = 1000L).single() is Reason.Manual)
+    }
+
+    @Test
+    fun aClosedWindowWithUnknownOpeningIsStillReported() {
+        val r = reasons(windowClosed = true, windowOpensAt = null)
+        assertTrue(r.single() is Reason.OutsideWindow)
+        assertEquals(null, (r.single() as Reason.OutsideWindow).opensAtMillis)
+    }
+
+    @Test
+    fun hiddenByHandIsReportedWhenNoFeatureClaimsIt() {
+        assertTrue(reasons(isSuspended = false, isHidden = true).single() is Reason.Hidden)
+    }
+
+    /** With hiding on, a schedule or limit hides apps too — that must not read "hidden by you". */
+    @Test
+    fun anAppHiddenByAFeatureShowsOnlyThatFeature() {
+        val r = reasons(isSuspended = false, isHidden = true, dailyLimit = true)
+        assertEquals(1, r.size)
+        assertTrue(r.single() is Reason.DailyLimit)
+    }
+
+    @Test
+    fun anAppThatIsNeitherSuspendedNorHiddenHasNoReasons() {
+        assertTrue(reasons(isSuspended = false).isEmpty())
+    }
+}
