diff -ruN -x '*.tflite' -x .github -x .idea -x '*.patch' -x README.md orig/app/src/test/java/io/github/warleysr/dechainer/TimeWindowLogicTest.kt main/app/src/test/java/io/github/warleysr/dechainer/TimeWindowLogicTest.kt
--- orig/app/src/test/java/io/github/warleysr/dechainer/TimeWindowLogicTest.kt	1970-01-01 00:00:00.000000000 +0000
+++ main/app/src/test/java/io/github/warleysr/dechainer/TimeWindowLogicTest.kt	2026-09-21 03:24:21.923327212 +0000
@@ -0,0 +1,92 @@
+package io.github.warleysr.dechainer
+
+import io.github.warleysr.dechainer.models.TimeWindow
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Covers the window maths WindowEnforcer decides suspensions from. All of it is pure, so it runs
+ * on the JVM in the CI gate rather than needing an emulator.
+ *
+ * The cases that matter are the awkward ones: windows crossing midnight, and the intersection of a
+ * group's hours with an app's own hours. A mistake in either means an app is suspended when it
+ * should be usable, or usable when it should be blocked.
+ */
+class TimeWindowLogicTest {
+
+    private fun min(h: Int, m: Int = 0) = h * 60 + m
+
+    @Test
+    fun ordinaryWindowContainsOnlyItsOwnHours() {
+        val w = TimeWindow(min(9), min(17))
+        assertFalse(w.contains(min(8, 59)))
+        assertTrue(w.contains(min(9)))
+        assertTrue(w.contains(min(16, 59)))
+        // End is exclusive: at 17:00 the window is shut.
+        assertFalse(w.contains(min(17)))
+    }
+
+    @Test
+    fun windowCrossingMidnightWrapsCorrectly() {
+        val w = TimeWindow(min(22), min(2))
+        assertTrue(w.contains(min(23, 30)))
+        assertTrue(w.contains(min(0, 30)))
+        assertTrue(w.contains(min(1, 59)))
+        assertFalse(w.contains(min(2)))
+        assertFalse(w.contains(min(12)))
+    }
+
+    @Test
+    fun anEmptyRestrictionIsTheIdentityForIntersection() {
+        val app = listOf(TimeWindow(min(9), min(17)))
+        assertEquals(app, TimeWindow.intersect(emptyList(), app))
+        assertEquals(app, TimeWindow.intersect(app, emptyList()))
+    }
+
+    @Test
+    fun groupAndAppHoursIntersectRatherThanReplace() {
+        val group = listOf(TimeWindow(min(8), min(12)))
+        val app = listOf(TimeWindow(min(10), min(18)))
+        val effective = TimeWindow.intersect(group, app)
+
+        assertEquals(1, effective.size)
+        assertTrue(effective.first().contains(min(11)))
+        // Allowed by the app alone, but outside the group's hours.
+        assertFalse(effective.first().contains(min(13)))
+        // Allowed by the group alone, but outside the app's hours.
+        assertFalse(effective.first().contains(min(9)))
+    }
+
+    @Test
+    fun midnightCrossingWindowsIntersectThroughTheWrap() {
+        val group = listOf(TimeWindow(min(20), min(4)))
+        val app = listOf(TimeWindow(min(22), min(6)))
+        val effective = TimeWindow.intersect(group, app)
+
+        assertTrue(effective.any { it.contains(min(23)) })
+        assertTrue(effective.any { it.contains(min(2)) })
+        assertFalse(effective.any { it.contains(min(21)) })
+        assertFalse(effective.any { it.contains(min(5)) })
+    }
+
+    /**
+     * Disjoint hours produce an empty intersection, which the app treats as "no restriction" — so
+     * the enforcer must leave such an app alone. Pinned here deliberately: it is surprising, and
+     * if upstream ever changes it, the enforcer has to change in the same direction or an app gets
+     * suspended with no screen explaining why.
+     */
+    @Test
+    fun disjointGroupAndAppHoursMeanNoRestriction() {
+        val group = listOf(TimeWindow(min(9), min(12)))
+        val app = listOf(TimeWindow(min(14), min(18)))
+        assertTrue(TimeWindow.intersect(group, app).isEmpty())
+    }
+
+    @Test
+    fun minutesUntilEndHandlesTheWrap() {
+        assertEquals(60, TimeWindow(min(9), min(17)).minutesUntilEnd(min(16)))
+        assertEquals(150, TimeWindow(min(22), min(2)).minutesUntilEnd(min(23, 30)))
+    }
+}
