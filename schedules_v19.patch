+import io.github.warleysr.dechainer.DechainerAccessibilityService
+import io.github.warleysr.dechainer.security.SecurityManager
+import timber.log.Timber
+
+/**
+ * Answers two questions the rest of the app can't: *why is this app blocked*, and *is blocking
+ * actually working on this phone*.
+ *
+ * Six different features can suspend an app — schedules, time windows, daily limits, reopening
+ * cooldowns, impulse lock and visual blocking — and each keeps its own record. Nothing ever put
+ * those records side by side, so a greyed-out app gave no clue which feature was holding it or
+ * when it would come back. This reads every record and says so.
+ *
+ * Read-only by design. Nothing here can change a block, so the screen showing it can never
+ * become a way around one.
+ */
+object BlockStatus {
+
+    /** One reason an app is blocked. An app can have several at once. */
+    sealed interface Reason {
+        class Schedule(val name: String, val untilMillis: Long) : Reason
+        class OutsideWindow(val opensAtMillis: Long?) : Reason
+        object DailyLimit : Reason
+        class Cooldown(val untilMillis: Long) : Reason
+        object Impulse : Reason
+        class ExplicitContent(val untilMillis: Long) : Reason
+        /** Suspended, but by no feature — the person did it from the Apps tab. */
+        object Manual : Reason
+        object Hidden : Reason
+    }
+
+    class BlockedApp(
+        val packageName: String,
+        val name: String,
+        val icon: Drawable,
+        val reasons: List<Reason>
+    )
+
+    enum class CheckKind { DEVICE_OWNER, ACCESSIBILITY, EXACT_ALARMS, BATTERY, DNS_FILTER, NOTIFICATIONS }
+
+    class Check(val kind: CheckKind, val ok: Boolean)
+
+    /**
+     * Assembles the reasons for one app from the facts each feature records. Pure, so it is
+     * unit-tested directly.
+     *
+     * "Suspended by you" is reported only when no feature claims the suspension. Otherwise a
+     * schedule-held app would also claim to be manual, and the one fact the person needs — what
+     * is holding it and until when — would be buried.
+     */
+    internal fun reasonsFor(
+        isSuspended: Boolean,
+        isHidden: Boolean,
+        scheduleName: String?,
+        scheduleUntil: Long?,
+        windowClosed: Boolean,
+        windowOpensAt: Long?,
+        dailyLimit: Boolean,
+        cooldownUntil: Long?,
+        impulse: Boolean,
+        explicitUntil: Long?
+    ): List<Reason> {
+        val reasons = mutableListOf<Reason>()
+        if (scheduleName != null && scheduleUntil != null) reasons += Reason.Schedule(scheduleName, scheduleUntil)
+        if (windowClosed) reasons += Reason.OutsideWindow(windowOpensAt)
+        if (dailyLimit) reasons += Reason.DailyLimit
+        if (cooldownUntil != null) reasons += Reason.Cooldown(cooldownUntil)
+        if (impulse) reasons += Reason.Impulse
+        if (explicitUntil != null) reasons += Reason.ExplicitContent(explicitUntil)
+        // "By you" only when no feature claims the app — with hiding on, a schedule hides apps too.
+        if (reasons.isEmpty()) {
+            if (isHidden) reasons += Reason.Hidden
+            else if (isSuspended) reasons += Reason.Manual
+        }
+        return reasons
+    }
+
+    /** Every suspended or hidden app, with every reason it's blocked. Call off the main thread. */
+    fun blockedApps(context: Context): List<BlockedApp> {
+        val ctx = context.applicationContext
+        return try {
+            val now = System.currentTimeMillis()
+            val timeLimits = TimeLimitSuspensionTracker(ctx)
+            val daily = timeLimits.dailyLimitSuspensions().keys
+            val cooldowns = timeLimits.reopeningSuspensions().filterValues { it > now }
+            val impulse = SecurityManager.getActiveImpulseSuspension(ctx)
+            val explicit = VisualBlockingSuspensionTracker(ctx).activeSuspensions().filterValues { it > now }
+            val closedWindows = WindowEnforcer.closedWindows(ctx)
+
+            AppRepository.getApps(forceRefresh = true)
+                .filter { it.isSuspended || it.isHidden }
+                .map { app ->
+                    val pkg = app.packageName
+                    val schedule = ScheduleEnforcer.activeBlockFor(ctx, pkg)
+                    BlockedApp(
+                        packageName = pkg,
+                        name = app.name,
+                        icon = app.icon,
+                        reasons = reasonsFor(
+                            isSuspended = app.isSuspended,
+                            isHidden = app.isHidden,
+                            scheduleName = schedule?.scheduleName,
+                            scheduleUntil = schedule?.endsAtMillis,
+                            windowClosed = pkg in closedWindows,
+                            windowOpensAt = closedWindows[pkg],
+                            dailyLimit = pkg in daily,
+                            cooldownUntil = cooldowns[pkg],
+                            impulse = pkg in impulse,
+                            explicitUntil = explicit[pkg]
+                        )
+                    )
+                }
+                .sortedBy { it.name.lowercase() }
+        } catch (e: Exception) {
+            Timber.e(e, "Could not collect block status")
+            emptyList()
+        }
+    }
+
+    /**
+     * The conditions blocking depends on. Each one failing breaks something specific:
+     * no Device Owner and nothing can be suspended at all; no exact alarms and windows open and
+     * close late; battery optimisation and the whole app can be put to sleep between boundaries.
+     */
+    fun healthChecks(context: Context): List<Check> {
+        val ctx = context.applicationContext
+        val exactAlarms = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            (ctx.getSystemService(Context.ALARM_SERVICE) as AlarmManager).canScheduleExactAlarms()
+        } else true
+        val battery = (ctx.getSystemService(Context.POWER_SERVICE) as PowerManager)
+            .isIgnoringBatteryOptimizations(ctx.packageName)
+        val notifications = Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU ||
+            ContextCompat.checkSelfPermission(ctx, Manifest.permission.POST_NOTIFICATIONS) ==
+            PackageManager.PERMISSION_GRANTED
+
+        return listOf(
+            Check(CheckKind.DEVICE_OWNER, safe { DeviceOwnerRepository.isDeviceOwner() }),
+            // The service's own flag, set when it actually connects and cleared when it dies.
+            // Not DeviceOwnerRepository.isAccessibilityGranted(): that shells out through Shizuku,
+            // which only runs during setup, so after a reboot it reports "off" for a service that
+            // is plainly running.
+            Check(CheckKind.ACCESSIBILITY, DechainerAccessibilityService.isRunning),
+            Check(CheckKind.EXACT_ALARMS, exactAlarms),
+            Check(CheckKind.BATTERY, battery),
+            Check(CheckKind.DNS_FILTER, safe { DnsGuard.isActive(ctx) }),
+            Check(CheckKind.NOTIFICATIONS, notifications)
+        )
+    }
+
+    private inline fun safe(block: () -> Boolean): Boolean = try {
+        block()
+    } catch (e: Exception) {
+        Timber.w(e, "Health check failed")
+        false
+    }
+}
