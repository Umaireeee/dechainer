+            TextButton(onClick = { gate.cancelWait() }) { Text(stringResource(R.string.unlock_wait_cancel)) }
+        }
+    )
+}
+
+private fun formatWait(ms: Long): String {
+    val total = (ms + 999) / 1000
+    val h = total / 3600
+    val m = (total % 3600) / 60
+    val s = total % 60
+    return if (h > 0) "%d:%02d:%02d".format(h, m, s) else "%d:%02d".format(m, s)
+}
