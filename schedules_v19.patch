@@ -0,0 +1,33 @@
+package io.github.warleysr.dechainer.data
+
+/**
+ * The rules for when a forbidden word counts, shared by active and passive blocking.
+ *
+ * Kept free of Android so the rules are unit-tested directly: a blocker that fires on innocent
+ * words teaches people to switch it off, so "no false alarms" matters as much as catching the
+ * word at all.
+ */
+object WordMatcher {
+    // \p{M}: vowel signs and diacritics (Hindi matras, Urdu zer/zabar) are marks, not letters,
+    // so without them a word was split mid-word. ZWNJ/ZWJ join letters inside Urdu/Persian words.
+    private const val WORD_CHARS = "[\\p{L}\\p{M}\\p{N}_\\u200C\\u200D]"
+
+    /** The word still being typed — trailing letters and digits with no separator after them. */
+    private val wordInProgress = Regex("$WORD_CHARS+$")
+
+    /**
+     * Matches [word] only as a whole word, in any case. Identical to the pattern the service
+     * builds from the settings, so the tests below exercise the real rule.
+     */
+    fun pattern(word: String): Regex = Regex(
+        "(?<!$WORD_CHARS)${Regex.escape(word)}(?!$WORD_CHARS)",
+        RegexOption.IGNORE_CASE
+    )
+
+    /**
+     * [text] minus the word still being typed. "watch porn vid" → "watch porn ": the finished
+     * words can be judged now, while "vid" might still become "videos" — and "class" might still
+     * become "classification".
+     */
+    fun finishedPart(text: String): String = text.replace(wordInProgress, "")
+}
