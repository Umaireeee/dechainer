+/**
+ * One screen answering "is blocking working?" and "why is this app blocked?".
+ *
+ * Refreshes on entry and on demand rather than on resume, so it needs no dependency the project
+ * doesn't already have. After fixing something in Settings, tap refresh.
+ */
+@Composable
+fun StatusScreen(navViewModel: NavigationViewModel = viewModel()) {
+    val context = LocalContext.current
+    var refreshKey by remember { mutableStateOf(0) }
+    var checks by remember { mutableStateOf<List<BlockStatus.Check>?>(null) }
+    var blocked by remember { mutableStateOf<List<BlockStatus.BlockedApp>?>(null) }
+
+    LaunchedEffect(refreshKey) {
+        val result = withContext(Dispatchers.IO) {
+            BlockStatus.healthChecks(context) to BlockStatus.blockedApps(context)
+        }
+        checks = result.first
+        blocked = result.second
+    }
+
+    LazyColumn(modifier = Modifier.fillMaxSize()) {
+        item {
+            Row(
+                verticalAlignment = Alignment.CenterVertically,
+                modifier = Modifier.padding(start = 16.dp, end = 8.dp, top = 8.dp)
+            ) {
+                Text(
+                    stringResource(R.string.status_desc),
+                    style = MaterialTheme.typography.bodyMedium,
+                    modifier = Modifier.weight(1f)
+                )
+                IconButton(onClick = {
+                    checks = null
+                    blocked = null
+                    refreshKey++
+                }) {
