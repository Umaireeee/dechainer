+                        TextButton(onClick = { viewModel.updateDraft { it.copy(days = WEEKDAYS) } }) {
+                            Text(stringResource(R.string.schedule_weekdays))
+                        }
+                        TextButton(onClick = { viewModel.updateDraft { it.copy(days = WEEKENDS) } }) {
