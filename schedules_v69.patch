+            TextButton(enabled = custom.isNotEmpty(), onClick = { onPick(custom.toInt()) }) {
+                Text(stringResource(R.string.unlock_delay_set))
+            }
+        },
+        dismissButton = {
+            TextButton(onClick = onDismiss) { Text(stringResource(R.string.unlock_wait_close)) }
+        }
+    )
+}
