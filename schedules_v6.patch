--- dechainer-orig/app/src/main/java/io/github/warleysr/dechainer/data/ConfessionLog.kt	1970-01-01 00:00:00.000000000 +0000
+++ dechainer-main/app/src/main/java/io/github/warleysr/dechainer/data/ConfessionLog.kt	2026-09-18 09:49:42.314617515 +0000
@@ -0,0 +1,88 @@
+package io.github.warleysr.dechainer.data
+
+import android.content.Context
+import androidx.core.content.edit
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+import java.util.UUID
+
+/**
+ * A local-only voice log: a short recording of *why* the person is about to loosen a protection,
+ * offered back to them the next time they reach for the same kind of action. Nothing here is ever
+ * uploaded or sent anywhere — recording it is always optional (see AccountabilityStep), and this
+ * class only ever gets called once someone has already chosen to record.
+ */
+object ConfessionLog {
+    private const val PREFS_NAME = "confession_log"
+    private const val KEY_ENTRIES = "entries_json"
+
+    /** Oldest entries are dropped past this count, same reasoning as capping any on-device log. */
+    private const val MAX_ENTRIES = 20
+
+    data class Entry(val id: String, val timestampMillis: Long, val category: String, val label: String)
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    private fun dir(context: Context): File =
+        File(context.applicationContext.filesDir, "confessions").apply { mkdirs() }
+
+    fun audioFile(context: Context, id: String): File = File(dir(context), "$id.m4a")
+
+    fun getEntries(context: Context): List<Entry> {
+        val json = prefs(context).getString(KEY_ENTRIES, null) ?: return emptyList()
+        return try {
+            val array = JSONArray(json)
+            (0 until array.length()).map { i ->
+                val o = array.getJSONObject(i)
+                Entry(o.getString("id"), o.getLong("ts"), o.getString("category"), o.getString("label"))
+            }.sortedByDescending { it.timestampMillis }
+        } catch (e: Exception) {
+            emptyList()
+        }
+    }
+
+    /** Most recent entry recorded for this [category] (e.g. "schedule_disable"), if any. */
+    fun mostRecentFor(context: Context, category: String): Entry? =
+        getEntries(context).firstOrNull { it.category == category }
+
+    /**
+     * Registers a confession whose audio has *already* been written to [audioFile] for the
+     * returned entry's id — see [io.github.warleysr.dechainer.security.VoiceRecorder]. Trims the
+     * log to [MAX_ENTRIES], deleting the audio file of anything dropped.
+     */
+    fun addEntry(context: Context, category: String, label: String): Entry {
+        val entry = Entry(UUID.randomUUID().toString(), System.currentTimeMillis(), category, label)
+        val all = (listOf(entry) + getEntries(context)).sortedByDescending { it.timestampMillis }
+        val kept = all.take(MAX_ENTRIES)
+        (all - kept).forEach { audioFile(context, it.id).delete() }
+        saveAll(context, kept)
+        return entry
+    }
+
+    fun delete(context: Context, entryId: String) {
+        audioFile(context, entryId).delete()
+        saveAll(context, getEntries(context).filterNot { it.id == entryId })
+    }
+
+    fun clearAll(context: Context) {
+        dir(context).listFiles()?.forEach { it.delete() }
+        prefs(context).edit(commit = true) { remove(KEY_ENTRIES) }
+    }
+
+    private fun saveAll(context: Context, entries: List<Entry>) {
+        val array = JSONArray()
+        entries.forEach { e ->
+            array.put(
+                JSONObject().apply {
+                    put("id", e.id)
+                    put("ts", e.timestampMillis)
+                    put("category", e.category)
+                    put("label", e.label)
+                }
+            )
+        }
+        prefs(context).edit(commit = true) { putString(KEY_ENTRIES, array.toString()) }
+    }
+}
