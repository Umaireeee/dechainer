+@Composable
+private fun daysLabel(days: Set<DayOfWeek>): String = when (days) {
+    DayOfWeek.entries.toSet() -> stringResource(R.string.schedule_every_day)
+    WEEKDAYS -> stringResource(R.string.schedule_weekdays)
+    WEEKENDS -> stringResource(R.string.schedule_weekends)
+    else -> DayOfWeek.entries.filter { it in days }
+        .joinToString(" ") { it.getDisplayName(TextStyle.SHORT, Locale.getDefault()) }
+}
