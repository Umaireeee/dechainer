--- dechainer-orig/app/src/test/java/io/github/warleysr/dechainer/PetCompanionTest.kt	1970-01-01 00:00:00.000000000 +0000
+++ dechainer-main/app/src/test/java/io/github/warleysr/dechainer/PetCompanionTest.kt	2026-09-18 15:49:16.208625562 +0000
@@ -0,0 +1,52 @@
+package io.github.warleysr.dechainer
+
+import io.github.warleysr.dechainer.data.PetCompanion
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import java.time.LocalDate
+
+class PetCompanionTest {
+
+    private val start: LocalDate = LocalDate.of(2026, 9, 1)
+    private val max = PetCompanion.MAX_LEVEL
+
+    @Test
+    fun noSlipEverIsFullHealth() {
+        assertEquals(max, PetCompanion.healthLevel(max, null, start))
+        assertEquals(0, PetCompanion.daysUntilNextLevel(max, null, start))
+    }
+
+    @Test
+    fun oneSlipFromFullHealthIsNotAllOrNothing() {
+        // Thriving (4) minus DAMAGE_LEVELS (2) = 2, NOT 0.
+        val baseline = max - PetCompanion.DAMAGE_LEVELS
+        assertEquals(2, PetCompanion.healthLevel(baseline, start, start))
+        // And it climbs back from there, not from zero.
+        assertEquals(3, PetCompanion.healthLevel(baseline, start, start.plusDays(2)))
+        assertEquals(max, PetCompanion.healthLevel(baseline, start, start.plusDays(4)))
+    }
+
+    @Test
+    fun repeatedSlipsStillBottomOut() {
+        // Slip from 2 -> 0: repeated bypassing does drive the pet to its worst state.
+        assertEquals(0, PetCompanion.healthLevel(0, start, start))
+        assertEquals(0, PetCompanion.healthLevel(0, start, start.plusDays(1)))
+        assertEquals(1, PetCompanion.healthLevel(0, start, start.plusDays(2)))
+    }
+
+    @Test
+    fun healthCapsAtMaxLevel() {
+        assertEquals(max, PetCompanion.healthLevel(0, start, start.plusDays(1000)))
+        assertEquals(0, PetCompanion.daysUntilNextLevel(0, start, start.plusDays(1000)))
+    }
+
+    @Test
+    fun daysUntilNextLevelCountsDownAndNeverReportsZeroWhileRecovering() {
+        assertEquals(2, PetCompanion.daysUntilNextLevel(0, start, start))
+        assertEquals(1, PetCompanion.daysUntilNextLevel(0, start, start.plusDays(1)))
+        // Just climbed a level, so the countdown restarts for the next one.
+        assertEquals(2, PetCompanion.daysUntilNextLevel(0, start, start.plusDays(2)))
+        // Recovering from a partial slip reports a sane countdown too.
+        assertEquals(2, PetCompanion.daysUntilNextLevel(2, start, start))
+    }
+}
diff -ruN -x '*.tflite' -x .github dechainer-orig/app/src/test/java/io/github/warleysr/dechainer/RegretLogTest.kt dechainer-main/app/src/test/java/io/github/warleysr/dechainer/RegretLogTest.kt
--- dechainer-orig/app/src/test/java/io/github/warleysr/dechainer/RegretLogTest.kt	1970-01-01 00:00:00.000000000 +0000
+++ dechainer-main/app/src/test/java/io/github/warleysr/dechainer/RegretLogTest.kt	2026-09-18 15:49:54.836640618 +0000
@@ -0,0 +1,71 @@
+package io.github.warleysr.dechainer
+
+import io.github.warleysr.dechainer.data.RegretLog
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class RegretLogTest {
+
+    private fun rating(pkg: String, regretted: Boolean, seconds: Int = 120) =
+        RegretLog.Rating(pkg, System.currentTimeMillis(), regretted, seconds)
+
+    @Test
+    fun ratioIsComputedPerApp() {
+        val summaries = RegretLog.summarize(
+            listOf(
+                rating("com.social", true),
+                rating("com.social", true),
+                rating("com.social", false),
+                rating("com.useful", false),
+                rating("com.useful", false)
+            )
+        ).associateBy { it.packageName }
+
+        assertEquals(3, summaries["com.social"]!!.total)
+        assertEquals(2, summaries["com.social"]!!.regretted)
+        assertEquals(2f / 3f, summaries["com.social"]!!.regretRatio, 0.001f)
+        assertEquals(0f, summaries["com.useful"]!!.regretRatio, 0.001f)
+    }
+
+    @Test
+    fun appsWithTooLittleDataGiveNoVerdict() {
+        val single = RegretLog.summarize(listOf(rating("com.new", true))).first()
+        // One bad session shouldn't brand an app as regretted.
+        assertFalse(single.hasEnoughData)
+        assertTrue(RegretLog.suggestedForBlocking(listOf(rating("com.new", true))).isEmpty())
+    }
+
+    @Test
+    fun consistentlyRegrettedAppsAreSuggested() {
+        val ratings = listOf(
+            rating("com.social", true), rating("com.social", true),
+            rating("com.social", true), rating("com.social", false),
+            rating("com.useful", false), rating("com.useful", false), rating("com.useful", false)
+        )
+        val suggested = RegretLog.suggestedForBlocking(ratings).map { it.packageName }
+        assertEquals(listOf("com.social"), suggested)
+    }
+
+    @Test
+    fun regrettedTimeOnlyCountsRegrettedSessions() {
+        val summary = RegretLog.summarize(
+            listOf(
+                rating("com.social", true, seconds = 600),
+                rating("com.social", false, seconds = 300),
+                rating("com.social", true, seconds = 900)
+            )
+        ).first()
+        assertEquals(1500, summary.regrettedSeconds)
+    }
+
+    @Test
+    fun mostRegrettedAppsSortFirst() {
+        val ratings = listOf(
+            rating("com.mild", true), rating("com.mild", false), rating("com.mild", false),
+            rating("com.bad", true), rating("com.bad", true), rating("com.bad", true)
+        )
+        assertEquals("com.bad", RegretLog.summarize(ratings).first().packageName)
+    }
+}
