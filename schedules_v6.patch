+++ dechainer-main/app/src/main/java/io/github/warleysr/dechainer/data/PetCompanion.kt	2026-09-18 15:48:48.129855233 +0000
@@ -0,0 +1,91 @@
+package io.github.warleysr.dechainer.data
+
+import android.content.Context
+import androidx.core.content.edit
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+
+/**
+ * A small, entirely local mood tracker. The companion's health reflects how consistently the
+ * person has kept protections in place — not daily usage, not time limits, not anything that
+ * happens just from the app doing its normal job.
+ *
+ * Damage is **graded, not all-or-nothing**: a slip costs [DAMAGE_LEVELS] levels from wherever
+ * health currently is, rather than resetting to zero. All-or-nothing streaks are the main reason
+ * people abandon this kind of system entirely — one slip makes the streak worthless, so the whole
+ * thing gets uninstalled. Here, someone who was thriving drops to "under the weather" and can be
+ * back within days, while someone slipping repeatedly still bottoms out.
+ *
+ * Recovery stays deliberately slower than damage: [RECOVERY_DAYS_PER_LEVEL] clean days per level,
+ * so one good day doesn't erase one bad night. [healthLevel] and [daysUntilNextLevel] are pure
+ * functions of a stored (baseline level, date) pair, so they're unit-testable without Android.
+ */
+object PetCompanion {
+    const val MAX_LEVEL = 4
+    const val RECOVERY_DAYS_PER_LEVEL = 2
+
+    /** Levels lost per slip. Less than MAX_LEVEL on purpose — see the class doc. */
+    const val DAMAGE_LEVELS = 2
+
+    private const val PREFS_NAME = "pet_companion"
+    private const val KEY_LAST_BAD_EVENT = "last_bad_event_date"
+    private const val KEY_BASELINE_LEVEL = "baseline_level"
+    private const val KEY_BAD_EVENT_COUNT = "bad_event_count"
+    private const val KEY_NAME = "pet_name"
+    private const val DEFAULT_NAME = "Buddy"
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    fun getName(context: Context): String = prefs(context).getString(KEY_NAME, null) ?: DEFAULT_NAME
+
+    fun setName(context: Context, name: String) {
+        val clean = name.trim().take(20).ifBlank { DEFAULT_NAME }
+        prefs(context).edit(commit = true) { putString(KEY_NAME, clean) }
+    }
+
+    fun lastBadEventDate(context: Context): LocalDate? =
+        prefs(context).getString(KEY_LAST_BAD_EVENT, null)?.let { runCatching { LocalDate.parse(it) }.getOrNull() }
+
+    fun badEventCount(context: Context): Int = prefs(context).getInt(KEY_BAD_EVENT_COUNT, 0)
+
+    /** The level health fell to at the last slip; full health if there has never been one. */
+    fun baselineLevel(context: Context): Int = prefs(context).getInt(KEY_BASELINE_LEVEL, MAX_LEVEL)
+
+    /** 0 (very sick) to [MAX_LEVEL] (thriving). Pure function — see the class doc. */
+    fun healthLevel(baselineLevel: Int, lastBadEventDate: LocalDate?, today: LocalDate = LocalDate.now()): Int {
+        if (lastBadEventDate == null) return MAX_LEVEL
+        val cleanDays = ChronoUnit.DAYS.between(lastBadEventDate, today).toInt().coerceAtLeast(0)
+        return (baselineLevel + cleanDays / RECOVERY_DAYS_PER_LEVEL).coerceIn(0, MAX_LEVEL)
+    }
+
+    /** How many more full days of no slips until health climbs one more level, or 0 if already at max. */
+    fun daysUntilNextLevel(baselineLevel: Int, lastBadEventDate: LocalDate?, today: LocalDate = LocalDate.now()): Int {
+        if (lastBadEventDate == null) return 0
+        val level = healthLevel(baselineLevel, lastBadEventDate, today)
+        if (level >= MAX_LEVEL) return 0
+        val cleanDays = ChronoUnit.DAYS.between(lastBadEventDate, today).toInt().coerceAtLeast(0)
+        val daysNeededForNext = (level - baselineLevel + 1) * RECOVERY_DAYS_PER_LEVEL
+        return (daysNeededForNext - cleanDays).coerceAtLeast(1)
+    }
+
+    fun currentHealthLevel(context: Context): Int =
+        healthLevel(baselineLevel(context), lastBadEventDate(context))
+
+    fun currentDaysUntilNextLevel(context: Context): Int =
+        daysUntilNextLevel(baselineLevel(context), lastBadEventDate(context))
+
+    /**
+     * Records that a protection was just loosened: health drops [DAMAGE_LEVELS] from *current*
+     * health (not to zero), and recovery restarts from today at that new baseline.
+     */
+    fun registerBadEvent(context: Context, today: LocalDate = LocalDate.now()) {
+        val p = prefs(context)
+        val newBaseline = (currentHealthLevel(context) - DAMAGE_LEVELS).coerceAtLeast(0)
+        p.edit(commit = true) {
+            putString(KEY_LAST_BAD_EVENT, today.toString())
+            putInt(KEY_BASELINE_LEVEL, newBaseline)
+            putInt(KEY_BAD_EVENT_COUNT, p.getInt(KEY_BAD_EVENT_COUNT, 0) + 1)
+        }
+    }
+}
diff -ruN -x '*.tflite' -x .github dechainer-orig/app/src/main/java/io/github/warleysr/dechainer/data/RegretLog.kt dechainer-main/app/src/main/java/io/github/warleysr/dechainer/data/RegretLog.kt
--- dechainer-orig/app/src/main/java/io/github/warleysr/dechainer/data/RegretLog.kt	1970-01-01 00:00:00.000000000 +0000
+++ dechainer-main/app/src/main/java/io/github/warleysr/dechainer/data/RegretLog.kt	2026-09-18 15:49:38.653385512 +0000
@@ -0,0 +1,115 @@
+package io.github.warleysr.dechainer.data
+
+import android.content.Context
+import androidx.core.content.edit
+import org.json.JSONArray
+import org.json.JSONObject
+
+/**
+ * "Was that worth it?" — a one-tap rating asked occasionally after a session of a tracked app
+ * ends. Usage minutes alone don't distinguish an hour that felt fine from twenty minutes that felt
+ * awful; this does, and the answer is the thing worth acting on.
+ *
+ * Sampling matters as much as storage here: asking after *every* session would train the person to
+ * dismiss it without reading, so [shouldAsk] enforces a minimum gap and a minimum session length.
+ * All aggregation is pure functions over stored ratings, so it's unit-testable without Android.
+ */
+object RegretLog {
+    private const val PREFS_NAME = "regret_log"
+    private const val KEY_RATINGS = "ratings_json"
+    private const val KEY_LAST_ASKED = "last_asked_millis"
+
+    /** Don't interrupt more than once every two hours. */
+    const val MIN_GAP_MILLIS = 2 * 60 * 60 * 1000L
+
+    /** Sessions shorter than this aren't worth asking about. */
+    const val MIN_SESSION_SECONDS = 60
+
+    /** Below this many ratings for an app, don't draw conclusions from the ratio yet. */
+    const val MIN_RATINGS_FOR_VERDICT = 3
+
+    data class Rating(val packageName: String, val timestampMillis: Long, val regretted: Boolean, val seconds: Int)
+
+    data class AppSummary(
+        val packageName: String,
+        val total: Int,
+        val regretted: Int,
+        val regrettedSeconds: Int
+    ) {
+        /** 0f..1f. Only meaningful once [total] >= [MIN_RATINGS_FOR_VERDICT]. */
+        val regretRatio: Float get() = if (total == 0) 0f else regretted.toFloat() / total
+        val hasEnoughData: Boolean get() = total >= MIN_RATINGS_FOR_VERDICT
+    }
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    /**
+     * Whether to ask after a session of [seconds] that just ended. Kept as a pure-ish check so the
+     * accessibility service can call it cheaply on every session end.
+     */
+    fun shouldAsk(context: Context, seconds: Int, now: Long = System.currentTimeMillis()): Boolean {
+        if (seconds < MIN_SESSION_SECONDS) return false
+        val lastAsked = prefs(context).getLong(KEY_LAST_ASKED, 0L)
+        return now - lastAsked >= MIN_GAP_MILLIS
+    }
+
+    fun markAsked(context: Context, now: Long = System.currentTimeMillis()) {
+        prefs(context).edit(commit = true) { putLong(KEY_LAST_ASKED, now) }
+    }
+
+    fun getRatings(context: Context): List<Rating> {
+        val json = prefs(context).getString(KEY_RATINGS, null) ?: return emptyList()
+        return try {
+            val array = JSONArray(json)
+            (0 until array.length()).map { i ->
+                val o = array.getJSONObject(i)
+                Rating(o.getString("pkg"), o.getLong("ts"), o.getBoolean("regret"), o.optInt("secs", 0))
+            }
+        } catch (e: Exception) {
+            emptyList()
+        }
+    }
+
+    fun addRating(context: Context, packageName: String, regretted: Boolean, seconds: Int) {
+        val kept = (getRatings(context) + Rating(packageName, System.currentTimeMillis(), regretted, seconds))
+            .sortedByDescending { it.timestampMillis }
+            .take(500)
+        val array = JSONArray()
+        kept.forEach { r ->
+            array.put(
+                JSONObject().apply {
+                    put("pkg", r.packageName)
+                    put("ts", r.timestampMillis)
+                    put("regret", r.regretted)
+                    put("secs", r.seconds)
+                }
+            )
+        }
+        prefs(context).edit(commit = true) { putString(KEY_RATINGS, array.toString()) }
+    }
+
+    fun clearAll(context: Context) {
+        prefs(context).edit(commit = true) { remove(KEY_RATINGS) }
+    }
+
+    /** Per-app totals, most-regretted first. Pure function — see the class doc. */
+    fun summarize(ratings: List<Rating>): List<AppSummary> =
+        ratings.groupBy { it.packageName }
+            .map { (pkg, list) ->
+                AppSummary(
+                    packageName = pkg,
+                    total = list.size,
+                    regretted = list.count { it.regretted },
+                    regrettedSeconds = list.filter { it.regretted }.sumOf { it.seconds }
+                )
+            }
+            .sortedWith(compareByDescending<AppSummary> { it.hasEnoughData }.thenByDescending { it.regretRatio })
+
+    /**
+     * Apps worth suggesting for a schedule: enough data, and regretted more often than not.
+     * Deliberately a suggestion only — nothing is blocked automatically off the back of a tap.
+     */
+    fun suggestedForBlocking(ratings: List<Rating>, threshold: Float = 0.6f): List<AppSummary> =
+        summarize(ratings).filter { it.hasEnoughData && it.regretRatio >= threshold }
+}
