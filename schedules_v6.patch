+package io.github.warleysr.dechainer.screens.common
+
+import androidx.compose.animation.core.animateFloatAsState
+import androidx.compose.foundation.Canvas
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.size
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.StrokeCap
+import androidx.compose.ui.graphics.drawscope.Stroke
+import androidx.compose.ui.unit.Dp
+import androidx.compose.ui.unit.dp
+import io.github.warleysr.dechainer.data.PetCompanion
+import kotlin.math.min
+
+/**
+ * Draws the companion as a simple round blob whose color, eye shape and mouth curve change with
+ * [healthLevel] (0 = very sick, [PetCompanion.MAX_LEVEL] = thriving). Pure Canvas drawing — no
+ * bitmap assets, so nothing binary needs to ship in this patch.
+ */
+@Composable
+fun PetView(healthLevel: Int, modifier: Modifier = Modifier, size: Dp = 96.dp) {
+    val level = healthLevel.coerceIn(0, PetCompanion.MAX_LEVEL)
+    val bodyColor = petColorForLevel(level)
+    val bounce by animateFloatAsState(targetValue = if (level >= 3) 1f else 0f, label = "pet_bounce")
+
+    Box(modifier = modifier.size(size)) {
+        Canvas(modifier = Modifier.size(size)) {
+            val w = this.size.width
+            val h = this.size.height
+            val r = min(w, h) / 2f * 0.88f
+            val cx = w / 2f
+            // A happy, healthy pet sits a touch higher; a sick one droops toward the bottom.
+            val cy = h / 2f + (1f - bounce) * (h * 0.04f)
+
+            // Body
+            drawCircle(color = bodyColor, radius = r, center = Offset(cx, cy))
+
+            // Eyes: bright round dots when healthy, drooping half-lidded lines when sick.
+            val eyeOffsetX = r * 0.35f
+            val eyeOffsetY = -r * 0.15f
+            val eyeY = cy + eyeOffsetY
+            if (level >= 2) {
+                val eyeR = r * 0.09f
+                drawCircle(Color.Black, eyeR, Offset(cx - eyeOffsetX, eyeY))
+                drawCircle(Color.Black, eyeR, Offset(cx + eyeOffsetX, eyeY))
+                if (level == PetCompanion.MAX_LEVEL) {
+                    // A little shine when thriving.
+                    val shineR = eyeR * 0.35f
+                    drawCircle(Color.White, shineR, Offset(cx - eyeOffsetX + shineR, eyeY - shineR))
+                    drawCircle(Color.White, shineR, Offset(cx + eyeOffsetX + shineR, eyeY - shineR))
+                }
+            } else {
+                // Very sick / sick: droopy closed-eye lines instead of dots.
+                val eyeLen = r * 0.16f
+                val droop = if (level == 0) r * 0.08f else r * 0.03f
+                drawLine(
+                    Color.Black,
+                    Offset(cx - eyeOffsetX - eyeLen / 2, eyeY),
+                    Offset(cx - eyeOffsetX + eyeLen / 2, eyeY + droop),
+                    strokeWidth = r * 0.05f,
+                    cap = StrokeCap.Round
+                )
+                drawLine(
+                    Color.Black,
+                    Offset(cx + eyeOffsetX - eyeLen / 2, eyeY),
+                    Offset(cx + eyeOffsetX + eyeLen / 2, eyeY + droop),
+                    strokeWidth = r * 0.05f,
+                    cap = StrokeCap.Round
+                )
+            }
+
+            // Mouth: a smile that flattens and then frowns as health drops.
+            val mouthWidth = r * 0.55f
+            val mouthY = cy + r * 0.35f
+            // curveDepth: positive = smile, negative = frown, scaled by level (0..MAX_LEVEL -> -1..1).
+            val curveDepth = (level.toFloat() / PetCompanion.MAX_LEVEL - 0.35f) * r * 0.5f
+            val path = androidx.compose.ui.graphics.Path().apply {
+                moveTo(cx - mouthWidth / 2, mouthY)
+                quadraticBezierTo(cx, mouthY + curveDepth, cx + mouthWidth / 2, mouthY)
+            }
+            drawPath(path, color = Color.Black, style = Stroke(width = r * 0.06f, cap = StrokeCap.Round))
+        }
+    }
+}
+
+@Composable
+private fun petColorForLevel(level: Int): Color = when (level) {
+    0 -> Color(0xFF8D6E63) // very sick: dull, sickly brown-grey
+    1 -> Color(0xFFA1887F) // sick: pale, washed out
+    2 -> Color(0xFFAED581) // under the weather: muted yellow-green
+    3 -> Color(0xFF81C784) // okay: healthy green
+    else -> MaterialTheme.colorScheme.primary // thriving: the app's own accent color
+}
+
+/** Short label for the current level, used next to [PetView] wherever it's shown. */
+fun petMoodLabelRes(level: Int): Int = when (level.coerceIn(0, PetCompanion.MAX_LEVEL)) {
+    0 -> io.github.warleysr.dechainer.R.string.pet_mood_very_sick
+    1 -> io.github.warleysr.dechainer.R.string.pet_mood_sick
+    2 -> io.github.warleysr.dechainer.R.string.pet_mood_under_weather
+    3 -> io.github.warleysr.dechainer.R.string.pet_mood_okay
+    else -> io.github.warleysr.dechainer.R.string.pet_mood_thriving
+}
