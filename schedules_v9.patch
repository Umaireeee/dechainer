+++ main120/app/src/main/java/io/github/warleysr/dechainer/data/PetCompanion.kt	2026-09-19 12:51:05.064109140 +0000
@@ -0,0 +1,150 @@
+package io.github.warleysr.dechainer.data
+
+import android.content.Context
+import androidx.core.content.edit
+import io.github.warleysr.dechainer.screens.common.PetArt
+import io.github.warleysr.dechainer.widget.PetWidgetProvider
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+
+/**
+ * A small, entirely local mood tracker. The companion's health reflects how consistently the
+ * person has kept protections in place — not daily usage, not time limits, not anything that
+ * happens just from the app doing its normal job.
+ *
+ * Damage is **graded, not all-or-nothing**: a slip costs [DAMAGE_LEVELS] levels from wherever
+ * health currently is, rather than resetting to zero. All-or-nothing streaks are the main reason
+ * people abandon this kind of system entirely — one slip makes the streak worthless, so the whole
+ * thing gets uninstalled. Here, someone who was thriving drops to "under the weather" and can be
+ * back within days, while someone slipping repeatedly still bottoms out.
+ *
+ * Recovery stays deliberately slower than damage: [RECOVERY_DAYS_PER_LEVEL] clean days per level,
+ * so one good day doesn't erase one bad night. [healthLevel], [daysUntilNextLevel], [cleanDays]
+ * and [accessoryFor] are pure functions of stored values, so they're unit-testable without Android.
+ */
+object PetCompanion {
+    const val MAX_LEVEL = 4
+    const val RECOVERY_DAYS_PER_LEVEL = 2
+
+    /** Levels lost per slip. Less than MAX_LEVEL on purpose — see the class doc. */
+    const val DAMAGE_LEVELS = 2
+
+    /** Clean-day counts at which the pet earns a visible decoration. */
+    const val MILESTONE_SPROUT = 3
+    const val MILESTONE_FLOWER = 7
+    const val MILESTONE_CROWN = 30
+
+    private const val PREFS_NAME = "pet_companion"
+    private const val KEY_LAST_BAD_EVENT = "last_bad_event_date"
+    private const val KEY_BASELINE_LEVEL = "baseline_level"
+    private const val KEY_BAD_EVENT_COUNT = "bad_event_count"
+    private const val KEY_NAME = "pet_name"
+    private const val KEY_FIRST_SEEN = "first_seen_date"
+    private const val KEY_BEST_STREAK = "best_streak"
+    private const val DEFAULT_NAME = "Buddy"
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    fun getName(context: Context): String = prefs(context).getString(KEY_NAME, null) ?: DEFAULT_NAME
+
+    fun setName(context: Context, name: String) {
+        val clean = name.trim().take(20).ifBlank { DEFAULT_NAME }
+        prefs(context).edit(commit = true) { putString(KEY_NAME, clean) }
+        PetWidgetProvider.refresh(context)
+    }
+
+    fun lastBadEventDate(context: Context): LocalDate? =
+        prefs(context).getString(KEY_LAST_BAD_EVENT, null)?.let { runCatching { LocalDate.parse(it) }.getOrNull() }
+
+    fun badEventCount(context: Context): Int = prefs(context).getInt(KEY_BAD_EVENT_COUNT, 0)
+
+    /** The level health fell to at the last slip; full health if there has never been one. */
+    fun baselineLevel(context: Context): Int = prefs(context).getInt(KEY_BASELINE_LEVEL, MAX_LEVEL)
+
+    /**
+     * The day counting started for someone who has never slipped. Recorded the first time the
+     * companion is looked at, so a brand-new install doesn't claim a streak it hasn't earned.
+     */
+    fun firstSeenDate(context: Context, today: LocalDate = LocalDate.now()): LocalDate {
+        val p = prefs(context)
+        val stored = p.getString(KEY_FIRST_SEEN, null)?.let { runCatching { LocalDate.parse(it) }.getOrNull() }
+        if (stored != null) return stored
+        p.edit(commit = true) { putString(KEY_FIRST_SEEN, today.toString()) }
+        return today
+    }
+
+    /** 0 (very sick) to [MAX_LEVEL] (thriving). Pure function — see the class doc. */
+    fun healthLevel(baselineLevel: Int, lastBadEventDate: LocalDate?, today: LocalDate = LocalDate.now()): Int {
+        if (lastBadEventDate == null) return MAX_LEVEL
+        val cleanDays = ChronoUnit.DAYS.between(lastBadEventDate, today).toInt().coerceAtLeast(0)
+        return (baselineLevel + cleanDays / RECOVERY_DAYS_PER_LEVEL).coerceIn(0, MAX_LEVEL)
+    }
+
+    /** How many more full days of no slips until health climbs one more level, or 0 if already at max. */
+    fun daysUntilNextLevel(baselineLevel: Int, lastBadEventDate: LocalDate?, today: LocalDate = LocalDate.now()): Int {
+        if (lastBadEventDate == null) return 0
+        val level = healthLevel(baselineLevel, lastBadEventDate, today)
+        if (level >= MAX_LEVEL) return 0
+        val cleanDays = ChronoUnit.DAYS.between(lastBadEventDate, today).toInt().coerceAtLeast(0)
+        val daysNeededForNext = (level - baselineLevel + 1) * RECOVERY_DAYS_PER_LEVEL
+        return (daysNeededForNext - cleanDays).coerceAtLeast(1)
+    }
+
+    /** Whole days since the last slip, counting from [since] when there has never been one. */
+    fun cleanDays(lastBadEventDate: LocalDate?, since: LocalDate, today: LocalDate = LocalDate.now()): Int =
+        ChronoUnit.DAYS.between(lastBadEventDate ?: since, today).toInt().coerceAtLeast(0)
+
+    /** Which decoration a streak of [cleanDays] has earned. Pure — see the class doc. */
+    fun accessoryFor(cleanDays: Int): Int = when {
+        cleanDays >= MILESTONE_CROWN -> PetArt.ACCESSORY_CROWN
+        cleanDays >= MILESTONE_FLOWER -> PetArt.ACCESSORY_FLOWER
+        cleanDays >= MILESTONE_SPROUT -> PetArt.ACCESSORY_SPROUT
+        else -> PetArt.ACCESSORY_NONE
+    }
+
+    /** Clean days remaining until the next decoration, or 0 once every milestone is earned. */
+    fun daysUntilNextMilestone(cleanDays: Int): Int = when {
+        cleanDays < MILESTONE_SPROUT -> MILESTONE_SPROUT - cleanDays
+        cleanDays < MILESTONE_FLOWER -> MILESTONE_FLOWER - cleanDays
+        cleanDays < MILESTONE_CROWN -> MILESTONE_CROWN - cleanDays
+        else -> 0
+    }
+
+    fun currentHealthLevel(context: Context): Int =
+        healthLevel(baselineLevel(context), lastBadEventDate(context))
+
+    fun currentDaysUntilNextLevel(context: Context): Int =
+        daysUntilNextLevel(baselineLevel(context), lastBadEventDate(context))
+
+    fun currentCleanDays(context: Context): Int {
+        val today = LocalDate.now()
+        val days = cleanDays(lastBadEventDate(context), firstSeenDate(context, today), today)
+        val p = prefs(context)
+        if (days > p.getInt(KEY_BEST_STREAK, 0)) {
+            p.edit(commit = true) { putInt(KEY_BEST_STREAK, days) }
+        }
+        return days
+    }
+
+    fun bestCleanDays(context: Context): Int = prefs(context).getInt(KEY_BEST_STREAK, 0)
+
+    fun currentAccessory(context: Context): Int = accessoryFor(currentCleanDays(context))
+
+    /**
+     * Records that a protection was just loosened: health drops [DAMAGE_LEVELS] from *current*
+     * health (not to zero), and recovery restarts from today at that new baseline.
+     */
+    fun registerBadEvent(context: Context, today: LocalDate = LocalDate.now()) {
+        val p = prefs(context)
+        val newBaseline = (currentHealthLevel(context) - DAMAGE_LEVELS).coerceAtLeast(0)
+        p.edit(commit = true) {
+            putString(KEY_LAST_BAD_EVENT, today.toString())
+            putInt(KEY_BASELINE_LEVEL, newBaseline)
+            putInt(KEY_BAD_EVENT_COUNT, p.getInt(KEY_BAD_EVENT_COUNT, 0) + 1)
+        }
+        // The widget is the whole point of the companion for most people: it has to show the drop
+        // immediately, not at the next 30-minute refresh.
+        PetWidgetProvider.refresh(context)
+    }
+}
