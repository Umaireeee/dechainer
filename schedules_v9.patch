+/**
+ * Shows the companion's current state and the confession log. Everything here is read-only except
+ * renaming and deleting — deleting a recording is gated behind the recovery code, so a bad-night
+ * self can't quietly wipe the evidence before bypassing something.
+ */
+@Composable
+fun CompanionScreen() {
+    val context = LocalContext.current
+    val recoveryGate = rememberRecoveryGate()
+    val player = remember { VoicePlayer() }
+    DisposableEffect(Unit) { onDispose { player.stop() } }
+
+    var petName by remember { mutableStateOf(PetCompanion.getName(context)) }
+    var entries by remember { mutableStateOf(ConfessionLog.getEntries(context)) }
+    var playingId by remember { mutableStateOf<String?>(null) }
+    var pendingDelete by remember { mutableStateOf<ConfessionLog.Entry?>(null) }
+    var showRename by remember { mutableStateOf(false) }
+    // Bumped when the pet is tapped, purely so the "you petted me" line can react.
+    var pets by remember { mutableStateOf(0) }
+
+    val healthLevel = remember(entries) { PetCompanion.currentHealthLevel(context) }
+    val daysUntilNext = remember(entries) { PetCompanion.currentDaysUntilNextLevel(context) }
+    val badEvents = remember(entries) { PetCompanion.badEventCount(context) }
+    val cleanDays = remember(entries) { PetCompanion.currentCleanDays(context) }
+    val bestDays = remember(entries) { PetCompanion.bestCleanDays(context) }
+    val accessory = remember(cleanDays) { PetCompanion.accessoryFor(cleanDays) }
+    val daysToMilestone = remember(cleanDays) { PetCompanion.daysUntilNextMilestone(cleanDays) }
+    val dateFormat = remember { DateFormat.getDateTimeInstance(DateFormat.MEDIUM, DateFormat.SHORT) }
+
+    LazyColumn(modifier = Modifier.fillMaxSize()) {
+        item {
+            HeroCard(
+                petName = petName,
+                healthLevel = healthLevel,
+                accessory = accessory,
+                cleanDays = cleanDays,
+                bestDays = bestDays,
+                badEvents = badEvents,
+                daysUntilNext = daysUntilNext,
+                daysToMilestone = daysToMilestone,
+                petted = pets > 0,
+                onRename = { showRename = true },
+                onPetted = { pets += 1 }
+            )
+        }
+
+        item {
+            Text(
+                stringResource(R.string.confession_log),
+                style = MaterialTheme.typography.titleMedium,
+                fontWeight = FontWeight.Bold,
+                modifier = Modifier.padding(start = 16.dp, end = 16.dp, top = 8.dp)
+            )
+            Text(
+                stringResource(R.string.confession_log_desc),
+                style = MaterialTheme.typography.bodySmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                modifier = Modifier.padding(horizontal = 16.dp, vertical = 4.dp)
+            )
+        }
+
+        if (entries.isEmpty()) {
+            item {
+                Text(
+                    stringResource(R.string.confession_log_empty),
+                    style = MaterialTheme.typography.bodyMedium,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    modifier = Modifier.padding(24.dp)
+                )
+            }
+        }
+
+        items(entries, key = { it.id }) { entry ->
+            val hasAudio = remember(entry.id, playingId) { ConfessionLog.audioFile(context, entry.id).exists() }
+            Card(
+                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceVariant),
+                shape = RoundedCornerShape(18.dp),
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .padding(horizontal = 16.dp, vertical = 5.dp)
+            ) {
+                Row(
+                    verticalAlignment = Alignment.CenterVertically,
+                    modifier = Modifier.padding(8.dp)
+                ) {
+                    IconButton(
+                        enabled = hasAudio,
+                        onClick = {
+                            if (playingId == entry.id) {
+                                player.stop()
+                                playingId = null
+                            } else {
+                                val file = ConfessionLog.audioFile(context, entry.id)
+                                if (file.exists()) {
+                                    playingId = entry.id
+                                    player.play(file) { playingId = null }
+                                }
+                            }
+                        }
+                    ) {
+                        Icon(
+                            if (playingId == entry.id) Icons.Outlined.Stop else Icons.Outlined.PlayArrow,
+                            contentDescription = null
+                        )
+                    }
+                    Column(modifier = Modifier.weight(1f)) {
+                        Text(entry.label, style = MaterialTheme.typography.bodyMedium, fontWeight = FontWeight.Medium)
+                        Text(
+                            if (hasAudio) dateFormat.format(Date(entry.timestampMillis))
+                            else stringResource(R.string.confession_no_audio),
+                            style = MaterialTheme.typography.bodySmall,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant
+                        )
+                    }
+                    IconButton(onClick = { pendingDelete = entry }) {
+                        Icon(Icons.Outlined.Delete, contentDescription = null)
+                    }
+                }
+            }
+        }
+
+        item { Spacer(Modifier.height(24.dp)) }
+    }
+
+    if (showRename) {
+        var draftName by remember { mutableStateOf(petName) }
+        AlertDialog(
+            onDismissRequest = { showRename = false },
+            title = { Text(stringResource(R.string.pet_name_label)) },
+            text = {
+                OutlinedTextField(
+                    value = draftName,
+                    onValueChange = { draftName = it.take(20) },
+                    singleLine = true,
+                    modifier = Modifier.fillMaxWidth()
+                )
+            },
+            confirmButton = {
+                TextButton(onClick = {
+                    PetCompanion.setName(context, draftName)
+                    petName = PetCompanion.getName(context)
+                    showRename = false
+                }) { Text(stringResource(R.string.confirm)) }
+            },
+            dismissButton = {
+                TextButton(onClick = { showRename = false }) { Text(stringResource(R.string.cancel)) }
+            }
+        )
+    }
+
+    pendingDelete?.let { entry ->
+        AlertDialog(
+            onDismissRequest = { pendingDelete = null },
+            title = { Text(stringResource(R.string.confession_delete_title)) },
+            text = { Text(stringResource(R.string.confession_delete_text)) },
+            confirmButton = {
+                TextButton(onClick = {
+                    val target = entry
+                    pendingDelete = null
+                    // Gated: deleting a past confession is exactly the kind of thing a craving
+                    // would want to do first.
+                    recoveryGate.run {
+                        if (playingId == target.id) {
+                            player.stop()
+                            playingId = null
+                        }
+                        ConfessionLog.delete(context, target.id)
+                        entries = ConfessionLog.getEntries(context)
+                    }
+                }) { Text(stringResource(R.string.confirm)) }
+            },
+            dismissButton = {
+                TextButton(onClick = { pendingDelete = null }) { Text(stringResource(R.string.cancel)) }
+            }
+        )
+    }
+
+    RecoveryGateDialog(recoveryGate)
+}
+
+@Composable
+private fun HeroCard(
+    petName: String,
+    healthLevel: Int,
+    accessory: Int,
+    cleanDays: Int,
+    bestDays: Int,
+    badEvents: Int,
+    daysUntilNext: Int,
+    daysToMilestone: Int,
+    petted: Boolean,
+    onRename: () -> Unit,
+    onPetted: () -> Unit
+) {
+    val scheme = MaterialTheme.colorScheme
+    // The card's own wash shifts with mood, so the screen feels different when things are going
+    // badly without needing a single extra word of text.
+    val tint = when (healthLevel) {
+        0, 1 -> scheme.errorContainer
+        2 -> scheme.tertiaryContainer
+        else -> scheme.primaryContainer
+    }
+
+    Card(
+        shape = RoundedCornerShape(28.dp),
+        colors = CardDefaults.cardColors(containerColor = Color.Transparent),
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(16.dp)
+    ) {
+        Column(
+            horizontalAlignment = Alignment.CenterHorizontally,
+            modifier = Modifier
+                .fillMaxWidth()
+                .background(
+                    Brush.verticalGradient(listOf(tint, scheme.surface))
+                )
+                .padding(vertical = 24.dp, horizontal = 20.dp)
+        ) {
+            PetView(
+                healthLevel = healthLevel,
+                size = 156.dp,
+                accessory = accessory,
+                interactive = true,
+                onPetted = onPetted
+            )
+
+            Spacer(Modifier.height(8.dp))
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Text(petName, style = MaterialTheme.typography.headlineSmall, fontWeight = FontWeight.Bold)
+                IconButton(onClick = onRename) {
+                    Icon(Icons.Outlined.Edit, contentDescription = stringResource(R.string.pet_name_label))
+                }
+            }
+            Text(
+                stringResource(petMoodLabelRes(healthLevel)),
+                style = MaterialTheme.typography.titleMedium,
+                color = scheme.primary
+            )
+            Text(
+                if (petted) stringResource(R.string.pet_petted)
+                else stringResource(R.string.pet_tap_hint),
+                style = MaterialTheme.typography.bodySmall,
+                color = scheme.onSurfaceVariant,
+                textAlign = TextAlign.Center
+            )
+
+            Spacer(Modifier.height(16.dp))
+            HealthPips(healthLevel)
+
+            Spacer(Modifier.height(8.dp))
+            Text(
+                if (daysUntilNext > 0) stringResource(R.string.pet_days_until_next, daysUntilNext)
+                else stringResource(R.string.pet_fully_healthy),
+                style = MaterialTheme.typography.bodyMedium,
+                color = scheme.onSurfaceVariant,
+                textAlign = TextAlign.Center
+            )
+
+            Spacer(Modifier.height(20.dp))
+            Row(
+                horizontalArrangement = Arrangement.spacedBy(10.dp),
+                modifier = Modifier.fillMaxWidth()
+            ) {
+                StatTile(cleanDays.toString(), stringResource(R.string.pet_stat_clean_days), Modifier.weight(1f))
+                StatTile(bestDays.toString(), stringResource(R.string.pet_stat_best), Modifier.weight(1f))
+                StatTile(badEvents.toString(), stringResource(R.string.pet_stat_slips), Modifier.weight(1f))
+            }
+
+            Spacer(Modifier.height(14.dp))
+            Text(
+                when {
+                    daysToMilestone > 0 -> stringResource(
+                        R.string.pet_next_milestone,
+                        daysToMilestone,
+                        stringResource(milestoneNameRes(nextAccessoryAfter(accessory)))
+                    )
+                    else -> stringResource(R.string.pet_all_milestones)
+                },
+                style = MaterialTheme.typography.bodySmall,
+                color = scheme.onSurfaceVariant,
+                textAlign = TextAlign.Center
+            )
+        }
+    }
+}
+
+/** Five segments instead of a progress bar: discrete health reads as a state, not a loading spinner. */
+@Composable
+private fun HealthPips(level: Int) {
+    Row(horizontalArrangement = Arrangement.spacedBy(6.dp)) {
+        for (i in 0..PetCompanion.MAX_LEVEL) {
+            val filled = i <= level
+            val alpha by animateFloatAsState(if (filled) 1f else 0.18f, label = "pip_$i")
+            Spacer(
+                Modifier
+                    .size(width = 34.dp, height = 8.dp)
+                    .clip(RoundedCornerShape(4.dp))
+                    .background(MaterialTheme.colorScheme.primary.copy(alpha = alpha))
+            )
+        }
+    }
+}
+
+@Composable
+private fun StatTile(value: String, label: String, modifier: Modifier = Modifier) {
+    Column(
+        horizontalAlignment = Alignment.CenterHorizontally,
+        modifier = modifier
+            .clip(RoundedCornerShape(16.dp))
+            .background(MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.7f))
+            .padding(vertical = 12.dp)
+    ) {
+        Text(value, style = MaterialTheme.typography.titleLarge, fontWeight = FontWeight.Bold)
+        Text(
+            label,
+            style = MaterialTheme.typography.labelSmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            textAlign = TextAlign.Center
+        )
+    }
+}
+
+private fun nextAccessoryAfter(current: Int): Int = when (current) {
+    PetArt.ACCESSORY_NONE -> PetArt.ACCESSORY_SPROUT
+    PetArt.ACCESSORY_SPROUT -> PetArt.ACCESSORY_FLOWER
+    else -> PetArt.ACCESSORY_CROWN
+}
+
+private fun milestoneNameRes(accessory: Int): Int = when (accessory) {
+    PetArt.ACCESSORY_SPROUT -> R.string.pet_milestone_sprout
+    PetArt.ACCESSORY_FLOWER -> R.string.pet_milestone_flower
+    else -> R.string.pet_milestone_crown
+}
