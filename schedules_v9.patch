--- orig120/app/src/main/java/io/github/warleysr/dechainer/data/RegretLog.kt	1970-01-01 00:00:00.000000000 +0000
+++ main120/app/src/main/java/io/github/warleysr/dechainer/data/RegretLog.kt	2026-09-19 12:51:05.069004178 +0000
@@ -0,0 +1,115 @@
+package io.github.warleysr.dechainer.data
+
+import android.content.Context
+import androidx.core.content.edit
+import org.json.JSONArray
+import org.json.JSONObject
+
+/**
+ * "Was that worth it?" — a one-tap rating asked occasionally after a session of a tracked app
+ * ends. Usage minutes alone don't distinguish an hour that felt fine from twenty minutes that felt
+ * awful; this does, and the answer is the thing worth acting on.
+ *
+ * Sampling matters as much as storage here: asking after *every* session would train the person to
+ * dismiss it without reading, so [shouldAsk] enforces a minimum gap and a minimum session length.
+ * All aggregation is pure functions over stored ratings, so it's unit-testable without Android.
+ */
+object RegretLog {
+    private const val PREFS_NAME = "regret_log"
+    private const val KEY_RATINGS = "ratings_json"
+    private const val KEY_LAST_ASKED = "last_asked_millis"
+
+    /** Don't interrupt more than once every two hours. */
+    const val MIN_GAP_MILLIS = 2 * 60 * 60 * 1000L
+
+    /** Sessions shorter than this aren't worth asking about. */
+    const val MIN_SESSION_SECONDS = 60
+
+    /** Below this many ratings for an app, don't draw conclusions from the ratio yet. */
+    const val MIN_RATINGS_FOR_VERDICT = 3
+
+    data class Rating(val packageName: String, val timestampMillis: Long, val regretted: Boolean, val seconds: Int)
+
+    data class AppSummary(
+        val packageName: String,
+        val total: Int,
+        val regretted: Int,
+        val regrettedSeconds: Int
+    ) {
+        /** 0f..1f. Only meaningful once [total] >= [MIN_RATINGS_FOR_VERDICT]. */
+        val regretRatio: Float get() = if (total == 0) 0f else regretted.toFloat() / total
+        val hasEnoughData: Boolean get() = total >= MIN_RATINGS_FOR_VERDICT
+    }
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    /**
+     * Whether to ask after a session of [seconds] that just ended. Kept as a pure-ish check so the
+     * accessibility service can call it cheaply on every session end.
+     */
+    fun shouldAsk(context: Context, seconds: Int, now: Long = System.currentTimeMillis()): Boolean {
+        if (seconds < MIN_SESSION_SECONDS) return false
+        val lastAsked = prefs(context).getLong(KEY_LAST_ASKED, 0L)
+        return now - lastAsked >= MIN_GAP_MILLIS
+    }
+
+    fun markAsked(context: Context, now: Long = System.currentTimeMillis()) {
+        prefs(context).edit(commit = true) { putLong(KEY_LAST_ASKED, now) }
+    }
+
+    fun getRatings(context: Context): List<Rating> {
+        val json = prefs(context).getString(KEY_RATINGS, null) ?: return emptyList()
+        return try {
+            val array = JSONArray(json)
+            (0 until array.length()).map { i ->
+                val o = array.getJSONObject(i)
+                Rating(o.getString("pkg"), o.getLong("ts"), o.getBoolean("regret"), o.optInt("secs", 0))
+            }
+        } catch (e: Exception) {
+            emptyList()
+        }
+    }
+
+    fun addRating(context: Context, packageName: String, regretted: Boolean, seconds: Int) {
+        val kept = (getRatings(context) + Rating(packageName, System.currentTimeMillis(), regretted, seconds))
+            .sortedByDescending { it.timestampMillis }
+            .take(500)
+        val array = JSONArray()
+        kept.forEach { r ->
+            array.put(
+                JSONObject().apply {
+                    put("pkg", r.packageName)
+                    put("ts", r.timestampMillis)
+                    put("regret", r.regretted)
+                    put("secs", r.seconds)
+                }
+            )
+        }
+        prefs(context).edit(commit = true) { putString(KEY_RATINGS, array.toString()) }
+    }
+
+    fun clearAll(context: Context) {
+        prefs(context).edit(commit = true) { remove(KEY_RATINGS) }
+    }
+
+    /** Per-app totals, most-regretted first. Pure function — see the class doc. */
+    fun summarize(ratings: List<Rating>): List<AppSummary> =
+        ratings.groupBy { it.packageName }
+            .map { (pkg, list) ->
+                AppSummary(
+                    packageName = pkg,
+                    total = list.size,
+                    regretted = list.count { it.regretted },
+                    regrettedSeconds = list.filter { it.regretted }.sumOf { it.seconds }
+                )
+            }
+            .sortedWith(compareByDescending<AppSummary> { it.hasEnoughData }.thenByDescending { it.regretRatio })
+
+    /**
+     * Apps worth suggesting for a schedule: enough data, and regretted more often than not.
+     * Deliberately a suggestion only — nothing is blocked automatically off the back of a tap.
+     */
+    fun suggestedForBlocking(ratings: List<Rating>, threshold: Float = 0.6f): List<AppSummary> =
+        summarize(ratings).filter { it.hasEnoughData && it.regretRatio >= threshold }
+}
diff -ruN -x '*.tflite' -x .github -x .idea -x '*.patch' orig120/app/src/main/java/io/github/warleysr/dechainer/data/ScheduleEnforcer.kt main120/app/src/main/java/io/github/warleysr/dechainer/data/ScheduleEnforcer.kt
--- orig120/app/src/main/java/io/github/warleysr/dechainer/data/ScheduleEnforcer.kt	1970-01-01 00:00:00.000000000 +0000
+++ main120/app/src/main/java/io/github/warleysr/dechainer/data/ScheduleEnforcer.kt	2026-09-19 12:51:05.069108697 +0000
@@ -0,0 +1,330 @@
+package io.github.warleysr.dechainer.data
+
+import android.app.AlarmManager
+import android.app.PendingIntent
+import android.app.admin.DevicePolicyManager
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.Build
+import android.os.UserManager
+import android.telecom.TelecomManager
+import androidx.core.content.edit
+import io.github.warleysr.dechainer.DechainerDeviceAdminReceiver
+import io.github.warleysr.dechainer.ScheduleReceiver
+import io.github.warleysr.dechainer.models.BlockSchedule
+import io.github.warleysr.dechainer.security.SecurityManager
+import timber.log.Timber
+import java.time.ZonedDateTime
+
+/**
+ * Brings the device in line with the schedules that are open *right now*. Every call to [sync] is
+ * idempotent and computes the full desired state from scratch, so it is safe to call from anywhere
+ * and as often as needed: the alarm at each window boundary, boot, clock/time-zone changes, the
+ * accessibility service's periodic tick, and every edit made in the UI.
+ *
+ * Ownership: a package or restriction is only released at the end of a window if the schedule is
+ * the one that applied it. Anything that was already suspended/restricted before the window opened
+ * (a manual suspension, a permanent restriction) is left untouched when it closes.
+ */
+object ScheduleEnforcer {
+    private const val STATE_PREFS = "schedule_state"
+    private const val KEY_OWNED_APPS = "owned_apps"
+    private const val KEY_OWNED_RESTRICTIONS = "owned_restrictions"
+    private const val KEY_ACTIVE_SITES = "active_sites"
+
+    const val ACTION_BOUNDARY = "io.github.warleysr.dechainer.SCHEDULE_BOUNDARY"
+
+    /** Re-check at least this often even when no boundary is near, to self-heal after clock jumps. */
+    private const val MAX_CACHE_MS = 5 * 60 * 1000L
+
+    data class ActiveBlock(val scheduleName: String, val endsAtMillis: Long)
+
+    private val lock = Any()
+
+    @Volatile
+    private var activeBlocks: Map<String, ActiveBlock> = emptyMap()
+
+    @Volatile
+    private var cacheValidUntil = 0L
+
+    private fun state(context: Context) =
+        context.applicationContext.getSharedPreferences(STATE_PREFS, Context.MODE_PRIVATE)
+
+    fun sync(context: Context) {
+        val ctx = context.applicationContext
+        synchronized(lock) {
+            try {
+                syncLocked(ctx)
+            } catch (e: Exception) {
+                Timber.e(e, "Schedule sync failed")
+                // Retry on the next app switch or tick instead of trusting a half-applied state.
+                cacheValidUntil = 0L
+            }
+        }
+    }
+
+    private fun syncLocked(ctx: Context) {
+        val dpm = ctx.getSystemService(Context.DEVICE_POLICY_SERVICE) as DevicePolicyManager
+        val admin = ComponentName(ctx, DechainerDeviceAdminReceiver::class.java)
+        val schedules = ScheduleRepository.getSchedules(ctx)
+        val now = ZonedDateTime.now()
+        val nowLocal = now.toLocalDateTime()
+
+        if (!dpm.isDeviceOwnerApp(ctx.packageName)) {
+            activeBlocks = emptyMap()
+            cacheValidUntil = System.currentTimeMillis() + MAX_CACHE_MS
+            armNextBoundary(ctx, schedules, now)
+            return
+        }
+
+        val active = schedules.filter { it.isActiveAt(nowLocal) }
+        val protectedPkgs = protectedPackages(ctx)
+
+        val desiredApps = active.flatMap { it.packages }.toSet() - protectedPkgs
+        val desiredRestrictions = active.flatMap { it.restrictions }.toMutableSet()
+        val desiredSites = active.flatMap { it.websites }.toSet()
+
+        if (ScheduleRepository.isAntiTamperEnabled(ctx) && schedules.any { it.enabled }) {
+            desiredRestrictions += UserManager.DISALLOW_CONFIG_DATE_TIME
+            try {
+                dpm.setAutoTimeEnabled(admin, true)
+                dpm.setAutoTimeZoneEnabled(admin, true)
+            } catch (e: Exception) {
+                Timber.w(e, "Could not force automatic time")
+            }
+        }
+
+        applyApps(ctx, dpm, admin, desiredApps)
+        applyRestrictions(ctx, dpm, admin, desiredRestrictions)
+        applySites(ctx, desiredSites)
+
+        activeBlocks = buildMap<String, ActiveBlock> {
+            active.forEach { schedule ->
+                val end = schedule.currentWindowEnd(nowLocal)
+                    ?.atZone(now.zone)?.toInstant()?.toEpochMilli() ?: return@forEach
+                schedule.packages.forEach { pkg ->
+                    val existing = get(pkg)
+                    // With overlapping schedules the app stays blocked until the last one ends.
+                    if (existing == null || end > existing.endsAtMillis) put(pkg, ActiveBlock(schedule.name, end))
+                }
+            }
+        }.filterKeys { it !in protectedPkgs }
+
+        val next = armNextBoundary(ctx, schedules, now)
+        val cap = System.currentTimeMillis() + MAX_CACHE_MS
+        cacheValidUntil = if (next != null) minOf(next, cap) else cap
+    }
+
+    private fun applyApps(
+        ctx: Context,
+        dpm: DevicePolicyManager,
+        admin: ComponentName,
+        desired: Set<String>
+    ) {
+        val prefs = state(ctx)
+        val initiallyOwned = prefs.getStringSet(KEY_OWNED_APPS, emptySet())?.toSet() ?: emptySet()
+        val owned = initiallyOwned.toMutableSet()
+
+        // Suspend what should be blocked and isn't yet. Uninstalled packages are skipped here and
+        // caught on a later sync if they get (re)installed while the window is still open.
+        val toSuspend = desired.filter { pkg ->
+            try {
+                !dpm.isPackageSuspended(admin, pkg)
+            } catch (_: PackageManager.NameNotFoundException) {
+                false
+            }
+        }
+        if (toSuspend.isNotEmpty()) {
+            val failed = dpm.setPackagesSuspended(admin, toSuspend.toTypedArray(), true).toSet()
+            if (failed.isNotEmpty()) Timber.w("Schedule: could not suspend $failed")
+            owned += toSuspend - failed
+        }
+
+        // Release what this schedule applied but is no longer wanted — unless another feature
+        // (impulse block, visual-blocking escalation) still needs it suspended.
+        val toRelease = owned - desired
+        if (toRelease.isNotEmpty()) {
+            val timeLimitTracker = TimeLimitSuspensionTracker(ctx)
+            val heldElsewhere = SecurityManager.getActiveImpulseSuspension(ctx) +
+                VisualBlockingSuspensionTracker(ctx).activeSuspensions()
+                    .filterValues { it > System.currentTimeMillis() }.keys +
+                timeLimitTracker.dailyLimitSuspensions().keys +
+                timeLimitTracker.reopeningSuspensions().keys
+            val releasable = (toRelease - heldElsewhere).filter { pkg ->
+                try {
+                    ctx.packageManager.getPackageInfo(pkg, 0); true
+                } catch (_: PackageManager.NameNotFoundException) {
+                    false
+                }
+            }
+            if (releasable.isNotEmpty()) dpm.setPackagesSuspended(admin, releasable.toTypedArray(), false)
+            owned -= toRelease
+        }
+
+        // Only touch disk when something changed — this runs every 30s from the service's tick.
+        if (owned != initiallyOwned) prefs.edit(commit = true) { putStringSet(KEY_OWNED_APPS, owned) }
+        if (toSuspend.isNotEmpty() || toRelease.isNotEmpty()) AppRepository.invalidateCache()
+    }
+
+    private fun applyRestrictions(
+        ctx: Context,
+        dpm: DevicePolicyManager,
+        admin: ComponentName,
+        desired: Set<String>
+    ) {
+        val prefs = state(ctx)
+        val initiallyOwned = prefs.getStringSet(KEY_OWNED_RESTRICTIONS, emptySet())?.toSet() ?: emptySet()
+        val owned = initiallyOwned.toMutableSet()
+        val current = dpm.getUserRestrictions(admin)
+
+        desired.forEach { key ->
+            // Re-applied even when already owned: other code paths (e.g. the accessibility
+            // service clearing DISALLOW_INSTALL_APPS on connect) may have lifted it mid-window.
+            if (!current.getBoolean(key)) {
+                try {
+                    dpm.addUserRestriction(admin, key)
+                    owned += key
+                } catch (e: Exception) {
+                    Timber.w(e, "Schedule: could not add restriction $key")
+                }
+            }
+        }
+
+        (owned - desired).forEach { key ->
+            try {
+                dpm.clearUserRestriction(admin, key)
+            } catch (e: Exception) {
+                Timber.w(e, "Schedule: could not clear restriction $key")
+            }
+            owned -= key
+        }
+
+        if (owned != initiallyOwned) prefs.edit(commit = true) { putStringSet(KEY_OWNED_RESTRICTIONS, owned) }
+    }
+
+    private fun applySites(ctx: Context, desired: Set<String>) {
+        val prefs = state(ctx)
+        val previous = prefs.getStringSet(KEY_ACTIVE_SITES, emptySet()) ?: emptySet()
+        if (previous == desired) return
+        prefs.edit(commit = true) { putStringSet(KEY_ACTIVE_SITES, desired) }
+        try {
+            BrowserRestrictionsManager(ctx).applyRestrictions()
+        } catch (e: Exception) {
+            Timber.w(e, "Schedule: could not update browser blocklist")
+        }
+    }
+
+    /** Websites blocked by schedules that are open right now — merged into the browser blocklist. */
+    fun getActiveScheduledSites(context: Context): Set<String> =
+        state(context).getStringSet(KEY_ACTIVE_SITES, emptySet()) ?: emptySet()
+
+    /**
+     * Fast check used by the accessibility service on every app switch. Returns the block if
+     * [pkg] belongs to an open window — a second line of defence for apps the system refused to
+     * suspend, or for the few seconds between a reinstall and the next sync.
+     */
+    fun activeBlockFor(context: Context, pkg: String): ActiveBlock? {
+        if (System.currentTimeMillis() >= cacheValidUntil) sync(context)
+        return activeBlocks[pkg]
+    }
+
+    fun isHeldBySchedule(context: Context, pkg: String): Boolean = activeBlockFor(context, pkg) != null
+
+    /** True while any schedule is inside a window it was told to lock. */
+    fun isAnyScheduleLocked(context: Context): Boolean =
+        ScheduleRepository.getSchedules(context).any { ScheduleRepository.isLockedNow(it) }
+
+    /**
+     * Called when another feature is about to release [pkg] while a schedule still wants it
+     * blocked: the suspension stays, and the schedule takes over responsibility for lifting it.
+     */
+    fun adopt(context: Context, pkg: String) = synchronized(lock) {
+        val prefs = state(context)
+        val owned = (prefs.getStringSet(KEY_OWNED_APPS, emptySet()) ?: emptySet()) + pkg
+        prefs.edit(commit = true) { putStringSet(KEY_OWNED_APPS, owned) }
+    }
+
+    /** Called when the user manually suspends [pkg], so a window closing won't undo that. */
+    fun disown(context: Context, pkg: String) = synchronized(lock) {
+        val prefs = state(context)
+        val owned = (prefs.getStringSet(KEY_OWNED_APPS, emptySet()) ?: emptySet()) - pkg
+        prefs.edit(commit = true) { putStringSet(KEY_OWNED_APPS, owned) }
+    }
+
+    /** Lifts everything schedules applied. Used right before Device Owner is removed. */
+    fun releaseAll(context: Context) {
+        val ctx = context.applicationContext
+        synchronized(lock) {
+            try {
+                val dpm = ctx.getSystemService(Context.DEVICE_POLICY_SERVICE) as DevicePolicyManager
+                val admin = ComponentName(ctx, DechainerDeviceAdminReceiver::class.java)
+                if (dpm.isDeviceOwnerApp(ctx.packageName)) {
+                    applyApps(ctx, dpm, admin, emptySet())
+                    applyRestrictions(ctx, dpm, admin, emptySet())
+                }
+                applySites(ctx, emptySet())
+                activeBlocks = emptyMap()
+                cancelAlarm(ctx)
+            } catch (e: Exception) {
+                Timber.e(e, "Schedule releaseAll failed")
+            }
+        }
+    }
+
+    /**
+     * Apps that must never be blocked: Dechainer itself, the launcher (the "go home" fallback would
+     * loop), System UI, and the phone app so emergency calls always work.
+     */
+    fun protectedPackages(context: Context): Set<String> {
+        val pm = context.packageManager
+        val result = mutableSetOf(context.packageName, "com.android.systemui", "com.android.phone")
+        try {
+            val homeIntent = Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_HOME)
+            pm.queryIntentActivities(homeIntent, PackageManager.MATCH_ALL)
+                .forEach { result += it.activityInfo.packageName }
+        } catch (_: Exception) { }
+        // minSdk is 30, so getSystemDialerPackage() (API 29) is always present and the
+        // NoSuchMethodError some reviewers warn about cannot occur here. Kept null-safe and
+        // Throwable-safe anyway: this runs on the boot path, where dying is expensive.
+        try {
+            val telecom = context.getSystemService(Context.TELECOM_SERVICE) as? TelecomManager
+            telecom?.defaultDialerPackage?.let { result += it }
+            telecom?.systemDialerPackage?.let { result += it }
+        } catch (_: Throwable) { }
+        return result
+    }
+
+    private fun pendingIntent(ctx: Context): PendingIntent = PendingIntent.getBroadcast(
+        ctx,
+        0,
+        Intent(ctx, ScheduleReceiver::class.java).setAction(ACTION_BOUNDARY),
+        PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT
+    )
+
+    private fun cancelAlarm(ctx: Context) {
+        val am = ctx.getSystemService(Context.ALARM_SERVICE) as AlarmManager
+        am.cancel(pendingIntent(ctx))
+    }
+
+    /** Arms an alarm one second after the next window start/end. Returns that boundary, if any. */
+    private fun armNextBoundary(ctx: Context, schedules: List<BlockSchedule>, now: ZonedDateTime): Long? {
+        val next = schedules.flatMap { it.boundariesAfter(now) }.minOrNull()
+        if (next == null) {
+            cancelAlarm(ctx)
+            return null
+        }
+        val triggerAt = next.toInstant().toEpochMilli() + 1000L
+        val am = ctx.getSystemService(Context.ALARM_SERVICE) as AlarmManager
+        val pi = pendingIntent(ctx)
+        try {
+            val canExact = Build.VERSION.SDK_INT < Build.VERSION_CODES.S || am.canScheduleExactAlarms()
+            if (canExact) am.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, triggerAt, pi)
+            else am.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, triggerAt, pi)
+        } catch (e: SecurityException) {
+            am.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, triggerAt, pi)
+        }
+        return triggerAt
+    }
+}
