+++ main120/app/src/test/java/io/github/warleysr/dechainer/PetCompanionTest.kt	2026-09-19 12:51:05.072506484 +0000
@@ -0,0 +1,52 @@
+package io.github.warleysr.dechainer
+
+import io.github.warleysr.dechainer.data.PetCompanion
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import java.time.LocalDate
+
+class PetCompanionTest {
+
+    private val start: LocalDate = LocalDate.of(2026, 9, 1)
+    private val max = PetCompanion.MAX_LEVEL
+
+    @Test
+    fun noSlipEverIsFullHealth() {
+        assertEquals(max, PetCompanion.healthLevel(max, null, start))
+        assertEquals(0, PetCompanion.daysUntilNextLevel(max, null, start))
+    }
+
+    @Test
+    fun oneSlipFromFullHealthIsNotAllOrNothing() {
+        // Thriving (4) minus DAMAGE_LEVELS (2) = 2, NOT 0.
+        val baseline = max - PetCompanion.DAMAGE_LEVELS
+        assertEquals(2, PetCompanion.healthLevel(baseline, start, start))
+        // And it climbs back from there, not from zero.
+        assertEquals(3, PetCompanion.healthLevel(baseline, start, start.plusDays(2)))
+        assertEquals(max, PetCompanion.healthLevel(baseline, start, start.plusDays(4)))
+    }
+
+    @Test
+    fun repeatedSlipsStillBottomOut() {
+        // Slip from 2 -> 0: repeated bypassing does drive the pet to its worst state.
+        assertEquals(0, PetCompanion.healthLevel(0, start, start))
+        assertEquals(0, PetCompanion.healthLevel(0, start, start.plusDays(1)))
+        assertEquals(1, PetCompanion.healthLevel(0, start, start.plusDays(2)))
+    }
+
+    @Test
+    fun healthCapsAtMaxLevel() {
+        assertEquals(max, PetCompanion.healthLevel(0, start, start.plusDays(1000)))
+        assertEquals(0, PetCompanion.daysUntilNextLevel(0, start, start.plusDays(1000)))
+    }
+
+    @Test
+    fun daysUntilNextLevelCountsDownAndNeverReportsZeroWhileRecovering() {
+        assertEquals(2, PetCompanion.daysUntilNextLevel(0, start, start))
+        assertEquals(1, PetCompanion.daysUntilNextLevel(0, start, start.plusDays(1)))
+        // Just climbed a level, so the countdown restarts for the next one.
+        assertEquals(2, PetCompanion.daysUntilNextLevel(0, start, start.plusDays(2)))
+        // Recovering from a partial slip reports a sane countdown too.
+        assertEquals(2, PetCompanion.daysUntilNextLevel(2, start, start))
+    }
+}
