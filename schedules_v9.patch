+package io.github.warleysr.dechainer.screens.common
+
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.RadialGradient
+import android.graphics.RectF
+import android.graphics.Shader
+import androidx.core.graphics.ColorUtils
+import io.github.warleysr.dechainer.data.PetCompanion
+import kotlin.math.cos
+import kotlin.math.min
+import kotlin.math.sin
+
+/**
+ * All of the companion's artwork, drawn with plain [android.graphics] calls so that exactly the
+ * same creature can be rendered into a Compose canvas (see PetView) and into a Bitmap for the
+ * home-screen widget (see PetWidgetProvider). Nothing binary ships with this — it is all vectors
+ * computed at draw time, so it stays sharp at any size.
+ *
+ * Every mood difference is a continuous parameter rather than a separate drawing, which is why the
+ * pet reads as the *same* animal getting better or worse instead of five unrelated pictures:
+ * posture, ear droop, eyelid height, brow angle and saturation are all driven off [level].
+ */
+object PetArt {
+
+    const val ACCESSORY_NONE = 0
+    const val ACCESSORY_SPROUT = 1
+    const val ACCESSORY_FLOWER = 2
+    const val ACCESSORY_CROWN = 3
+
+    /** Fallback accent when no Material theme colour is available (the widget has no theme). */
+    const val DEFAULT_ACCENT = 0xFF3DDC97.toInt()
+
+    private val MAXF = PetCompanion.MAX_LEVEL.toFloat()
+
+    /** Base body colour: drains of colour as health falls, full accent only at the top level. */
+    fun bodyColor(level: Int, accent: Int = DEFAULT_ACCENT): Int =
+        when (level.coerceIn(0, PetCompanion.MAX_LEVEL)) {
+            0 -> 0xFF8A9491.toInt()
+            1 -> 0xFF9FAE94.toInt()
+            2 -> 0xFFBFC97A.toInt()
+            3 -> 0xFF86CE8E.toInt()
+            else -> accent
+        }
+
+    private fun lighten(color: Int, amount: Float) = ColorUtils.blendARGB(color, Color.WHITE, amount)
+    private fun darken(color: Int, amount: Float) = ColorUtils.blendARGB(color, Color.BLACK, amount)
+    private fun alpha(color: Int, a: Float) =
+        ColorUtils.setAlphaComponent(color, (a.coerceIn(0f, 1f) * 255).toInt())
+
+    /**
+     * Draws the companion filling the given box.
+     *
+     * @param breath 0..1, slow idle rise and fall.
+     * @param blink 0..1, 1 = eyes fully shut.
+     * @param wag -1..1, tail swing.
+     * @param excite 0..1, the bounce and hearts that play when the pet is tapped.
+     * @param accessory one of the ACCESSORY_ constants, earned at clean-day milestones.
+     * @param accent the app's theme colour, used for a thriving pet.
+     */
+    fun draw(
+        canvas: Canvas,
+        width: Float,
+        height: Float,
+        level: Int,
+        breath: Float = 0.5f,
+        blink: Float = 0f,
+        wag: Float = 0f,
+        excite: Float = 0f,
+        accessory: Int = ACCESSORY_NONE,
+        accent: Int = DEFAULT_ACCENT
+    ) {
+        val lv = level.coerceIn(0, PetCompanion.MAX_LEVEL)
+        val posture = lv / MAXF                       // 0 = collapsed, 1 = perky
+        val s = min(width, height)
+        val cx = width / 2f
+        val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+
+        val base = bodyColor(lv, accent)
+        val rim = darken(base, 0.22f)
+        val ink = darken(base, 0.68f)
+
+        // --- geometry -------------------------------------------------------------------------
+        val groundY = height * 0.90f
+        val bodyRx = s * 0.285f * (1f + 0.025f * (1f - breath))
+        val bodyRy = s * 0.255f * (1f + 0.03f * breath) * (0.9f + 0.1f * posture)
+        val bob = -s * 0.02f * breath * (0.3f + 0.7f * posture) - s * 0.035f * excite
+        val sag = s * 0.03f * (1f - posture)
+        val cy = groundY - bodyRy * 1.05f + bob + sag
+
+        // --- ground shadow --------------------------------------------------------------------
+        paint.reset()
+        paint.isAntiAlias = true
+        paint.color = alpha(Color.BLACK, 0.16f)
+        val shadowRx = bodyRx * (0.92f - 0.10f * breath - 0.12f * excite)
+        canvas.drawOval(
+            RectF(cx - shadowRx, groundY - s * 0.028f, cx + shadowRx, groundY + s * 0.028f),
+            paint
+        )
+
+        // --- tail (behind the body) -------------------------------------------------------------
+        canvas.save()
+        canvas.rotate(wag * (6f + 10f * posture), cx + bodyRx * 0.7f, cy + bodyRy * 0.5f)
+        paint.reset()
+        paint.isAntiAlias = true
+        paint.style = Paint.Style.STROKE
+        paint.strokeCap = Paint.Cap.ROUND
+        paint.strokeWidth = s * 0.042f
+        paint.color = rim
+        val tail = Path().apply {
+            moveTo(cx + bodyRx * 0.72f, cy + bodyRy * 0.42f)
+            quadTo(
+                cx + bodyRx * 1.55f, cy + bodyRy * (0.30f - 0.45f * posture),
+                cx + bodyRx * 1.30f, cy - bodyRy * (0.05f + 0.45f * posture)
+            )
+        }
+        canvas.drawPath(tail, paint)
+        paint.style = Paint.Style.FILL
+        canvas.drawCircle(
+            cx + bodyRx * 1.30f, cy - bodyRy * (0.05f + 0.45f * posture), s * 0.036f, paint
+        )
+        canvas.restore()
+
+        // --- ears (behind the body so they join it cleanly) ---------------------------------------
+        for (sign in listOf(-1f, 1f)) drawEar(canvas, paint, cx, cy, bodyRx, bodyRy, s, sign, posture, base, rim)
+
+        // --- feet ----------------------------------------------------------------------------
+        paint.reset()
+        paint.isAntiAlias = true
+        paint.color = rim
+        val footY = cy + bodyRy * 0.86f
+        for (sign in listOf(-1f, 1f)) {
+            canvas.drawOval(
+                RectF(
+                    cx + sign * bodyRx * 0.44f - s * 0.062f, footY - s * 0.026f,
+                    cx + sign * bodyRx * 0.44f + s * 0.062f, footY + s * 0.030f
+                ),
+                paint
+            )
+        }
+
+        // --- body ----------------------------------------------------------------------------
+        val top = cy - bodyRy
+        val bottom = cy + bodyRy
+        val topRx = bodyRx * 0.88f
+        val body = Path().apply {
+            moveTo(cx, top)
+            cubicTo(cx + topRx, top, cx + bodyRx, cy - bodyRy * 0.10f, cx + bodyRx * 0.98f, cy + bodyRy * 0.45f)
+            cubicTo(cx + bodyRx * 0.95f, bottom, cx + bodyRx * 0.52f, bottom, cx, bottom)
+            cubicTo(cx - bodyRx * 0.52f, bottom, cx - bodyRx * 0.95f, bottom, cx - bodyRx * 0.98f, cy + bodyRy * 0.45f)
+            cubicTo(cx - bodyRx, cy - bodyRy * 0.10f, cx - topRx, top, cx, top)
+            close()
+        }
+        paint.reset()
+        paint.isAntiAlias = true
+        paint.shader = RadialGradient(
+            cx - bodyRx * 0.32f, cy - bodyRy * 0.48f, bodyRx * 1.75f,
+            intArrayOf(lighten(base, 0.30f), base, rim),
+            floatArrayOf(0f, 0.55f, 1f),
+            Shader.TileMode.CLAMP
+        )
+        canvas.drawPath(body, paint)
+        paint.shader = null
+
+        // A soft top highlight: the single cheapest thing that stops a flat fill looking like clip art.
+        paint.color = alpha(Color.WHITE, 0.18f)
+        canvas.drawOval(
+            RectF(
+                cx - bodyRx * 0.52f, cy - bodyRy * 0.86f,
+                cx + bodyRx * 0.12f, cy - bodyRy * 0.42f
+            ),
+            paint
+        )
+
+        // --- muzzle --------------------------------------------------------------------------
+        val muzzleCy = cy + bodyRy * 0.34f
+        val muzzleRx = bodyRx * 0.40f
+        val muzzleRy = bodyRy * 0.28f
+        paint.color = alpha(lighten(base, 0.55f), 0.85f)
+        canvas.drawOval(
+            RectF(cx - muzzleRx, muzzleCy - muzzleRy, cx + muzzleRx, muzzleCy + muzzleRy),
+            paint
+        )
+
+        // --- blush (only when the pet actually feels good) -----------------------------------
+        if (lv >= 3) {
+            paint.color = alpha(0xFFFF8FA3.toInt(), 0.35f + 0.15f * excite)
+            for (sign in listOf(-1f, 1f)) {
+                canvas.drawOval(
+                    RectF(
+                        cx + sign * bodyRx * 0.62f - s * 0.050f, cy + bodyRy * 0.10f - s * 0.030f,
+                        cx + sign * bodyRx * 0.62f + s * 0.050f, cy + bodyRy * 0.10f + s * 0.030f
+                    ),
+                    paint
+                )
+            }
+        }
+
+        // --- eyes ----------------------------------------------------------------------------
+        val eyeDx = bodyRx * 0.38f
+        val eyeY = cy - bodyRy * 0.14f
+        val eyeR = s * 0.060f
+        // How far the lids hang even when awake — the main "is it sick" signal.
+        val lidClose = when (lv) {
+            0 -> 0.62f
+            1 -> 0.42f
+            2 -> 0.18f
+            3 -> 0.04f
+            else -> 0f
+        }
+        val openness = ((1f - lidClose) * (1f - blink)).coerceIn(0f, 1f)
+        paint.style = Paint.Style.FILL
+        for (sign in listOf(-1f, 1f)) {
+            val ex = cx + sign * eyeDx
+            if (openness < 0.10f) {
+                paint.style = Paint.Style.STROKE
+                paint.strokeWidth = s * 0.016f
+                paint.strokeCap = Paint.Cap.ROUND
+                paint.color = ink
+                val closed = Path().apply {
+                    moveTo(ex - eyeR * 0.95f, eyeY)
+                    quadTo(ex, eyeY + eyeR * (if (lv <= 1) 0.75f else -0.75f), ex + eyeR * 0.95f, eyeY)
+                }
+                canvas.drawPath(closed, paint)
+                paint.style = Paint.Style.FILL
+            } else {
+                val ry = eyeR * openness
+                paint.color = Color.WHITE
+                canvas.drawOval(RectF(ex - eyeR, eyeY - ry, ex + eyeR, eyeY + ry), paint)
+                paint.color = ink
+                val irisR = eyeR * 0.60f
+                val irisRy = irisR * openness
+                canvas.drawOval(
+                    RectF(ex - irisR, eyeY - irisRy, ex + irisR, eyeY + irisRy), paint
+                )
+                if (openness > 0.5f) {
+                    paint.color = alpha(Color.WHITE, 0.95f)
+                    canvas.drawCircle(ex - irisR * 0.35f, eyeY - irisRy * 0.40f, eyeR * 0.20f, paint)
+                    if (lv >= 4) {
+                        canvas.drawCircle(ex + irisR * 0.40f, eyeY + irisRy * 0.35f, eyeR * 0.11f, paint)
+                    }
+                }
+                // The upper lid, drawn over the eye, is what makes a tired pet look tired.
+                if (lidClose > 0.05f && blink < 0.5f) {
+                    paint.color = rim
+                    canvas.drawRect(
+                        RectF(ex - eyeR * 1.05f, eyeY - eyeR * 1.1f, ex + eyeR * 1.05f, eyeY - ry * 0.55f),
+                        paint
+                    )
+                }
+            }
+        }
+
+        // --- brows ---------------------------------------------------------------------------
+        paint.style = Paint.Style.STROKE
+        paint.strokeWidth = s * 0.017f
+        paint.strokeCap = Paint.Cap.ROUND
+        paint.color = ink
+        // Worried brows slope down and out; content brows sit flat and high.
+        val browTilt = (0.5f - posture) * eyeR * 1.3f
+        val browY = eyeY - eyeR * (1.55f + 0.35f * posture)
+        for (sign in listOf(-1f, 1f)) {
+            val ex = cx + sign * eyeDx
+            canvas.drawLine(
+                ex - sign * eyeR * 0.85f, browY + browTilt,
+                ex + sign * eyeR * 0.85f, browY - browTilt * 0.4f,
+                paint
+            )
+        }
+
+        // --- nose and mouth ------------------------------------------------------------------
+        paint.style = Paint.Style.FILL
+        paint.color = ink
+        val noseY = muzzleCy - muzzleRy * 0.45f
+        val noseW = s * 0.032f
+        val nose = Path().apply {
+            moveTo(cx - noseW, noseY - noseW * 0.5f)
+            quadTo(cx, noseY - noseW * 0.9f, cx + noseW, noseY - noseW * 0.5f)
+            quadTo(cx + noseW * 0.4f, noseY + noseW * 0.9f, cx, noseY + noseW * 0.95f)
+            quadTo(cx - noseW * 0.4f, noseY + noseW * 0.9f, cx - noseW, noseY - noseW * 0.5f)
+            close()
+        }
+        canvas.drawPath(nose, paint)
+
+        paint.style = Paint.Style.STROKE
+        paint.strokeWidth = s * 0.018f
+        val mouthY = noseY + s * 0.045f
+        val mouthW = muzzleRx * 0.78f
+        // curve > 0 smiles, curve < 0 frowns; crosses zero at "under the weather".
+        val curve = (posture - 0.45f) * s * 0.10f
+        val mouth = Path()
+        if (curve >= 0f) {
+            // A happy pet gets a two-lobed smile rather than one bland arc.
+            mouth.moveTo(cx - mouthW, mouthY)
+            mouth.quadTo(cx - mouthW * 0.5f, mouthY + curve, cx, mouthY + curve * 0.25f)
+            mouth.quadTo(cx + mouthW * 0.5f, mouthY + curve, cx + mouthW, mouthY)
+        } else {
+            mouth.moveTo(cx - mouthW * 0.8f, mouthY + curve * 0.5f)
+            mouth.quadTo(cx, mouthY + curve, cx + mouthW * 0.8f, mouthY + curve * 0.5f)
+        }
+        canvas.drawPath(mouth, paint)
+
+        // --- unwell extras: a sweat drop and a wobbly aura ------------------------------------
+        if (lv <= 1) {
+            paint.style = Paint.Style.FILL
+            paint.color = alpha(0xFF6FC3E8.toInt(), 0.85f)
+            val dx = cx + bodyRx * 0.78f
+            val dy = cy - bodyRy * 0.62f + s * 0.02f * breath
+            val drop = Path().apply {
+                moveTo(dx, dy - s * 0.045f)
+                quadTo(dx + s * 0.030f, dy + s * 0.008f, dx, dy + s * 0.026f)
+                quadTo(dx - s * 0.030f, dy + s * 0.008f, dx, dy - s * 0.045f)
+                close()
+            }
+            canvas.drawPath(drop, paint)
+        }
+
+        // --- thriving extras: sparkles --------------------------------------------------------
+        if (lv >= PetCompanion.MAX_LEVEL) {
+            paint.style = Paint.Style.FILL
+            val twinkle = 0.45f + 0.55f * breath
+            paint.color = alpha(lighten(accent, 0.45f), twinkle)
+            drawSparkle(canvas, paint, cx - bodyRx * 1.15f, cy - bodyRy * 0.55f, s * 0.055f * twinkle)
+            drawSparkle(canvas, paint, cx + bodyRx * 1.05f, cy - bodyRy * 0.95f, s * 0.042f * (1.4f - twinkle))
+            drawSparkle(canvas, paint, cx - bodyRx * 0.85f, cy + bodyRy * 0.95f, s * 0.034f * twinkle)
+        }
+
+        // --- milestone accessory --------------------------------------------------------------
+        drawAccessory(canvas, paint, accessory, cx, cy - bodyRy, s)
+
+        // --- hearts on tap ---------------------------------------------------------------------
+        if (excite > 0.01f) {
+            paint.style = Paint.Style.FILL
+            val rise = s * 0.30f * excite
+            val fade = (1f - excite * excite).coerceIn(0f, 1f)
+            val spots = listOf(-0.75f to 1.0f, 0.10f to 1.35f, 0.80f to 0.85f)
+            spots.forEachIndexed { i, (offX, scale) ->
+                paint.color = alpha(0xFFFF6B8B.toInt(), fade * (0.7f + 0.1f * i))
+                drawHeart(
+                    canvas, paint,
+                    cx + bodyRx * offX,
+                    cy - bodyRy * 1.05f - rise * scale,
+                    s * 0.048f * scale
+                )
+            }
+        }
+    }
+
+    private fun drawEar(
+        canvas: Canvas, paint: Paint,
+        cx: Float, cy: Float, bodyRx: Float, bodyRy: Float, s: Float,
+        sign: Float, posture: Float, base: Int, rim: Int
+    ) {
+        val bx = cx + sign * bodyRx * 0.52f
+        val by = cy - bodyRy * 0.76f
+        val len = s * 0.175f * (0.85f + 0.15f * posture)
+        // Upright when healthy, folded out and down when not.
+        val deg = 16f + (1f - posture) * 68f
+        val rad = Math.toRadians(deg.toDouble())
+        val tipX = bx + sign * len * sin(rad).toFloat()
+        val tipY = by - len * cos(rad).toFloat()
+        val w = s * 0.082f
+
+        val ear = Path().apply {
+            moveTo(bx - sign * w * 0.85f, by + w * 0.30f)
+            quadTo(bx + sign * w * 0.10f, by - len * 0.85f, tipX, tipY)
+            quadTo(bx + sign * w * 1.45f, by - len * 0.10f, bx + sign * w * 0.95f, by + w * 0.45f)
+            close()
+        }
+        paint.reset()
+        paint.isAntiAlias = true
+        paint.color = rim
+        canvas.drawPath(ear, paint)
+
+        // Inner ear: the same shape shrunk toward its base, which keeps it perfectly aligned.
+        canvas.save()
+        canvas.translate(bx, by)
+        canvas.scale(0.52f, 0.58f)
+        canvas.translate(-bx, -by)
+        paint.color = ColorUtils.blendARGB(base, 0xFFFFC2CF.toInt(), 0.55f)
+        canvas.drawPath(ear, paint)
+        canvas.restore()
+    }
+
+    private fun drawSparkle(canvas: Canvas, paint: Paint, x: Float, y: Float, r: Float) {
+        val p = Path().apply {
+            moveTo(x, y - r)
+            quadTo(x + r * 0.18f, y - r * 0.18f, x + r, y)
+            quadTo(x + r * 0.18f, y + r * 0.18f, x, y + r)
+            quadTo(x - r * 0.18f, y + r * 0.18f, x - r, y)
+            quadTo(x - r * 0.18f, y - r * 0.18f, x, y - r)
+            close()
+        }
+        canvas.drawPath(p, paint)
+    }
+
+    private fun drawHeart(canvas: Canvas, paint: Paint, x: Float, y: Float, r: Float) {
+        val p = Path().apply {
+            moveTo(x, y + r * 0.85f)
+            cubicTo(x - r * 1.5f, y - r * 0.2f, x - r * 0.5f, y - r * 1.2f, x, y - r * 0.35f)
+            cubicTo(x + r * 0.5f, y - r * 1.2f, x + r * 1.5f, y - r * 0.2f, x, y + r * 0.85f)
+            close()
+        }
+        canvas.drawPath(p, paint)
+    }
+
+    /** Head-top decorations earned by clean-day streaks — see PetCompanion.accessoryFor. */
+    private fun drawAccessory(canvas: Canvas, paint: Paint, accessory: Int, cx: Float, headTop: Float, s: Float) {
+        if (accessory == ACCESSORY_NONE) return
+        paint.reset()
+        paint.isAntiAlias = true
+        when (accessory) {
+            ACCESSORY_SPROUT, ACCESSORY_FLOWER -> {
+                paint.style = Paint.Style.STROKE
+                paint.strokeWidth = s * 0.016f
+                paint.strokeCap = Paint.Cap.ROUND
+                paint.color = 0xFF4C9A5B.toInt()
+                canvas.drawLine(cx, headTop + s * 0.01f, cx, headTop - s * 0.075f, paint)
+                paint.style = Paint.Style.FILL
+                for (sign in listOf(-1f, 1f)) {
+                    val leaf = Path().apply {
+                        moveTo(cx, headTop - s * 0.035f)
+                        quadTo(
+                            cx + sign * s * 0.055f, headTop - s * 0.085f,
+                            cx + sign * s * 0.012f, headTop - s * 0.088f
+                        )
+                        quadTo(cx + sign * s * 0.004f, headTop - s * 0.055f, cx, headTop - s * 0.035f)
+                        close()
+                    }
+                    canvas.drawPath(leaf, paint)
+                }
+                if (accessory == ACCESSORY_FLOWER) {
+                    paint.color = 0xFFFFB3C7.toInt()
+                    val fy = headTop - s * 0.088f
+                    for (i in 0 until 5) {
+                        val a = Math.toRadians((i * 72).toDouble())
+                        canvas.drawCircle(
+                            cx + (s * 0.028f * sin(a)).toFloat(),
+                            fy - (s * 0.028f * cos(a)).toFloat(),
+                            s * 0.022f, paint
+                        )
+                    }
+                    paint.color = 0xFFFFD75E.toInt()
+                    canvas.drawCircle(cx, fy, s * 0.018f, paint)
+                }
+            }
+            ACCESSORY_CROWN -> {
+                paint.style = Paint.Style.FILL
+                paint.color = 0xFFFFC94A.toInt()
+                val w = s * 0.095f
+                val baseY = headTop + s * 0.012f
+                val topY = baseY - s * 0.075f
+                val crown = Path().apply {
+                    moveTo(cx - w, baseY)
+                    lineTo(cx - w, topY + s * 0.02f)
+                    lineTo(cx - w * 0.5f, topY + s * 0.045f)
+                    lineTo(cx, topY)
+                    lineTo(cx + w * 0.5f, topY + s * 0.045f)
+                    lineTo(cx + w, topY + s * 0.02f)
+                    lineTo(cx + w, baseY)
+                    close()
+                }
+                canvas.drawPath(crown, paint)
+                paint.color = 0xFFFF7A7A.toInt()
+                canvas.drawCircle(cx, topY + s * 0.030f, s * 0.014f, paint)
+            }
+        }
+    }
+
+    /** Renders the pet into a square Bitmap. Used by the widget, which cannot host a Composable. */
+    fun renderBitmap(
+        sizePx: Int,
+        level: Int,
+        accessory: Int = ACCESSORY_NONE,
+        accent: Int = DEFAULT_ACCENT
+    ): Bitmap {
+        val px = sizePx.coerceIn(48, 512)
+        val bitmap = Bitmap.createBitmap(px, px, Bitmap.Config.ARGB_8888)
+        draw(
+            canvas = Canvas(bitmap),
+            width = px.toFloat(),
+            height = px.toFloat(),
+            level = level,
+            breath = 0.65f,
+            blink = 0f,
+            wag = 0.6f,
+            excite = 0f,
+            accessory = accessory,
+            accent = accent
+        )
+        return bitmap
+    }
+}
