--- orig120/app/src/main/java/io/github/warleysr/dechainer/data/ConfessionLog.kt	1970-01-01 00:00:00.000000000 +0000
+++ main120/app/src/main/java/io/github/warleysr/dechainer/data/ConfessionLog.kt	2026-09-19 12:51:05.052948532 +0000
@@ -0,0 +1,125 @@
+package io.github.warleysr.dechainer.data
+
+import android.content.Context
+import androidx.core.content.edit
+import org.json.JSONArray
+import org.json.JSONObject
+import timber.log.Timber
+import java.io.File
+import java.util.UUID
+
+/**
+ * A local-only voice log: a short recording of *why* the person is about to loosen a protection,
+ * offered back to them the next time they reach for the same kind of action. Nothing here is ever
+ * uploaded or sent anywhere — recording it is always optional (see AccountabilityStep), and this
+ * class only ever gets called once someone has already chosen to record.
+ */
+object ConfessionLog {
+    private const val PREFS_NAME = "confession_log"
+    private const val KEY_ENTRIES = "entries_json"
+
+    /** Oldest entries are dropped past this count, same reasoning as capping any on-device log. */
+    private const val MAX_ENTRIES = 20
+
+    data class Entry(val id: String, val timestampMillis: Long, val category: String, val label: String)
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    private fun dir(context: Context): File =
+        File(context.applicationContext.filesDir, "confessions").apply { mkdirs() }
+
+    fun audioFile(context: Context, id: String): File = File(dir(context), "$id.m4a")
+
+    fun getEntries(context: Context): List<Entry> {
+        val json = prefs(context).getString(KEY_ENTRIES, null) ?: return emptyList()
+        return try {
+            val array = JSONArray(json)
+            (0 until array.length()).map { i ->
+                val o = array.getJSONObject(i)
+                Entry(o.getString("id"), o.getLong("ts"), o.getString("category"), o.getString("label"))
+            }.sortedByDescending { it.timestampMillis }
+        } catch (e: Exception) {
+            emptyList()
+        }
+    }
+
+    /** Most recent entry recorded for this [category] (e.g. "schedule_disable") that still has audio. */
+    fun mostRecentFor(context: Context, category: String): Entry? =
+        getEntries(context).firstOrNull { it.category == category && audioFile(context, it.id).exists() }
+
+    /**
+     * Registers a confession and takes ownership of [audio], the temp file the recorder produced.
+     * The file is **moved** into this log's own directory under the new entry's id — that move is
+     * the whole point of this method: without it the recording is left in the cache directory and
+     * playback later finds nothing, which is exactly the bug this signature is shaped to prevent.
+     *
+     * Passing a null [audio] records a text-only entry (the person chose not to record).
+     * Returns null if audio was supplied but could not be stored, so the caller never ends up with
+     * a log row pointing at a file that isn't there.
+     */
+    fun addEntry(context: Context, category: String, label: String, audio: File? = null): Entry? {
+        val entry = Entry(UUID.randomUUID().toString(), System.currentTimeMillis(), category, label)
+
+        if (audio != null) {
+            val target = audioFile(context, entry.id)
+            if (!moveInto(audio, target)) {
+                audio.delete()
+                return null
+            }
+        }
+
+        val all = (listOf(entry) + getEntries(context)).sortedByDescending { it.timestampMillis }
+        val kept = all.take(MAX_ENTRIES)
+        (all - kept.toSet()).forEach { audioFile(context, it.id).delete() }
+        saveAll(context, kept)
+        return entry
+    }
+
+    /**
+     * Moves [source] onto [target]. renameTo is tried first because it's atomic and free, but it
+     * fails whenever cacheDir and filesDir land on different mounts on a given device, so the copy
+     * fallback is not optional.
+     */
+    private fun moveInto(source: File, target: File): Boolean {
+        if (!source.exists() || source.length() == 0L) return false
+        return try {
+            target.parentFile?.mkdirs()
+            if (source.renameTo(target)) return true
+            source.inputStream().use { input ->
+                target.outputStream().use { output -> input.copyTo(output) }
+            }
+            source.delete()
+            target.exists() && target.length() > 0
+        } catch (e: Exception) {
+            Timber.w(e, "Could not store confession audio")
+            target.delete()
+            false
+        }
+    }
+
+    fun delete(context: Context, entryId: String) {
+        audioFile(context, entryId).delete()
+        saveAll(context, getEntries(context).filterNot { it.id == entryId })
+    }
+
+    fun clearAll(context: Context) {
+        dir(context).listFiles()?.forEach { it.delete() }
+        prefs(context).edit(commit = true) { remove(KEY_ENTRIES) }
+    }
+
+    private fun saveAll(context: Context, entries: List<Entry>) {
+        val array = JSONArray()
+        entries.forEach { e ->
+            array.put(
+                JSONObject().apply {
+                    put("id", e.id)
+                    put("ts", e.timestampMillis)
+                    put("category", e.category)
+                    put("label", e.label)
+                }
+            )
+        }
+        prefs(context).edit(commit = true) { putString(KEY_ENTRIES, array.toString()) }
+    }
+}
