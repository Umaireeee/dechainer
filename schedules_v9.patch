+import io.github.warleysr.dechainer.R
+import io.github.warleysr.dechainer.data.RegretLog
+import kotlin.math.roundToInt
+
+/**
+ * Shows what the person's own ratings say about each app: the regret ratio, how much time they
+ * called wasted, and which apps are worth considering for a schedule. Suggestions only — nothing
+ * here blocks anything on its own.
+ */
+@Composable
+fun RegretStatsScreen() {
+    val context = LocalContext.current
+    var ratings by remember { mutableStateOf(RegretLog.getRatings(context)) }
+    val summaries = remember(ratings) { RegretLog.summarize(ratings) }
+    val suggested = remember(ratings) { RegretLog.suggestedForBlocking(ratings) }
+    val packageManager = context.packageManager
+
+    fun appLabel(pkg: String): String = try {
+        packageManager.getApplicationInfo(pkg, 0).loadLabel(packageManager).toString()
+    } catch (e: Exception) {
+        pkg
+    }
+
+    LazyColumn(modifier = Modifier.fillMaxSize()) {
+        item {
+            Text(
+                stringResource(R.string.regret_stats_desc),
+                style = MaterialTheme.typography.bodyMedium,
+                modifier = Modifier.padding(16.dp)
+            )
+        }
+
+        if (summaries.isEmpty()) {
+            item {
+                Text(
+                    stringResource(R.string.regret_stats_empty),
+                    style = MaterialTheme.typography.bodyMedium,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    modifier = Modifier.padding(horizontal = 24.dp, vertical = 8.dp)
+                )
+            }
+        }
+
+        if (suggested.isNotEmpty()) {
+            item {
+                Card(
+                    colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.errorContainer),
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .padding(horizontal = 16.dp, vertical = 8.dp)
+                ) {
+                    Column(modifier = Modifier.padding(16.dp)) {
+                        Text(
+                            stringResource(R.string.regret_suggestion_title),
+                            style = MaterialTheme.typography.titleMedium,
+                            fontWeight = FontWeight.Bold
+                        )
+                        Text(
+                            stringResource(R.string.regret_suggestion_text),
+                            style = MaterialTheme.typography.bodyMedium
+                        )
+                        Spacer(Modifier.height(8.dp))
+                        suggested.forEach { s ->
+                            Text(
+                                "• ${appLabel(s.packageName)}",
+                                style = MaterialTheme.typography.bodyMedium,
+                                fontWeight = FontWeight.Medium
+                            )
+                        }
+                    }
+                }
+                HorizontalDivider(modifier = Modifier.padding(horizontal = 16.dp))
+            }
+        }
+
+        items(summaries, key = { it.packageName }) { summary ->
+            Column(modifier = Modifier.padding(horizontal = 16.dp, vertical = 8.dp)) {
+                Row(verticalAlignment = Alignment.CenterVertically) {
+                    Text(
+                        appLabel(summary.packageName),
+                        style = MaterialTheme.typography.bodyLarge,
+                        fontWeight = FontWeight.Medium,
+                        modifier = Modifier.weight(1f)
+                    )
+                    Text(
+                        if (summary.hasEnoughData) {
+                            stringResource(
+                                R.string.regret_ratio,
+                                (summary.regretRatio * 100).roundToInt(),
+                                summary.total
+                            )
+                        } else {
+                            stringResource(R.string.regret_not_enough_data)
+                        },
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant
+                    )
+                }
+                Spacer(Modifier.height(4.dp))
+                LinearProgressIndicator(
+                    progress = { summary.regretRatio },
+                    color = if (summary.regretRatio >= 0.6f) MaterialTheme.colorScheme.error
+                    else MaterialTheme.colorScheme.primary,
+                    modifier = Modifier.fillMaxWidth()
+                )
+                if (summary.regrettedSeconds > 0) {
+                    Text(
+                        stringResource(R.string.regret_wasted_time, summary.regrettedSeconds / 60),
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant
+                    )
+                }
+            }
+        }
+
+        if (summaries.isNotEmpty()) {
+            item {
+                TextButton(
+                    onClick = {
+                        RegretLog.clearAll(context)
+                        ratings = RegretLog.getRatings(context)
+                    },
+                    modifier = Modifier.padding(8.dp)
+                ) { Text(stringResource(R.string.regret_clear)) }
+            }
+        }
+
+        item { Spacer(Modifier.height(24.dp)) }
+    }
+}
