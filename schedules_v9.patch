+package io.github.warleysr.dechainer.security
+
+import android.content.Context
+import android.media.MediaPlayer
+import android.media.MediaRecorder
+import android.os.Build
+import timber.log.Timber
+import java.io.File
+
+/**
+ * Records a short voice confession to a temp file. Every entry point is wrapped defensively:
+ * a failure here (denied permission, busy mic, low storage) must never block whatever action the
+ * person was already in the middle of — it should just mean there's no recording this time.
+ */
+class VoiceRecorder(private val context: Context) {
+    private var recorder: MediaRecorder? = null
+    private var outputFile: File? = null
+
+    /** True if recording actually started. False means: skip straight to "no recording available". */
+    fun start(): Boolean {
+        release()
+        val file = File(context.cacheDir, "confession_tmp_${System.currentTimeMillis()}.m4a")
+        return try {
+            val r = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) MediaRecorder(context) else MediaRecorder()
+            r.setAudioSource(MediaRecorder.AudioSource.MIC)
+            r.setOutputFormat(MediaRecorder.OutputFormat.MPEG_4)
+            r.setAudioEncoder(MediaRecorder.AudioEncoder.AAC)
+            r.setOutputFile(file.absolutePath)
+            r.prepare()
+            r.start()
+            recorder = r
+            outputFile = file
+            true
+        } catch (e: Exception) {
+            Timber.w(e, "Confession recording could not start")
+            file.delete()
+            release()
+            false
+        }
+    }
+
+    /**
+     * Stops and returns the recorded file, or null if nothing usable was captured.
+     *
+     * Ownership of the returned file moves to the caller: this recorder forgets about it, so a
+     * later [cancel] (for example from a screen being disposed) can no longer delete a file that
+     * has already been filed away.
+     */
+    fun stop(): File? {
+        val file = outputFile
+        val result = try {
+            recorder?.stop()
+            file?.takeIf { it.exists() && it.length() > 0 }
+        } catch (e: Exception) {
+            Timber.w(e, "Confession recording could not stop cleanly")
+            file?.delete()
+            null
+        }
+        release()
+        outputFile = null
+        return result
+    }
+
+    /** Discards whatever was being recorded — used when the person cancels instead of saving. */
+    fun cancel() {
+        try {
+            recorder?.stop()
+        } catch (_: Exception) {
+            // Expected if stop() is called before any data was written yet.
+        }
+        release()
+        outputFile?.delete()
+        outputFile = null
+    }
+
+    private fun release() {
+        try {
+            recorder?.release()
+        } catch (_: Exception) {
+        }
+        recorder = null
+    }
+}
+
+/** Plays back a single confession recording. */
+class VoicePlayer {
+    private var player: MediaPlayer? = null
+
+    fun play(file: File, onComplete: () -> Unit = {}) {
+        stop()
+        try {
+            val p = MediaPlayer()
+            p.setDataSource(file.absolutePath)
+            p.setOnCompletionListener {
+                stop()
+                onComplete()
+            }
+            p.setOnErrorListener { _, _, _ ->
+                stop()
+                onComplete()
+                true
+            }
+            p.prepare()
+            p.start()
+            player = p
+        } catch (e: Exception) {
+            Timber.w(e, "Confession playback failed")
+            onComplete()
+        }
+    }
+
+    fun stop() {
+        try {
+            player?.stop()
+            player?.release()
+        } catch (_: Exception) {
+        }
+        player = null
+    }
+}
