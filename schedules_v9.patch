+import androidx.compose.ui.graphics.nativeCanvas
+import androidx.compose.ui.graphics.toArgb
+import androidx.compose.ui.unit.Dp
+import androidx.compose.ui.unit.dp
+import io.github.warleysr.dechainer.data.PetCompanion
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlin.random.Random
+
+/**
+ * The companion, alive: idle breathing, a tail that swings, occasional blinks, and a little bounce
+ * with hearts when it is tapped. The drawing itself lives in [PetArt] so the home-screen widget
+ * renders the exact same creature.
+ *
+ * The animations are deliberately slow and small. A pet that jitters is a pet you stop looking at,
+ * and this one only works if it stays pleasant to glance at for months.
+ */
+@Composable
+fun PetView(
+    healthLevel: Int,
+    modifier: Modifier = Modifier,
+    size: Dp = 96.dp,
+    accessory: Int = PetArt.ACCESSORY_NONE,
+    interactive: Boolean = false,
+    onPetted: () -> Unit = {}
+) {
+    val level = healthLevel.coerceIn(0, PetCompanion.MAX_LEVEL)
+    val accent = MaterialTheme.colorScheme.primary.toArgb()
+    val infinite = rememberInfiniteTransition(label = "pet_idle")
+
+    // Sicker pets breathe more slowly and shallowly — it reads as low energy without any text.
+    val breathMs = 1700 + (PetCompanion.MAX_LEVEL - level) * 500
+    val breath by infinite.animateFloat(
+        initialValue = 0f,
+        targetValue = 1f,
+        animationSpec = infiniteRepeatable(
+            animation = tween(breathMs, easing = FastOutSlowInEasing),
+            repeatMode = RepeatMode.Reverse
+        ),
+        label = "pet_breath"
+    )
+    val wagRaw by infinite.animateFloat(
+        initialValue = -1f,
+        targetValue = 1f,
+        animationSpec = infiniteRepeatable(
+            animation = tween(if (level >= 3) 700 else 1600, easing = LinearEasing),
+            repeatMode = RepeatMode.Reverse
+        ),
+        label = "pet_wag"
+    )
+    // A very sick pet barely moves its tail at all.
+    val wagScale by animateFloatAsState(
+        targetValue = 0.15f + 0.85f * (level / PetCompanion.MAX_LEVEL.toFloat()),
+        label = "pet_wag_scale"
+    )
+
+    val blink = remember { Animatable(0f) }
+    LaunchedEffect(level) {
+        while (true) {
+            delay(Random.nextLong(2600, 6500))
+            blink.animateTo(1f, tween(80))
+            blink.animateTo(0f, tween(120))
+        }
+    }
+
+    val excite = remember { Animatable(0f) }
+    val scope = rememberCoroutineScope()
+    val interactionSource = remember { MutableInteractionSource() }
+
+    val tapModifier = if (interactive) {
+        Modifier.clickable(interactionSource = interactionSource, indication = null) {
+            scope.launch {
+                excite.snapTo(0f)
+                excite.animateTo(1f, tween(220, easing = FastOutSlowInEasing))
+                excite.animateTo(0f, tween(620, easing = FastOutSlowInEasing))
+            }
+            onPetted()
+        }
+    } else Modifier
+
+    Box(modifier = modifier.size(size).then(tapModifier)) {
+        Canvas(modifier = Modifier.size(size)) {
+            drawIntoCanvas { canvas ->
+                PetArt.draw(
+                    canvas = canvas.nativeCanvas,
+                    width = this.size.width,
+                    height = this.size.height,
+                    level = level,
+                    breath = breath,
+                    blink = blink.value,
+                    wag = wagRaw * wagScale,
+                    excite = excite.value,
+                    accessory = accessory,
+                    accent = accent
+                )
+            }
+        }
+    }
+}
+
+/** Short label for the current level, used next to [PetView] wherever it's shown. */
+fun petMoodLabelRes(level: Int): Int = when (level.coerceIn(0, PetCompanion.MAX_LEVEL)) {
+    0 -> io.github.warleysr.dechainer.R.string.pet_mood_very_sick
+    1 -> io.github.warleysr.dechainer.R.string.pet_mood_sick
+    2 -> io.github.warleysr.dechainer.R.string.pet_mood_under_weather
+    3 -> io.github.warleysr.dechainer.R.string.pet_mood_okay
+    else -> io.github.warleysr.dechainer.R.string.pet_mood_thriving
+}
