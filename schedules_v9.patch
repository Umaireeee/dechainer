@@ -0,0 +1,65 @@
+package io.github.warleysr.dechainer
+
+import io.github.warleysr.dechainer.data.PetCompanion
+import io.github.warleysr.dechainer.screens.common.PetArt
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import java.time.LocalDate
+
+/**
+ * Covers the clean-day streak and the milestone decorations. Everything under test is a pure
+ * function of dates and ints, so this runs on the plain JVM with no emulator and no Robolectric —
+ * which is the point: the CI gate should fail in seconds, not minutes.
+ */
+class PetMilestoneTest {
+
+    private val start: LocalDate = LocalDate.of(2026, 9, 1)
+
+    @Test
+    fun cleanDaysCountFromTheLastSlip() {
+        assertEquals(0, PetCompanion.cleanDays(start, start, start))
+        assertEquals(5, PetCompanion.cleanDays(start, start, start.plusDays(5)))
+    }
+
+    @Test
+    fun withNoSlipEverCleanDaysCountFromFirstUse() {
+        // lastBadEventDate == null, so the "since" date (first run) is the anchor.
+        assertEquals(9, PetCompanion.cleanDays(null, start, start.plusDays(9)))
+    }
+
+    @Test
+    fun clockGoingBackwardsNeverProducesNegativeStreaks() {
+        assertEquals(0, PetCompanion.cleanDays(start, start, start.minusDays(30)))
+    }
+
+    @Test
+    fun milestonesUnlockInOrder() {
+        assertEquals(PetArt.ACCESSORY_NONE, PetCompanion.accessoryFor(0))
+        assertEquals(PetArt.ACCESSORY_NONE, PetCompanion.accessoryFor(2))
+        assertEquals(PetArt.ACCESSORY_SPROUT, PetCompanion.accessoryFor(3))
+        assertEquals(PetArt.ACCESSORY_SPROUT, PetCompanion.accessoryFor(6))
+        assertEquals(PetArt.ACCESSORY_FLOWER, PetCompanion.accessoryFor(7))
+        assertEquals(PetArt.ACCESSORY_FLOWER, PetCompanion.accessoryFor(29))
+        assertEquals(PetArt.ACCESSORY_CROWN, PetCompanion.accessoryFor(30))
+        assertEquals(PetArt.ACCESSORY_CROWN, PetCompanion.accessoryFor(365))
+    }
+
+    @Test
+    fun countdownToNextMilestoneIsAlwaysTheNextOneUp() {
+        assertEquals(3, PetCompanion.daysUntilNextMilestone(0))
+        assertEquals(1, PetCompanion.daysUntilNextMilestone(2))
+        assertEquals(4, PetCompanion.daysUntilNextMilestone(3))
+        assertEquals(23, PetCompanion.daysUntilNextMilestone(7))
+        assertEquals(0, PetCompanion.daysUntilNextMilestone(30))
+        assertEquals(0, PetCompanion.daysUntilNextMilestone(99))
+    }
+
+    @Test
+    fun aSlipCostsTheDecorationsToo() {
+        // 30 clean days earns the crown; the slip resets the streak, so it goes back to nothing.
+        assertEquals(PetArt.ACCESSORY_CROWN, PetCompanion.accessoryFor(30))
+        val afterSlip = PetCompanion.cleanDays(start.plusDays(30), start, start.plusDays(30))
+        assertEquals(0, afterSlip)
+        assertEquals(PetArt.ACCESSORY_NONE, PetCompanion.accessoryFor(afterSlip))
+    }
+}
