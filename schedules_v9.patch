+package io.github.warleysr.dechainer
+
+import io.github.warleysr.dechainer.data.RegretLog
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class RegretLogTest {
+
+    private fun rating(pkg: String, regretted: Boolean, seconds: Int = 120) =
+        RegretLog.Rating(pkg, System.currentTimeMillis(), regretted, seconds)
+
+    @Test
+    fun ratioIsComputedPerApp() {
+        val summaries = RegretLog.summarize(
+            listOf(
+                rating("com.social", true),
+                rating("com.social", true),
+                rating("com.social", false),
+                rating("com.useful", false),
+                rating("com.useful", false)
+            )
+        ).associateBy { it.packageName }
+
+        assertEquals(3, summaries["com.social"]!!.total)
+        assertEquals(2, summaries["com.social"]!!.regretted)
+        assertEquals(2f / 3f, summaries["com.social"]!!.regretRatio, 0.001f)
+        assertEquals(0f, summaries["com.useful"]!!.regretRatio, 0.001f)
+    }
+
+    @Test
+    fun appsWithTooLittleDataGiveNoVerdict() {
+        val single = RegretLog.summarize(listOf(rating("com.new", true))).first()
+        // One bad session shouldn't brand an app as regretted.
+        assertFalse(single.hasEnoughData)
+        assertTrue(RegretLog.suggestedForBlocking(listOf(rating("com.new", true))).isEmpty())
+    }
+
+    @Test
+    fun consistentlyRegrettedAppsAreSuggested() {
+        val ratings = listOf(
+            rating("com.social", true), rating("com.social", true),
+            rating("com.social", true), rating("com.social", false),
+            rating("com.useful", false), rating("com.useful", false), rating("com.useful", false)
+        )
+        val suggested = RegretLog.suggestedForBlocking(ratings).map { it.packageName }
+        assertEquals(listOf("com.social"), suggested)
+    }
+
+    @Test
+    fun regrettedTimeOnlyCountsRegrettedSessions() {
+        val summary = RegretLog.summarize(
+            listOf(
+                rating("com.social", true, seconds = 600),
+                rating("com.social", false, seconds = 300),
+                rating("com.social", true, seconds = 900)
+            )
+        ).first()
+        assertEquals(1500, summary.regrettedSeconds)
+    }
+
+    @Test
+    fun mostRegrettedAppsSortFirst() {
+        val ratings = listOf(
+            rating("com.mild", true), rating("com.mild", false), rating("com.mild", false),
+            rating("com.bad", true), rating("com.bad", true), rating("com.bad", true)
+        )
+        assertEquals("com.bad", RegretLog.summarize(ratings).first().packageName)
+    }
+}
