    <!-- Why -->
    <string name="reason_tired_late">You\'re tired or it\'s late. Self-control is at its lowest then, and the brain grabs for quick relief.</string>
    <string name="reason_stress_escape">Stress is pushing you to escape. The urge is a shortcut to feeling better for a few minutes.</string>
    <string name="reason_bored_avoiding">Boredom, or avoiding something. The urge fills the gap so you don\'t have to face it.</string>
    <string name="reason_lonely">Loneliness. The urge is standing in for connection.</string>
    <string name="reason_anxious">Anxiety. Your mind wants relief from the worry.</string>
    <string name="reason_thought_trap">The story you\'re telling yourself is how urges win. Notice it as a story, not a fact.</string>
    <string name="reason_general">Urges rise, peak and fade, usually within 10 to 20 minutes. This one will too.</string>

    <!-- Right now -->
    <string name="step_breathe">Breathe slowly for one minute: in for 4, out for 6.</string>
    <string name="step_leave_room">Stand up and leave the room you\'re in.</string>
    <string name="step_cold_water">Splash cold water on your face, or take a cold shower.</string>
    <string name="step_walk">Walk for ten minutes, ideally outside.</string>
    <string name="step_message_someone">Message or call someone you trust, even about nothing.</string>
    <string name="step_phone_out">Put your phone in another room and leave it there.</string>
    <string name="step_small_task">Do one small task for ten minutes: a few questions, tidy your desk.</string>
    <string name="step_sleep">If you can, go to sleep. Tomorrow\'s you will thank you.</string>

    <!-- Later -->
    <string name="rule_phone_charges_outside">Charge your phone outside the bedroom from tonight.</string>
    <string name="rule_earlier_block">Start your evening block an hour earlier.</string>
    <string name="rule_extend_schedule">Extend a Déchaîner schedule to cover the hour this happened.</string>
    <string name="rule_other_device">Cover your other devices too, or tell someone about them.</string>
    <string name="rule_offline_urge">Your phone block held, so the urge went offline. Leave the room at the first sign of it, before it builds.</string>
    <string name="rule_study_start">Fix a small start time for your hardest task, so boredom has less room.</string>
    <string name="rule_tell_someone">Tell one person you trust what you\'re working on.</string>
    <string name="rule_sleep_earlier">Move bedtime earlier; short sleep makes every urge stronger.</string>
