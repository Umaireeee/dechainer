+import io.github.warleysr.dechainer.R
+import io.github.warleysr.dechainer.data.ConfessionLog
+import io.github.warleysr.dechainer.security.VoicePlayer
+import io.github.warleysr.dechainer.ui.theme.DechainerTheme
+import java.text.DateFormat
+import java.util.Date
+
+class ScheduleBlockedActivity : ComponentActivity() {
+
+    companion object {
+        const val EXTRA_APP_NAME = "appName"
+        const val EXTRA_SCHEDULE_NAME = "scheduleName"
+        const val EXTRA_ENDS_AT = "endsAt"
+    }
+
+    private val player = VoicePlayer()
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
+
+        val endsAt = intent.getLongExtra(EXTRA_ENDS_AT, 0L)
+        val endsAtText = if (endsAt > 0) DateFormat.getTimeInstance(DateFormat.SHORT).format(Date(endsAt)) else ""
+
+        val entry = ConfessionLog.mostRecentFor(this, "schedule_disable")
+            ?: ConfessionLog.getEntries(this).firstOrNull()
+        entry?.let { player.play(ConfessionLog.audioFile(this, it.id)) }
+
+        setContent {
+            DechainerTheme {
+                ScheduleBlockedScreen(
+                    appName = intent.getStringExtra(EXTRA_APP_NAME) ?: "",
+                    scheduleName = intent.getStringExtra(EXTRA_SCHEDULE_NAME) ?: "",
+                    endsAt = endsAtText,
+                    onClose = {
+                        player.stop()
+                        finishAfterTransition()
+                    }
+                )
+            }
+        }
+    }
+
+    override fun onDestroy() {
+        super.onDestroy()
+        player.stop()
+    }
+}
+
+@Composable
+fun ScheduleBlockedScreen(appName: String, scheduleName: String, endsAt: String, onClose: () -> Unit) {
+    Surface(
+        modifier = Modifier.fillMaxSize(),
+        color = MaterialTheme.colorScheme.errorContainer
+    ) {
+        Column(
+            modifier = Modifier.padding(24.dp),
+            verticalArrangement = Arrangement.Center,
+            horizontalAlignment = Alignment.CenterHorizontally
+        ) {
+            Icon(Icons.Outlined.EventBusy, contentDescription = null, modifier = Modifier.size(64.dp))
+            Spacer(modifier = Modifier.height(16.dp))
+            Text(
+                stringResource(R.string.schedule_blocked_title),
+                style = MaterialTheme.typography.headlineMedium,
+                textAlign = TextAlign.Center
+            )
+            Spacer(modifier = Modifier.height(8.dp))
+            Text(
+                stringResource(R.string.schedule_blocked_description, appName, scheduleName, endsAt),
+                textAlign = TextAlign.Center,
+                style = MaterialTheme.typography.bodyLarge
+            )
+            Spacer(modifier = Modifier.height(32.dp))
+            Button(onClick = onClose) {
+                Text(stringResource(R.string.close))
+            }
+        }
+    }
+}
