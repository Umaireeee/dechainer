+import java.time.LocalDate
+
+class AccountabilityStepState {
+    var pending by mutableStateOf<PendingStep?>(null)
+        private set
+
+    data class PendingStep(val category: String, val label: String, val onProceed: () -> Unit)
+
+    fun show(category: String, label: String, onProceed: () -> Unit) {
+        pending = PendingStep(category, label, onProceed)
+    }
+
+    fun proceed() {
+        val step = pending
+        pending = null
+        step?.onProceed?.invoke()
+    }
+
+    fun cancel() {
+        pending = null
+    }
+}
+
+@Composable
+fun rememberAccountabilityStepState(): AccountabilityStepState = remember { AccountabilityStepState() }
+
+private enum class RecordingState { IDLE, RECORDING, RECORDED }
+
+@Composable
+fun AccountabilityStepDialog(state: AccountabilityStepState) {
+    val step = state.pending ?: return
+    val context = LocalContext.current
+
+    val recorder = remember(step) { VoiceRecorder(context) }
+    val player = remember(step) { VoicePlayer() }
+    DisposableEffect(step) {
+        onDispose {
+            recorder.cancel()
+            player.stop()
+        }
+    }
+
+    var recordingState by remember(step) { mutableStateOf(RecordingState.IDLE) }
+    var hasMicPermission by remember(step) {
+        mutableStateOf(
+            ContextCompat.checkSelfPermission(context, Manifest.permission.RECORD_AUDIO) ==
+                PackageManager.PERMISSION_GRANTED
+        )
+    }
+    val permissionLauncher = rememberLauncherForActivityResult(ActivityResultContracts.RequestPermission()) { granted ->
+        hasMicPermission = granted
+        if (granted && recorder.start(step.label)) recordingState = RecordingState.RECORDING
+    }
+
+    val previous = remember(step.category) { ConfessionLog.mostRecentFor(context, step.category) }
+    var isPlayingPrevious by remember(step) { mutableStateOf(false) }
+
+    val healthLevel = remember(step) { PetCompanion.currentHealthLevel(context) }
+    val petName = remember(step) { PetCompanion.getName(context) }
+    val willGetWorse = healthLevel > 0
+
+    fun finishAndProceed(savedRecording: Boolean) {
+        if (savedRecording) ConfessionLog.addEntry(context, step.category, step.label)
+        PetCompanion.registerBadEvent(context, LocalDate.now())
+        state.proceed()
+    }
+
+    if (recordingState == RecordingState.RECORDING) {
+        LaunchedEffect(step) {
+            delay(120_000)
+            recorder.stop()
+            recordingState = RecordingState.RECORDED
+        }
+    }
+
+    AlertDialog(
+        onDismissRequest = { },
+        title = { Text(stringResource(R.string.accountability_title)) },
+        text = {
+            Column {
+                Text(step.label, fontWeight = FontWeight.Medium, modifier = Modifier.padding(bottom = 8.dp))
+
+                if (previous != null) {
+                    Card(
+                        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceVariant),
+                        modifier = Modifier
+                            .fillMaxWidth()
+                            .padding(bottom = 12.dp)
+                    ) {
+                        Row(
+                            verticalAlignment = Alignment.CenterVertically,
+                            modifier = Modifier.padding(8.dp)
+                        ) {
+                            IconButton(onClick = {
+                                if (isPlayingPrevious) {
+                                    player.stop()
+                                    isPlayingPrevious = false
+                                } else {
+                                    val file = ConfessionLog.audioFile(context, previous.id)
+                                    if (file.exists()) {
+                                        isPlayingPrevious = true
+                                        player.play(file) { isPlayingPrevious = false }
+                                    }
+                                }
+                            }) {
+                                Icon(Icons.Outlined.PlayArrow, contentDescription = null)
+                            }
+                            Text(
+                                stringResource(R.string.accountability_play_previous),
+                                style = MaterialTheme.typography.bodyMedium
+                            )
+                        }
+                    }
+                }
+
+                Text(
+                    if (willGetWorse) stringResource(R.string.accountability_pet_impact, petName)
+                    else stringResource(R.string.accountability_pet_impact_already_low, petName),
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    modifier = Modifier.padding(bottom = 12.dp)
+                )
+
+                Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                    when (recordingState) {
+                        RecordingState.IDLE -> {
+                            OutlinedButton(onClick = {
+                                if (hasMicPermission) {
+                                    if (recorder.start(step.label)) recordingState = RecordingState.RECORDING
+                                } else {
+                                    permissionLauncher.launch(Manifest.permission.RECORD_AUDIO)
+                                }
+                            }) {
+                                Icon(Icons.Filled.Mic, contentDescription = null)
+                                Spacer(Modifier.width(6.dp))
+                                Text(stringResource(R.string.accountability_record))
+                            }
+                        }
+                        RecordingState.RECORDING -> {
+                            OutlinedButton(onClick = {
+                                recorder.stop()
+                                recordingState = RecordingState.RECORDED
+                            }) {
+                                Icon(Icons.Filled.Stop, contentDescription = null)
+                                Spacer(Modifier.width(6.dp))
+                                Text(stringResource(R.string.accountability_stop))
+                            }
+                        }
+                        RecordingState.RECORDED -> {
+                            Text(
+                                stringResource(R.string.accountability_recorded),
+                                color = MaterialTheme.colorScheme.primary,
+                                style = MaterialTheme.typography.bodyMedium
+                            )
+                        }
+                    }
+                }
+            }
+        },
+        confirmButton = {
+            TextButton(onClick = { finishAndProceed(savedRecording = recordingState == RecordingState.RECORDED) }) {
+                Text(
+                    if (recordingState == RecordingState.RECORDED) stringResource(R.string.accountability_save_and_continue)
+                    else stringResource(R.string.accountability_skip_and_continue)
+                )
+            }
+        },
+        dismissButton = {
+            TextButton(onClick = {
+                recorder.cancel()
+                player.stop()
+                state.cancel()
+            }) {
+                Text(stringResource(R.string.cancel))
+            }
+        }
+    )
+}
