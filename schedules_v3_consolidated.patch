--- dechainer-orig/app/src/main/java/io/github/warleysr/dechainer/data/ScheduleRepository.kt	1970-01-01 00:00:00.000000000 +0000
+++ dechainer-main/app/src/main/java/io/github/warleysr/dechainer/data/ScheduleRepository.kt	2026-09-18 10:00:00.000000000 +0000
@@ -0,0 +1,63 @@
+package io.github.warleysr.dechainer.data
+
+import android.content.Context
+import androidx.core.content.edit
+import io.github.warleysr.dechainer.models.BlockSchedule
+import org.json.JSONArray
+import java.time.LocalDateTime
+
+object ScheduleRepository {
+    const val PREFS_NAME = "schedule_prefs"
+    private const val KEY_SCHEDULES = "schedules_json"
+    private const val KEY_ANTI_TAMPER = "anti_tamper_enabled"
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    fun getSchedules(context: Context): List<BlockSchedule> {
+        val json = prefs(context).getString(KEY_SCHEDULES, null) ?: return emptyList()
+        return try {
+            val array = JSONArray(json)
+            (0 until array.length()).map { BlockSchedule.fromJson(array.getJSONObject(it)) }
+        } catch (e: Exception) {
+            e.printStackTrace()
+            emptyList()
+        }
+    }
+
+    fun getSchedule(context: Context, id: String): BlockSchedule? =
+        getSchedules(context).firstOrNull { it.id == id }
+
+    private fun saveAll(context: Context, schedules: List<BlockSchedule>) {
+        val array = JSONArray()
+        schedules.forEach { array.put(it.toJson()) }
+        prefs(context).edit(commit = true) { putString(KEY_SCHEDULES, array.toString()) }
+    }
+
+    fun upsert(context: Context, schedule: BlockSchedule) {
+        val list = getSchedules(context).toMutableList()
+        val index = list.indexOfFirst { it.id == schedule.id }
+        if (index >= 0) list[index] = schedule else list.add(schedule)
+        saveAll(context, list)
+    }
+
+    fun delete(context: Context, id: String) {
+        saveAll(context, getSchedules(context).filterNot { it.id == id })
+    }
+
+    fun isLockedNow(schedule: BlockSchedule, now: LocalDateTime = LocalDateTime.now()): Boolean =
+        schedule.lockWhileActive && schedule.isActiveAt(now)
+
+    fun isAntiTamperEnabled(context: Context): Boolean =
+        prefs(context).getBoolean(KEY_ANTI_TAMPER, true)
+
+    fun setAntiTamperEnabled(context: Context, enabled: Boolean) {
+        prefs(context).edit(commit = true) { putBoolean(KEY_ANTI_TAMPER, enabled) }
+    }
+}
diff -ruN dechainer-orig/app/src/main/java/io/github/warleysr/dechainer/data/TimeLimitSuspensionTracker.kt dechainer-main/app/src/main/java/io/github/warleysr/dechainer/data/TimeLimitSuspensionTracker.kt
--- dechainer-orig/app/src/main/java/io/github/warleysr/dechainer/data/TimeLimitSuspensionTracker.kt	1970-01-01 00:00:00.000000000 +0000
+++ dechainer-main/app/src/main/java/io/github/warleysr/dechainer/data/TimeLimitSuspensionTracker.kt	2026-09-18 10:00:00.000000000 +0000
@@ -0,0 +1,56 @@
+package io.github.warleysr.dechainer.data
+
+import android.content.Context
+import android.content.SharedPreferences
+import androidx.core.content.edit
+
+class TimeLimitSuspensionTracker(context: Context) {
+
+    private val prefs: SharedPreferences =
+        context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    fun addDailyLimitSuspension(pkg: String, today: String) {
+        prefs.edit { putString(KEY_DAILY_PREFIX + pkg, today) }
+    }
+
+    fun endDailyLimitSuspension(pkg: String) = prefs.edit { remove(KEY_DAILY_PREFIX + pkg) }
+
+    fun isDailyLimitSuspended(pkg: String): Boolean = prefs.contains(KEY_DAILY_PREFIX + pkg)
+
+    fun dailyLimitSuspensions(): Map<String, String> {
+        val result = mutableMapOf<String, String>()
+        prefs.all.forEach { (key, value) ->
+            if (!key.startsWith(KEY_DAILY_PREFIX)) return@forEach
+            val day = value as? String ?: return@forEach
+            result[key.removePrefix(KEY_DAILY_PREFIX)] = day
+        }
+        return result
+    }
+
+    fun startReopeningSuspension(pkg: String, until: Long) {
+        prefs.edit { putLong(KEY_REOPEN_PREFIX + pkg, until) }
+    }
+
+    fun endReopeningSuspension(pkg: String) = prefs.edit { remove(KEY_REOPEN_PREFIX + pkg) }
+
+    fun isReopeningSuspended(pkg: String): Boolean = prefs.contains(KEY_REOPEN_PREFIX + pkg)
+
+    fun reopeningSuspensions(): Map<String, Long> {
+        val result = mutableMapOf<String, Long>()
+        prefs.all.forEach { (key, value) ->
+            if (!key.startsWith(KEY_REOPEN_PREFIX)) return@forEach
+            val until = value as? Long ?: return@forEach
+            result[key.removePrefix(KEY_REOPEN_PREFIX)] = until
+        }
+        return result
+    }
+
+    companion object {
+        private const val PREFS_NAME = "time_limit_suspensions"
+        private const val KEY_DAILY_PREFIX = "daily_"
+        private const val KEY_REOPEN_PREFIX = "reopen_"
+    }
+}
