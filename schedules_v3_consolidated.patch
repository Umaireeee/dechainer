+package io.github.warleysr.dechainer.data
+
+import android.app.admin.DevicePolicyManager
+import android.content.ComponentName
+import android.content.Context
+import androidx.core.content.edit
+import io.github.warleysr.dechainer.DechainerDeviceAdminReceiver
+import java.time.LocalDate
+
+object PetCompanion {
+    private const val PREFS_NAME = "pet_companion_prefs"
+    private const val KEY_NAME = "pet_name"
+    private const val KEY_HEALTH = "pet_health"
+    private const val KEY_STREAK = "clean_streak"
+    private const val KEY_LAST_BAD = "last_bad_date"
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    fun getName(context: Context): String =
+        prefs(context).getString(KEY_NAME, "Pet") ?: "Pet"
+
+    fun currentHealthLevel(context: Context): Int =
+        prefs(context).getInt(KEY_HEALTH, 3)
+
+    fun registerBadEvent(context: Context, date: LocalDate = LocalDate.now()) {
+        val p = prefs(context)
+        val current = p.getInt(KEY_HEALTH, 3)
+        val nextHealth = (current - 1).coerceAtLeast(0)
+        p.edit {
+            putInt(KEY_HEALTH, nextHealth)
+            putString(KEY_LAST_BAD, date.toString())
+            putInt(KEY_STREAK, 0)
+        }
+        syncLockScreen(context)
+    }
+
+    fun registerCleanDay(context: Context, date: LocalDate = LocalDate.now()) {
+        val p = prefs(context)
+        if (p.getString(KEY_LAST_BAD, null) != date.toString()) {
+            val current = p.getInt(KEY_HEALTH, 3)
+            val streak = p.getInt(KEY_STREAK, 0) + 1
+            p.edit {
+                putInt(KEY_HEALTH, (current + 1).coerceAtMost(3))
+                putInt(KEY_STREAK, streak)
+            }
+            syncLockScreen(context)
+        }
+    }
+
+    fun syncLockScreen(context: Context) {
+        try {
+            val dpm = context.getSystemService(Context.DEVICE_POLICY_SERVICE) as DevicePolicyManager
+            val admin = ComponentName(context, DechainerDeviceAdminReceiver::class.java)
+            if (dpm.isDeviceOwnerApp(context.packageName)) {
+                val name = getName(context)
+                val mood = when (currentHealthLevel(context)) {
+                    3 -> "Thriving (^.^)"
+                    2 -> "Anxious (-.-)"
+                    1 -> "Sick (>.<)"
+                    else -> "Critical (x.x)"
+                }
+                dpm.setDeviceOwnerLockScreenInfo(admin, "🐾 $name: $mood")
+            }
+        } catch (_: Exception) {}
+    }
+}
diff -ruN dechainer-orig/app/src/main/java/io/github/warleysr/dechainer/data/ScheduleEnforcer.kt dechainer-main/app/src/main/java/io/github/warleysr/dechainer/data/ScheduleEnforcer.kt
--- dechainer-orig/app/src/main/java/io/github/warleysr/dechainer/data/ScheduleEnforcer.kt	1970-01-01 00:00:00.000000000 +0000
+++ dechainer-main/app/src/main/java/io/github/warleysr/dechainer/data/ScheduleEnforcer.kt	2026-09-18 10:00:00.000000000 +0000
@@ -0,0 +1,327 @@
+package io.github.warleysr.dechainer.data
+
+import android.app.AlarmManager
+import android.app.PendingIntent
+import android.app.admin.DevicePolicyManager
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.Build
+import android.os.UserManager
+import android.telecom.TelecomManager
+import androidx.core.content.edit
+import io.github.warleysr.dechainer.DechainerDeviceAdminReceiver
+import io.github.warleysr.dechainer.ScheduleReceiver
+import io.github.warleysr.dechainer.models.BlockSchedule
+import io.github.warleysr.dechainer.security.SecurityManager
+import timber.log.Timber
+import java.time.ZonedDateTime
+
+object ScheduleEnforcer {
+    private const val STATE_PREFS = "schedule_state"
+    private const val KEY_OWNED_APPS = "owned_apps"
+    private const val KEY_OWNED_RESTRICTIONS = "owned_restrictions"
+    private const val KEY_ACTIVE_SITES = "active_sites"
+
+    const val ACTION_BOUNDARY = "io.github.warleysr.dechainer.SCHEDULE_BOUNDARY"
+    private const val MAX_CACHE_MS = 5 * 60 * 1000L
+
+    data class ActiveBlock(val scheduleName: String, val endsAtMillis: Long)
+
+    private val lock = Any()
+
+    @Volatile
+    private var activeBlocks: Map<String, ActiveBlock> = emptyMap()
+
+    @Volatile
+    private var cacheValidUntil = 0L
+
+    private fun state(context: Context) =
+        context.applicationContext.getSharedPreferences(STATE_PREFS, Context.MODE_PRIVATE)
+
+    fun sync(context: Context) {
+        val ctx = context.applicationContext
+        synchronized(lock) {
+            try {
+                syncLocked(ctx)
+            } catch (e: Exception) {
+                Timber.e(e, "Schedule sync failed")
+                cacheValidUntil = 0L
+            }
+        }
+    }
+
+    private fun syncLocked(ctx: Context) {
+        val dpm = ctx.getSystemService(Context.DEVICE_POLICY_SERVICE) as DevicePolicyManager
+        val admin = ComponentName(ctx, DechainerDeviceAdminReceiver::class.java)
+        val schedules = ScheduleRepository.getSchedules(ctx)
+        val now = ZonedDateTime.now()
+        val nowLocal = now.toLocalDateTime()
+
+        if (!dpm.isDeviceOwnerApp(ctx.packageName)) {
+            activeBlocks = emptyMap()
+            cacheValidUntil = System.currentTimeMillis() + MAX_CACHE_MS
+            armNextBoundary(ctx, schedules, now)
+            return
+        }
+
+        val active = schedules.filter { it.isActiveAt(nowLocal) }
+        val protectedPkgs = protectedPackages(ctx)
+
+        val desiredApps = active.flatMap { it.packages }.toSet() - protectedPkgs
+        val desiredRestrictions = active.flatMap { it.restrictions }.toMutableSet()
+        val desiredSites = active.flatMap { it.websites }.toSet()
+
+        if (ScheduleRepository.isAntiTamperEnabled(ctx) && schedules.any { it.enabled }) {
+            desiredRestrictions += UserManager.DISALLOW_CONFIG_DATE_TIME
+            try {
+                dpm.setAutoTimeEnabled(admin, true)
+                dpm.setAutoTimeZoneEnabled(admin, true)
+            } catch (e: Exception) {
+                Timber.w(e, "Could not force automatic time")
+            }
+        }
+
+        applyApps(ctx, dpm, admin, desiredApps)
+        applyRestrictions(ctx, dpm, admin, desiredRestrictions)
+        applySites(ctx, desiredSites)
+
+        activeBlocks = buildMap<String, ActiveBlock> {
+            active.forEach { schedule ->
+                val end = schedule.currentWindowEnd(nowLocal)
+                    ?.atZone(now.zone)?.toInstant()?.toEpochMilli() ?: return@forEach
+                schedule.packages.forEach { pkg ->
+                    val existing = get(pkg)
+                    if (existing == null || end > existing.endsAtMillis) put(pkg, ActiveBlock(schedule.name, end))
+                }
+            }
+        }.filterKeys { it !in protectedPkgs }
+
+        val next = armNextBoundary(ctx, schedules, now)
+        val cap = System.currentTimeMillis() + MAX_CACHE_MS
+        cacheValidUntil = if (next != null) minOf(next, cap) else cap
+    }
+
+    private fun applyApps(
+        ctx: Context,
+        dpm: DevicePolicyManager,
+        admin: ComponentName,
+        desired: Set<String>
+    ) {
+        val prefs = state(ctx)
+        val initiallyOwned = prefs.getStringSet(KEY_OWNED_APPS, emptySet())?.toSet() ?: emptySet()
+        val owned = initiallyOwned.toMutableSet()
+
+        val toSuspend = desired.filter { pkg ->
+            try {
+                !dpm.isPackageSuspended(admin, pkg)
+            } catch (_: PackageManager.NameNotFoundException) {
+                false
+            }
+        }
+        if (toSuspend.isNotEmpty()) {
+            val failed = dpm.setPackagesSuspended(admin, toSuspend.toTypedArray(), true).toSet()
+            if (failed.isNotEmpty()) Timber.w("Schedule: could not suspend $failed")
+            owned += toSuspend - failed
+        }
+
+        val toRelease = owned - desired
+        if (toRelease.isNotEmpty()) {
+            val timeLimitTracker = TimeLimitSuspensionTracker(ctx)
+            val heldElsewhere = SecurityManager.getActiveImpulseSuspension(ctx) +
+                VisualBlockingSuspensionTracker(ctx).activeSuspensions()
+                    .filterValues { it > System.currentTimeMillis() }.keys +
+                timeLimitTracker.dailyLimitSuspensions().keys +
+                timeLimitTracker.reopeningSuspensions().keys
+            val releasable = (toRelease - heldElsewhere).filter { pkg ->
+                try {
+                    ctx.packageManager.getPackageInfo(pkg, 0); true
+                } catch (_: PackageManager.NameNotFoundException) {
+                    false
+                }
+            }
+            if (releasable.isNotEmpty()) dpm.setPackagesSuspended(admin, releasable.toTypedArray(), false)
+            owned -= toRelease
+        }
+
+        if (owned != initiallyOwned) prefs.edit(commit = true) { putStringSet(KEY_OWNED_APPS, owned) }
+        if (toSuspend.isNotEmpty() || toRelease.isNotEmpty()) AppRepository.invalidateCache()
+    }
+
+    private fun applyRestrictions(
+        ctx: Context,
+        dpm: DevicePolicyManager,
+        admin: ComponentName,
+        desired: Set<String>
+    ) {
+        val prefs = state(ctx)
+        val initiallyOwned = prefs.getStringSet(KEY_OWNED_RESTRICTIONS, emptySet())?.toSet() ?: emptySet()
+        val owned = initiallyOwned.toMutableSet()
+        val current = dpm.getUserRestrictions(admin)
+
+        desired.forEach { key ->
+            if (!current.getBoolean(key)) {
+                try {
+                    dpm.addUserRestriction(admin, key)
+                    owned += key
+                } catch (e: Exception) {
+                    Timber.w(e, "Schedule: could not add restriction $key")
+                }
+            }
+        }
+
+        (owned - desired).forEach { key ->
+            try {
+                dpm.clearUserRestriction(admin, key)
+            } catch (e: Exception) {
+                Timber.w(e, "Schedule: could not clear restriction $key")
+            }
+            owned -= key
+        }
+
+        if (owned != initiallyOwned) prefs.edit(commit = true) { putStringSet(KEY_OWNED_RESTRICTIONS, owned) }
+    }
+
+    private fun applySites(ctx: Context, desired: Set<String>) {
+        val prefs = state(ctx)
+        val previous = prefs.getStringSet(KEY_ACTIVE_SITES, emptySet()) ?: emptySet()
+        if (previous == desired) return
+        prefs.edit(commit = true) { putStringSet(KEY_ACTIVE_SITES, desired) }
+        try {
+            BrowserRestrictionsManager(ctx).applyRestrictions()
+        } catch (e: Exception) {
+            Timber.w(e, "Schedule: could not update browser blocklist")
+        }
+    }
+
+    fun getActiveScheduledSites(context: Context): Set<String> =
+        state(context).getStringSet(KEY_ACTIVE_SITES, emptySet()) ?: emptySet()
+
+    fun activeBlockFor(context: Context, pkg: String): ActiveBlock? {
+        if (System.currentTimeMillis() >= cacheValidUntil) sync(context)
+        return activeBlocks[pkg]
+    }
+
+    fun isHeldBySchedule(context: Context, pkg: String): Boolean = activeBlockFor(context, pkg) != null
+
+    fun isAnyScheduleLocked(context: Context): Boolean =
+        ScheduleRepository.getSchedules(context).any { ScheduleRepository.isLockedNow(it) }
+
+    fun adopt(context: Context, pkg: String) = synchronized(lock) {
+        val prefs = state(context)
+        val owned = (prefs.getStringSet(KEY_OWNED_APPS, emptySet()) ?: emptySet()) + pkg
+        prefs.edit(commit = true) { putStringSet(KEY_OWNED_APPS, owned) }
+    }
+
+    fun disown(context: Context, pkg: String) = synchronized(lock) {
+        val prefs = state(context)
+        val owned = (prefs.getStringSet(KEY_OWNED_APPS, emptySet()) ?: emptySet()) - pkg
+        prefs.edit(commit = true) { putStringSet(KEY_OWNED_APPS, owned) }
+    }
+
+    fun releaseAll(context: Context) {
+        val ctx = context.applicationContext
+        synchronized(lock) {
+            try {
+                val dpm = ctx.getSystemService(Context.DEVICE_POLICY_SERVICE) as DevicePolicyManager
+                val admin = ComponentName(ctx, DechainerDeviceAdminReceiver::class.java)
+                if (dpm.isDeviceOwnerApp(ctx.packageName)) {
+                    applyApps(ctx, dpm, admin, emptySet())
+                    applyRestrictions(ctx, dpm, admin, emptySet())
+                }
+                applySites(ctx, emptySet())
+                activeBlocks = emptyMap()
+                cancelAlarm(ctx)
+            } catch (e: Exception) {
+                Timber.e(e, "Schedule releaseAll failed")
+            }
+        }
+    }
+
+    fun protectedPackages(context: Context): Set<String> {
+        val pm = context.packageManager
+        val result = mutableSetOf(context.packageName, "com.android.systemui", "com.android.phone")
+        try {
+            val homeIntent = Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_HOME)
+            pm.queryIntentActivities(homeIntent, PackageManager.MATCH_ALL)
+                .forEach { result += it.activityInfo.packageName }
+        } catch (_: Exception) { }
+        try {
+            val telecom = context.getSystemService(Context.TELECOM_SERVICE) as TelecomManager
+            telecom.defaultDialerPackage?.let { result += it }
+            telecom.systemDialerPackage?.let { result += it }
+        } catch (_: Exception) { }
+        return result
+    }
+
+    private fun pendingIntent(ctx: Context): PendingIntent = PendingIntent.getBroadcast(
+        ctx,
+        0,
+        Intent(ctx, ScheduleReceiver::class.java).setAction(ACTION_BOUNDARY),
+        PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT
+    )
+
+    private fun cancelAlarm(ctx: Context) {
+        val am = ctx.getSystemService(Context.ALARM_SERVICE) as AlarmManager
+        am.cancel(pendingIntent(ctx))
+    }
+
+    private fun armNextBoundary(ctx: Context, schedules: List<BlockSchedule>, now: ZonedDateTime): Long? {
+        val next = schedules.flatMap { it.boundariesAfter(now) }.minOrNull()
+        if (next == null) {
+            cancelAlarm(ctx)
+            return null
+        }
+        val triggerAt = next.toInstant().toEpochMilli() + 1000L
+        val am = ctx.getSystemService(Context.ALARM_SERVICE) as AlarmManager
+        val pi = pendingIntent(ctx)
+        try {
+            val canExact = Build.VERSION.SDK_INT < Build.VERSION_CODES.S || am.canScheduleExactAlarms()
+            if (canExact) am.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, triggerAt, pi)
+            else am.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, triggerAt, pi)
+        } catch (e: SecurityException) {
+            am.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, triggerAt, pi)
+        }
+        return triggerAt
+    }
+}
